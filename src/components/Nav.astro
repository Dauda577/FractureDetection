---
export interface Props {
  active: 'home' | 'analyze' | 'about' | 'account' | 'signin' | 'signup';
  variant: 'marketing' | 'app';
}

const { active, variant } = Astro.props;

const links = [
  { href: '/', label: 'Home', id: 'home' },
  { href: '/analyze', label: 'Analyze', id: 'analyze' },
  { href: '/about', label: 'About', id: 'about' },
];
---

<header class="nav-header">
  <nav class="nav-container">
    <a href="/" class="nav-logo" aria-label="FractureDetect home">
      <span class="logo-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
      </span>
      <span class="logo-text">FractureDetect</span>
    </a>

    <div class="nav-links" id="nav-links">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={{ 'nav-link': true, active: active === link.id }}
          aria-current={active === link.id ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="nav-actions">
      <a href="/signin" class="nav-signin" style="display:none">Sign In</a>
      <a href="/account" class="avatar" aria-label="Account" style="display:none">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="8" r="4" stroke="#64748B" stroke-width="1.6"/>
          <path d="M4 20c1.6-3.6 4.8-5.5 8-5.5s6.4 1.9 8 5.5" stroke="#64748B" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </a>
      <button class="btn-hamburger" id="btn-hamburger" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script type="module">
  import { supabase } from '../lib/supabase.js'

  const hamburger = document.getElementById('btn-hamburger');
  const navLinks = document.getElementById('nav-links');
  const signInLink = document.querySelector('.nav-signin');
  const avatarLink = document.querySelector('.avatar');

  function updateNav(session) {
    if (session) {
      if (signInLink) signInLink.style.display = 'none';
      if (avatarLink) avatarLink.style.display = 'flex';
    } else {
      if (signInLink) signInLink.style.display = '';
      if (avatarLink) avatarLink.style.display = 'none';
    }
  }

  supabase.auth.getSession().then(function (res) {
    updateNav(res.data.session);
  });

  supabase.auth.onAuthStateChange(function (event, session) {
    updateNav(session);
  });

  function setMenu(open) {
    if (!navLinks || !hamburger) return;
    navLinks.classList.toggle('open', open);
    hamburger.setAttribute('aria-expanded', String(open));
  }

  hamburger?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.contains('open');
    setMenu(!isOpen);
  });

  navLinks?.querySelectorAll('.nav-link').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  document.addEventListener('click', (e) => {
    if (
      navLinks?.classList.contains('open') &&
      !navLinks?.contains(e.target) &&
      !hamburger?.contains(e.target)
    ) {
      setMenu(false);
    }
  });
</script>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    height: 68px;
  }

  .nav-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    position: relative;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    justify-self: start;
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--color-primary);
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    color: var(--color-text);
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    background: var(--color-bg-subtle);
    padding: 3px;
    border-radius: 10px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 14px;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 7px 16px;
    border-radius: 7px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: rgba(0, 0, 0, 0.04);
  }

  .nav-link:active {
    background: var(--color-bg-subtle);
  }

  .nav-link.active {
    color: var(--color-text);
    background: var(--color-surface);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }

  .nav-link.active:active {
    background: var(--color-surface);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    justify-self: end;
  }

  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .avatar:hover {
    background: #F1F5F9;
    border-color: #CBD5E1;
  }

  .nav-signin {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 14px;
    color: var(--color-primary);
    text-decoration: none;
    padding: 7px 14px;
    border-radius: var(--radius-md);
    transition: all 0.15s;
    white-space: nowrap;
  }

  .nav-signin:hover {
    background: rgba(37, 99, 235, 0.06);
  }

  .nav-signin:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .avatar:focus-visible {
    outline: 2px solid #2563EB;
    outline-offset: 2px;
  }

  .btn-hamburger {
    display: none;
    width: 40px;
    height: 40px;
    border: none;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    padding: 8px;
    border-radius: var(--radius-sm);
    align-items: center;
    justify-content: center;
  }

  .btn-hamburger:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .nav-container {
      display: flex;
      justify-content: space-between;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-card);
      flex-direction: column;
      padding: 8px;
      gap: 2px;
      height: auto;
      border-radius: 0;
      justify-content: stretch;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-link {
      width: 100%;
      padding: 10px 14px;
    }

    .nav-link.active {
      background: var(--color-bg-subtle);
      box-shadow: none;
    }

    .btn-hamburger {
      display: flex;
    }
  }
</style>
