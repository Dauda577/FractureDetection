---
export interface Props {
  active: 'dashboard' | 'new-analysis' | 'history' | 'patients' | 'reports' | 'model-info' | 'about' | 'settings';
}

const { active } = Astro.props;

interface NavEntry {
  href: string;
  id: string;
  label: string;
  svg: string;
}

const navItems: NavEntry[] = [
  {
    href: '/account',
    id: 'dashboard',
    label: 'Dashboard',
    svg: '<rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" />'
  },
  {
    href: '/analyze',
    id: 'new-analysis',
    label: 'New Analysis',
    svg: '<line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />'
  },
  {
    href: '/account',
    id: 'history',
    label: 'History',
    svg: '<circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />'
  },
  {
    href: '/account',
    id: 'patients',
    label: 'Patients',
    svg: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />'
  },
  {
    href: '/account',
    id: 'reports',
    label: 'Reports',
    svg: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" />'
  },
];

const bottomItems: NavEntry[] = [
  {
    href: '/about',
    id: 'model-info',
    label: 'Model Information',
    svg: '<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />'
  },
  {
    href: '/about',
    id: 'about',
    label: 'About',
    svg: '<circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" />'
  },
  {
    href: '/account',
    id: 'settings',
    label: 'Settings',
    svg: '<circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />'
  },
];
---

<aside class="dash-sidebar" id="dash-sidebar">
  <div class="sidebar-header">
    <a href="/account" class="sidebar-logo" aria-label="Dashboard home">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      </svg>
      <span>FractureDetect</span>
    </a>
  </div>
  <nav class="sidebar-nav">
    {navItems.map((item) => (
      <a href={item.href} class:list={['nav-item', { active: active === item.id }]} data-view={item.id}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.svg} />
        <span>{item.label}</span>
      </a>
    ))}
    <div class="nav-divider"></div>
    {bottomItems.map((item) => (
      <a href={item.href} class:list={['nav-item', { active: active === item.id }]} data-view={item.id}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.svg} />
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
  <div class="sidebar-profile" id="sidebar-profile">
    <div class="sidebar-avatar" id="sidebar-avatar">
      <span id="sidebar-initial">U</span>
    </div>
    <div class="sidebar-user">
      <p class="sidebar-name" id="sidebar-name">User</p>
      <p class="sidebar-email" id="sidebar-email">user@example.com</p>
    </div>
    <button class="sidebar-signout" id="sidebar-signout" title="Sign out">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
    </button>
  </div>
</aside>

<script type="module">
  import { getUser, logout } from '../scripts/auth.js';

  var nameEl = document.getElementById('sidebar-name');
  var emailEl = document.getElementById('sidebar-email');
  var initialEl = document.getElementById('sidebar-initial');
  var signoutBtn = document.getElementById('sidebar-signout');

  if (nameEl) {
    getUser().then(function (user) {
      if (user) {
        nameEl.textContent = user.name;
        emailEl.textContent = user.email;
        if (initialEl) initialEl.textContent = user.name.charAt(0).toUpperCase();
      }
    });
  }

  if (signoutBtn) {
    signoutBtn.addEventListener('click', async function () {
      if (!confirm('Sign out? You will need to sign in again.')) return;
      await logout();
      window.location.reload();
    });
  }
</script>

<style>
  .dash-sidebar {
    width: 256px;
    background: #0F172A;
    display: flex; flex-direction: column;
    position: fixed; top: 68px; left: 0;
    height: calc(100vh - 68px); z-index: 50;
    border-right: 1px solid rgba(255,255,255,0.06);
    overflow-y: auto;
  }
  .sidebar-header {
    padding: 20px 20px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .sidebar-logo {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-heading); font-weight: 600; font-size: 16px;
    color: white; letter-spacing: -0.02em;
    text-decoration: none;
  }
  .sidebar-logo svg { color: var(--color-primary); flex-shrink: 0; }
  .sidebar-nav { flex: 1; padding: 12px 12px; display: flex; flex-direction: column; gap: 2px; }
  .nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px; border-radius: var(--radius-md);
    font-family: var(--font-body); font-size: 14px; font-weight: 500;
    color: rgba(255,255,255,0.55); text-decoration: none;
    transition: all 0.15s;
  }
  .nav-item svg { flex-shrink: 0; color: rgba(255,255,255,0.35); }
  .nav-item:hover { color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.06); }
  .nav-item:hover svg { color: rgba(255,255,255,0.6); }
  .nav-item.active { color: white; background: rgba(37,99,235,0.15); }
  .nav-item.active svg { color: var(--color-primary); }
  .nav-divider { height: 1px; background: rgba(255,255,255,0.06); margin: 8px 0; }

  .sidebar-profile {
    display: flex; align-items: center; gap: 10px;
    padding: 14px 16px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .sidebar-avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--color-primary);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-heading); font-weight: 600; font-size: 14px;
    color: white; flex-shrink: 0;
  }
  .sidebar-user { flex: 1; min-width: 0; }
  .sidebar-name { font-family: var(--font-body); font-weight: 600; font-size: 13px; color: white; margin: 0; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sidebar-email { font-family: var(--font-body); font-size: 11px; color: rgba(255,255,255,0.4); margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sidebar-signout {
    background: none; border: none; color: rgba(255,255,255,0.35);
    cursor: pointer; padding: 6px; border-radius: 6px; flex-shrink: 0;
    transition: all 0.15s; display: flex;
  }
  .sidebar-signout:hover { color: var(--color-danger); background: rgba(220,38,38,0.1); }

  @media (max-width: 900px) {
    .dash-sidebar { width: 200px; }
  }
  @media (max-width: 768px) {
    .dash-sidebar {
      width: 100%; height: auto; position: static; z-index: auto;
      flex-direction: row; flex-wrap: wrap; padding: 0;
      border-right: none; border-bottom: 1px solid rgba(255,255,255,0.06);
      overflow-x: auto;
    }
    .sidebar-header { display: none; }
    .sidebar-nav { flex-direction: row; padding: 8px 12px; overflow-x: auto; gap: 0; }
    .nav-item { white-space: nowrap; padding: 8px 12px; font-size: 13px; }
    .nav-item span { display: none; }
    .nav-divider { display: none; }
    .sidebar-profile { padding: 10px 16px; min-width: 0; }
  }
</style>