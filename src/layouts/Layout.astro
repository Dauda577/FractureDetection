---
import Nav from "../components/Nav.astro";

export interface Props {
  title: string;
  description?: string;
  active:
    | "home"
    | "analyze"
    | "about"
    | "account"
    | "signin"
    | "signup"
    | "contact"
    | "support"
    | "privacy"
    | "careers"
    | "blog"
    | "api-docs";
  variant?: "marketing" | "app";
}

const { title, description, active, variant = "marketing" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | FractureDetect</title>
    <meta
      name="description"
      content={description ||
        `${title} - FractureDetect AI-powered bone fracture detection`}
    />
    <script is:inline>
      (function () {
        var KEY = 'fracturedetect:theme';
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function resolve(pref) {
          if (pref === 'light' || pref === 'dark') return pref;
          return mq.matches ? 'dark' : 'light';
        }
        function apply(pref) {
          var resolved = resolve(pref);
          document.documentElement.classList.remove('light', 'dark');
          document.documentElement.classList.add(resolved);
        }
        var saved = 'system';
        try { saved = localStorage.getItem(KEY) || 'system'; } catch (e) {}
        apply(saved);
        window.fdApplyTheme = function (pref) {
          apply(pref);
        };
        if (mq.addEventListener) {
          mq.addEventListener('change', function () {
            var cur = 'system';
            try { cur = localStorage.getItem(KEY) || 'system'; } catch (e) {}
            if (cur === 'system') apply('system');
          });
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <style>
      @font-face { font-family: "Inter"; font-style: normal; font-weight: 400; font-display: swap; src: url(https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Inter"; font-style: normal; font-weight: 500; font-display: swap; src: url(https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Inter"; font-style: normal; font-weight: 600; font-display: swap; src: url(https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Poppins"; font-style: normal; font-weight: 400; font-display: swap; src: url(https://fonts.gstatic.com/s/poppins/v24/pxiEyp8kv8JHgFVrJJfecg.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Poppins"; font-style: normal; font-weight: 500; font-display: swap; src: url(https://fonts.gstatic.com/s/poppins/v24/pxiByp8kv8JHgFVrLGT9Z1xlFQ.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Poppins"; font-style: normal; font-weight: 600; font-display: swap; src: url(https://fonts.gstatic.com/s/poppins/v24/pxiByp8kv8JHgFVrLEj6Z1xlFQ.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Poppins"; font-style: normal; font-weight: 700; font-display: swap; src: url(https://fonts.gstatic.com/s/poppins/v24/pxiByp8kv8JHgFVrLCz7Z1xlFQ.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    </style>
    <style is:inline>
      :root {
        color-scheme: light;
        --color-primary: #2563EB;
        --color-success: #16A34A;
        --color-danger: #DC2626;
        --color-neutral: #64748B;
        --color-bg-subtle: #F1F5F9;
        --color-text: #0F172A;
        --color-text-muted: #475569;
        --color-border: #E2E8F0;
        --color-surface: #FFFFFF;
        --color-border-strong: #CBD5E1;
        --color-hover: rgba(15, 23, 42, 0.04);
        --color-sidebar: #0F172A;
        --font-heading: 'Poppins', sans-serif;
        --font-body: 'Inter', sans-serif;
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --shadow-card: 0 1px 2px rgba(15,23,42,.06), 0 1px 3px rgba(15,23,42,.08);
        --color-warning-bg: #FFFBEB;
        --color-warning-border: #FDE68A;
        --color-warning-text: #92400E;
        --max-width: 1120px;
      }
      :root.dark {
        color-scheme: dark;
        --color-bg-subtle: #0F172A;
        --color-text: #E2E8F0;
        --color-text-muted: #94A3B8;
        --color-border: #334155;
        --color-surface: #1E293B;
        --color-border-strong: #475569;
        --color-hover: rgba(255, 255, 255, 0.06);
        --color-sidebar: #0B1121;
        --shadow-card: 0 1px 2px rgba(0,0,0,.4), 0 1px 3px rgba(0,0,0,.5);
        --color-warning-bg: #422006;
        --color-warning-border: #78350F;
        --color-warning-text: #FDE68A;
      }
      @keyframes fd-fadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes fd-float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-16px); }
      }
      @keyframes fd-float-lg {
        0%, 100% { transform: translateY(0px) scale(1); }
        33% { transform: translateY(-24px) scale(1.04); }
        66% { transform: translateY(8px) scale(0.97); }
      }
      @keyframes fd-orb-drift {
        0% { transform: translate(0, 0) rotate(0deg); }
        25% { transform: translate(40px, -30px) rotate(90deg); }
        50% { transform: translate(-20px, -50px) rotate(180deg); }
        75% { transform: translate(-40px, 10px) rotate(270deg); }
        100% { transform: translate(0, 0) rotate(360deg); }
      }
      @keyframes fd-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }
      .fd-float { animation: fd-float var(--float-duration, 5s) ease-in-out var(--float-delay, 0s) infinite; }
      .fd-float-lg { animation: fd-float-lg var(--float-duration, 8s) ease-in-out var(--float-delay, 0s) infinite; }
      .fd-orb-drift { animation: fd-orb-drift var(--float-duration, 20s) linear var(--float-delay, 0s) infinite; }
      .fd-glass {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
      }
      html:not(.js) .reveal,
      html:not(.js) .reveal-left,
      html:not(.js) .reveal-right,
      html:not(.js) .reveal-scale { opacity: 0; transform: translateY(30px); }
      .js .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
      .js .reveal-left { opacity: 0; transform: translateX(-30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
      .js .reveal-right { opacity: 0; transform: translateX(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
      .js .reveal-scale { opacity: 0; transform: scale(0.9); transition: opacity 0.5s ease-out, transform 0.5s ease-out; }
      .js .reveal.revealed { opacity: 1; transform: translateY(0); }
      .js .reveal-left.revealed { opacity: 1; transform: translateX(0); }
      .js .reveal-right.revealed { opacity: 1; transform: translateX(0); }
      .js .reveal-scale.revealed { opacity: 1; transform: scale(1); }
      .shimmer {
        background: linear-gradient(90deg, var(--color-bg-subtle) 25%, rgba(255,255,255,0.5) 50%, var(--color-bg-subtle) 75%);
        background-size: 200% 100%;
        animation: fd-shimmer 1.5s ease-in-out infinite;
        border-radius: var(--radius-md);
      }
      .shimmer-card { padding: 24px; border-radius: var(--radius-lg); border: 1px solid var(--color-border); background: var(--color-surface); }
      .shimmer-line { height: 14px; margin-bottom: 10px; }
      .shimmer-line:last-child { width: 60%; }
      .shimmer-line-sm { height: 10px; width: 40%; margin-bottom: 8px; }
      .shimmer-block { height: 180px; margin-bottom: 16px; }
      .shimmer-avatar { width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0; }
      .shimmer-row { display: flex; align-items: center; gap: 12px; }
      .orb-animate { will-change: transform; }
      @media (prefers-reduced-motion: no-preference) {
        .page-enter { animation: fd-fadeIn 0.28s ease-out; }
      }
    </style>
  </head>
  <body>
    <Nav active={active} variant={variant} />
    <slot />
    <div id="toast-container"></div>
  </body>
</html>

<script type="module">
  import {
    initFloating,
    initReveal,
    initCounters,
  } from "../scripts/effects.js";
  document.addEventListener("DOMContentLoaded", function () {
    initReveal();
    initCounters();
    initFloating(".fd-float, .fd-float-lg, .fd-orb-drift");
  });

  window.showToast = function (opts) {
    var container = document.getElementById("toast-container");
    if (!container) return;
    var type = opts.type || "info";
    var msg = opts.message || "";
    var duration = opts.duration || 6500;
    var icons = {
      success:
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
      error:
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',
      info: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
    };
    var el = document.createElement("div");
    el.className = "toast toast-" + type;
    el.innerHTML =
      '<div class="toast-icon">' +
      (icons[type] || icons.info) +
      '</div><span class="toast-msg">' +
      msg +
      "</span>";
    container.appendChild(el);
    requestAnimationFrame(function () {
      el.classList.add("toast-visible");
    });
    setTimeout(function () {
      el.classList.remove("toast-visible");
      setTimeout(function () {
        el.remove();
      }, 300);
    }, duration);
  };
</script>

<style is:inline>
  *,*::before,*::after{box-sizing:border-box}
  img{max-width:100%;display:block}
  body{margin:0;min-height:100vh;min-height:100dvh;display:flex;flex-direction:column;font-family:var(--font-body);color:var(--color-text);background:var(--color-surface);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;overflow-x:hidden;overflow-wrap:break-word;word-break:break-word}
  body>main{flex:1;display:flex;flex-direction:column;min-height:0}
</style>

<style is:inline>
  #toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
  }

  :global(.toast) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 10px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    pointer-events: auto;
    transform: translateX(120%);
    opacity: 0;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
    max-width: 360px;
  }

  :global(.toast.toast-visible) {
    transform: translateX(0);
    opacity: 1;
  }

  :global(.toast-icon) {
    display: flex;
    flex-shrink: 0;
  }

  :global(.toast-success .toast-icon) {
    color: #16a34a;
  }
  :global(.toast-error .toast-icon) {
    color: #dc2626;
  }
  :global(.toast-info .toast-icon) {
    color: #2563eb;
  }

  :global(.toast-msg) {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
  }

  :global(.skeleton) {
    background: linear-gradient(90deg, var(--color-bg-subtle) 25%, var(--color-border) 50%, var(--color-bg-subtle) 75%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s ease-in-out infinite;
    border-radius: 6px;
  }

  @keyframes skeleton-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  :global(.confirm-overlay) {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    padding: 24px;
    animation: confirm-fade-in 0.15s ease-out;
  }
  :global(.confirm-modal) {
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 16px;
    padding: 28px 28px 24px;
    max-width: 400px;
    width: 100%;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.22);
    animation: confirm-scale-in 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.confirm-modal h3) {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    color: var(--color-text, #0f172a);
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }
  :global(.confirm-modal p) {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-muted, #475569);
    margin: 0 0 22px;
  }
  :global(.confirm-actions) {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }
  :global(.confirm-cancel-btn) {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 13px;
    color: var(--color-text-muted, #475569);
    background: var(--color-bg-subtle, #f1f5f9);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 10px;
    padding: 9px 16px;
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  :global(.confirm-cancel-btn:hover) {
    background: var(--color-border, #e2e8f0);
  }
  :global(.confirm-delete-btn) {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    color: white;
    background: #dc2626;
    border: none;
    border-radius: 10px;
    padding: 9px 16px;
    cursor: pointer;
    transition:
      background 0.15s,
      transform 0.15s;
  }
  :global(.confirm-delete-btn:hover) {
    background: #b91c1c;
  }
  :global(.confirm-primary-btn) {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    color: white;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    border: none;
    border-radius: 10px;
    padding: 9px 16px;
    cursor: pointer;
    transition:
      box-shadow 0.15s,
      transform 0.15s;
  }
  :global(.confirm-primary-btn:hover) {
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
  }
  @keyframes confirm-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes confirm-scale-in {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(6px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (max-width: 480px) {
    #toast-container {
      left: 16px;
      right: 16px;
      bottom: 16px;
    }

    .toast {
      max-width: 100%;
    }

    [class*="orb"],
    [class*="orb-"] {
      filter: blur(40px) !important;
    }
  }
</style>
