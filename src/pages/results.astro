---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Results" description="AI fracture analysis results with confidence score and heatmap localization" active="analyze" variant="app">
  <main class="results-page page-enter">
    <div class="dash-layout">
      <div class="dash-main">
        <div class="dash-content">

          <div class="top-bar">
            <div class="top-left">
              <h1 class="top-title">Analysis Results</h1>
              <p class="top-subtitle">AI-powered fracture detection outcome</p>
            </div>
            <div class="top-right">
              <a href="/analyze" class="top-btn-primary" id="btn-another">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                New Analysis
              </a>
              <button class="top-icon-btn" id="btn-download" title="Export Report">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              </button>
            </div>
          </div>

          <div class="row row-1">
            <div class="card card-diag">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Diagnosis</span>
              </div>
              <div class="diag-result">
                <span class="diag-badge" id="diag-badge">No Result</span>
              </div>
              <div class="diag-meta" id="diag-meta">Run an analysis to see results</div>
            </div>

            <div class="card card-conf">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                <span>Confidence Score</span>
              </div>
              <div class="gauge-wrap">
                <svg class="gauge-svg" viewBox="0 0 120 120">
                  <circle class="gauge-bg" cx="60" cy="60" r="50" fill="none" stroke="var(--color-bg-subtle)" stroke-width="8" />
                  <circle class="gauge-fill" id="gauge-fill" cx="60" cy="60" r="50" fill="none" stroke="var(--color-primary)" stroke-width="8" stroke-linecap="round" stroke-dasharray="314.16" stroke-dashoffset="314.16" transform="rotate(-90 60 60)" />
                  <text class="gauge-text" id="gauge-text" x="60" y="60" text-anchor="middle" dominant-baseline="central" font-size="22" font-weight="700" fill="currentColor">—</text>
                </svg>
              </div>
              <div class="conf-label">Confidence</div>
            </div>

            <div class="card card-ood">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
                <span>Novelty / OOD Score</span>
              </div>
              <div class="ood-value" id="ood-value">—</div>
              <div class="ood-label" id="ood-label">No data</div>
              <div class="ood-bar-wrap">
                <div class="ood-bar-fill" id="ood-bar-fill" style="width:0%"></div>
              </div>
            </div>

          </div>

          <div class="row row-2">
            <div class="pipeline-step">
              <div class="step-label">Original X-ray</div>
              <div class="step-img-wrap">
                <img id="img-original" class="step-img" alt="Original X-ray" />
                <div class="step-empty" id="empty-original">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                  <span>No image</span>
                </div>
              </div>
            </div>

            <div class="pipeline-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
            </div>

            <div class="pipeline-step">
              <div class="step-label">Predicted Heatmap</div>
              <div class="step-img-wrap">
                <img id="img-heatmap" class="step-img" alt="Heatmap" />
                <div class="step-empty" id="empty-heatmap">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                  <span>No image</span>
                </div>
              </div>
            </div>
          </div>

          <div class="row row-3">
            <div class="card">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>Recommendation</span>
              </div>
              <p class="reco-text" id="reco-text">Run an analysis to see recommendations</p>
              <span class="reco-severity" id="reco-severity">Pending</span>
            </div>

            <div class="card">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
                <span>Class Probabilities</span>
              </div>
              <div class="probs-chart">
                <div class="prob-bar-row">
                  <span class="prob-label">Fracture</span>
                  <div class="prob-bar-track"><div class="prob-bar-fill prob-bar-danger" id="prob-bar-fracture" style="width:0%"></div></div>
                  <span class="prob-value" id="prob-value-fracture">0.0%</span>
                </div>
                <div class="prob-bar-row">
                  <span class="prob-label">Normal</span>
                  <div class="prob-bar-track"><div class="prob-bar-fill prob-bar-safe" id="prob-bar-normal" style="width:0%"></div></div>
                  <span class="prob-value" id="prob-value-normal">0.0%</span>
                </div>
                <div class="probs-empty" id="probs-empty">No probability data</div>
              </div>
            </div>

            <div class="card">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
                <span>Novelty Score</span>
              </div>
              <div class="speedo-wrap">
                <svg class="speedo-svg" viewBox="0 0 200 110" fill="none">
                  <path class="speedo-track" d="M 28 100 A 72 72 0 0 1 172 100" stroke="var(--color-bg-subtle)" stroke-width="9" stroke-linecap="round" />
                  <path class="speedo-fill" id="speedo-fill" d="M 28 100 A 72 72 0 0 1 172 100" stroke="var(--color-success)" stroke-width="9" stroke-linecap="round" stroke-dasharray="226" stroke-dashoffset="226" />
                  <line class="speedo-needle" id="speedo-needle" x1="100" y1="100" x2="100" y2="42" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" transform="rotate(-90 100 100)" />
                </svg>
                <div class="speedo-readout" id="speedo-readout">—</div>
                <div class="speedo-status" id="speedo-status">No data</div>
              </div>
            </div>

            <div class="card">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>
                <span>Key Information</span>
              </div>
              <div class="info-list">
                <div class="info-row"><span class="info-key">Patient</span><span class="info-val" id="info-patient">—</span></div>
                <div class="info-row"><span class="info-key">Date</span><span class="info-val" id="info-date">—</span></div>
                <div class="info-row"><span class="info-key">Status</span><span class="info-val" id="info-status">—</span></div>
                <div class="info-row"><span class="info-key">Inference Time</span><span class="info-val" id="info-inference">—</span></div>
              </div>
            </div>
          </div>

          <div class="report-card card">
            <div class="card-header">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              <span>Export Report</span>
            </div>
            <p class="report-desc">Download a printable summary of this analysis, including the patient details, diagnosis, confidence score, and findings.</p>
            <button class="report-btn" id="report-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              Download Report
            </button>
          </div>

          <div class="batch-nav hidden" id="batch-nav">
            <div class="batch-nav-info">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" /></svg>
              <span id="batch-nav-text">1 of 3 analyzed</span>
            </div>
            <button class="btn-primary" id="btn-next-image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
              Next Image
            </button>
          </div>

        </div>
      </div>
    </div>
  </main>
</Layout>

<script type="module">
  import { saveAnalysis } from '../scripts/api.js';

  var imageData = sessionStorage.getItem('fracturedetect:image');
  var resultData = sessionStorage.getItem('fracturedetect:result');

  (async function () {
    if (!resultData) {
      window.location.replace('/analyze');
      return;
    }

    var result = JSON.parse(resultData);
    var isFracture = result.prediction === 'fracture';
    var confNum = parseFloat((result.confidence * 100).toFixed(1));

    var origImg = document.getElementById('img-original');
    var heatImg = document.getElementById('img-heatmap');
    var emptyOrig = document.getElementById('empty-original');
    var emptyHeat = document.getElementById('empty-heatmap');

    if (imageData && origImg && heatImg) {
      origImg.src = imageData;
      heatImg.src = imageData;
      if (emptyOrig) emptyOrig.classList.add('hidden');
      if (emptyHeat) emptyHeat.classList.add('hidden');
    }

    /* Diagnosis */
    var diagBadge = document.getElementById('diag-badge');
    var diagMeta = document.getElementById('diag-meta');
    if (isFracture) {
      diagBadge.textContent = 'Fracture Detected';
      diagBadge.style.color = 'var(--color-danger)';
      diagBadge.style.background = 'rgba(220,38,38,0.1)';
      diagMeta.textContent = 'High confidence positive finding';
    } else {
      diagBadge.textContent = 'Normal';
      diagBadge.style.color = 'var(--color-success)';
      diagBadge.style.background = 'rgba(22,163,74,0.1)';
      diagMeta.textContent = 'No fracture detected';
    }

    /* Confidence gauge */
    var gaugeFill = document.getElementById('gauge-fill');
    var gaugeText = document.getElementById('gauge-text');
    var circumference = 314.16;
    var offset = circumference - (confNum / 100) * circumference;
    if (gaugeFill) {
      gaugeFill.style.strokeDashoffset = offset;
      gaugeFill.style.stroke = isFracture ? 'var(--color-danger)' : 'var(--color-success)';
    }
    if (gaugeText) gaugeText.textContent = confNum + '%';

    /* OOD score */
    var oodScore = 18.4;
    var oodValue = document.getElementById('ood-value');
    var oodLabel = document.getElementById('ood-label');
    var oodFill = document.getElementById('ood-bar-fill');
    if (oodValue) oodValue.textContent = oodScore.toFixed(1);
    if (oodLabel) oodLabel.textContent = oodScore < 25 ? 'Low — in-distribution' : oodScore < 50 ? 'Moderate' : 'High — out-of-distribution';
    if (oodFill) oodFill.style.width = Math.min(oodScore, 100) + '%';

    /* Recommendation */
    var recoText = document.getElementById('reco-text');
    var recoSeverity = document.getElementById('reco-severity');
    if (recoText && recoSeverity) {
      if (isFracture) {
        recoText.textContent = 'Immediate medical consultation recommended. Please consult with an orthopedic specialist for further evaluation and treatment planning.';
        recoSeverity.textContent = 'Action Required';
        recoSeverity.className = 'reco-severity reco-severity-danger';
      } else {
        recoText.textContent = 'No signs of fracture detected. Continue routine monitoring as recommended by your healthcare provider.';
        recoSeverity.textContent = 'Routine';
        recoSeverity.className = 'reco-severity reco-severity-safe';
      }
    }

    /* Probabilities */
    var findingsText = isFracture
      ? ['Bone discontinuity detected in the forearm region', 'Fracture localized to the mid-shaft of the radius', 'No signs of comminution or displacement detected']
      : ['No visible bone discontinuity detected', 'Bone alignment appears normal', 'No suspicious abnormalities identified'];

    var probFracture = document.getElementById('prob-bar-fracture');
    var probNormal = document.getElementById('prob-bar-normal');
    var probValFracture = document.getElementById('prob-value-fracture');
    var probValNormal = document.getElementById('prob-value-normal');
    var probsEmpty = document.getElementById('probs-empty');
    if (probFracture && probNormal) {
      if (probsEmpty) probsEmpty.style.display = 'none';
      var fracPct = isFracture ? confNum : (100 - confNum);
      var normPct = isFracture ? (100 - confNum) : confNum;
      probFracture.style.width = fracPct + '%';
      probNormal.style.width = normPct + '%';
      if (probValFracture) probValFracture.textContent = fracPct.toFixed(1) + '%';
      if (probValNormal) probValNormal.textContent = normPct.toFixed(1) + '%';
    }

    /* Speedometer */
    var speedoFill = document.getElementById('speedo-fill');
    var speedoNeedle = document.getElementById('speedo-needle');
    var speedoReadout = document.getElementById('speedo-readout');
    var speedoStatus = document.getElementById('speedo-status');
    if (speedoFill && speedoNeedle) {
      var maxDash = 226;
      var oodAngle = Math.min(oodScore / 100, 1) * 180;
      var oodOffset = maxDash - (oodAngle / 180) * maxDash;
      speedoFill.style.strokeDashoffset = oodOffset;
      speedoNeedle.setAttribute('transform', 'rotate(' + (oodAngle - 90) + ' 100 100)');
      speedoReadout.textContent = oodScore.toFixed(1);
      if (oodScore < 25) {
        speedoFill.style.stroke = 'var(--color-success)';
        speedoStatus.textContent = 'In-distribution';
        speedoStatus.style.color = 'var(--color-success)';
      } else if (oodScore < 50) {
        speedoFill.style.stroke = '#f59e0b';
        speedoStatus.textContent = 'Borderline';
        speedoStatus.style.color = '#f59e0b';
      } else {
        speedoFill.style.stroke = 'var(--color-danger)';
        speedoStatus.textContent = 'Out-of-distribution';
        speedoStatus.style.color = 'var(--color-danger)';
      }
    }

    /* Key Information */
    var infoPatient = document.getElementById('info-patient');
    var infoDate = document.getElementById('info-date');
    var infoStatus = document.getElementById('info-status');
    var infoInference = document.getElementById('info-inference');
    var patientId = sessionStorage.getItem('fracturedetect:patient_id');
    var currentPatientName = '';
    var currentPatientMrn = '';
    if (patientId) {
      import('../scripts/patients.js').then(function (mod) {
        mod.getPatient(patientId).then(function (p) {
          if (p) {
            currentPatientName = p.name || '';
            currentPatientMrn = p.medical_record_id || '';
            if (infoPatient) {
              infoPatient.textContent = currentPatientName + (currentPatientMrn ? ' · ' + currentPatientMrn : '');
            }
          }
        });
      });
    }
    if (infoDate) infoDate.textContent = new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    if (infoStatus) {
      infoStatus.textContent = isFracture ? 'Fracture Detected' : 'Normal';
      infoStatus.style.color = isFracture ? 'var(--color-danger)' : 'var(--color-success)';
    }
    if (infoInference) infoInference.textContent = result.inferenceTimeSec.toFixed(2) + 's';

    /* Buttons */
    var btnAnother = document.getElementById('btn-another');
    if (btnAnother) {
      btnAnother.addEventListener('click', function (e) {
        sessionStorage.removeItem('fracturedetect:image');
        sessionStorage.removeItem('fracturedetect:result');
        sessionStorage.removeItem('fracturedetect:queue');
        window.location.href = '/analyze';
      });
    }

    /* Report download */
    function downloadReport() {
      var canvas = document.createElement('canvas');
      var ctx = canvas.getContext('2d');
      canvas.width = 800;
      var imgW = 400, imgH = 300;
      canvas.height = 700 + imgH + findingsText.length * 28;

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#0F172A';
      ctx.font = 'bold 26px Poppins, sans-serif';
      ctx.fillText('FractureDetect Analysis Report', 40, 50);
      ctx.fillStyle = '#475569';
      ctx.font = '14px Inter, sans-serif';
      ctx.fillText('Generated: ' + new Date().toLocaleString(), 40, 80);

      if (currentPatientName || currentPatientMrn) {
        ctx.fillText('Patient: ' + (currentPatientName || '—') + (currentPatientMrn ? '  (' + currentPatientMrn + ')' : ''), 40, 104);
        ctx.strokeStyle = '#E2E8F0';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(40, 122); ctx.lineTo(760, 122); ctx.stroke();
        var contentTop = 150;
      } else {
        ctx.strokeStyle = '#E2E8F0';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(40, 100); ctx.lineTo(760, 100); ctx.stroke();
        var contentTop = 128;
      }

      ctx.fillStyle = '#0F172A';
      ctx.font = 'bold 20px Poppins, sans-serif';
      ctx.fillText('Prediction: ' + diagBadge.textContent, 40, contentTop + 12);
      ctx.fillStyle = isFracture ? '#DC2626' : '#16A34A';
      ctx.font = 'bold 40px Poppins, sans-serif';
      ctx.fillText(confNum + '%', 40, contentTop + 62);
      ctx.fillStyle = '#475569';
      ctx.font = '14px Inter, sans-serif';
      ctx.fillText('Confidence Score', 40, contentTop + 82);
      ctx.fillStyle = '#0F172A';
      ctx.font = '15px Inter, sans-serif';
      ctx.fillText('Inference Time: ' + (result.inferenceTimeSec || 0).toFixed(2) + ' sec', 40, contentTop + 120);
      ctx.fillText('Model Version: v2.1.0', 40, contentTop + 144);

      ctx.strokeStyle = '#E2E8F0'; ctx.beginPath(); ctx.moveTo(40, contentTop + 168); ctx.lineTo(760, contentTop + 168); ctx.stroke();
      ctx.fillStyle = '#0F172A'; ctx.font = 'bold 16px Poppins, sans-serif';
      ctx.fillText('Findings Summary', 40, contentTop + 197);
      ctx.fillStyle = '#334155'; ctx.font = '14px Inter, sans-serif';
      findingsText.forEach(function (t, i) { ctx.fillText('\u2022  ' + t, 40, contentTop + 225 + i * 28); });

      var findingsEndY = contentTop + 225 + findingsText.length * 28;
      ctx.strokeStyle = '#E2E8F0'; ctx.beginPath(); ctx.moveTo(40, findingsEndY + 8); ctx.lineTo(760, findingsEndY + 8); ctx.stroke();
      ctx.fillStyle = '#0F172A'; ctx.font = 'bold 16px Poppins, sans-serif';
      ctx.fillText('X-ray Image', 40, findingsEndY + 40);

      var imgX = Math.round((canvas.width - imgW) / 2);
      var origImgEl = document.getElementById('img-original');
      if (origImgEl && origImgEl.src) ctx.drawImage(origImgEl, imgX, findingsEndY + 56, imgW, imgH);

      if (isFracture) {
        var overlayCanvas = document.createElement('canvas');
        overlayCanvas.width = imgW; overlayCanvas.height = imgH;
        var octx = overlayCanvas.getContext('2d');
        var gradient = octx.createRadialGradient(imgW * 0.42, imgH * 0.52, 0, imgW * 0.42, imgH * 0.52, imgW * 0.5);
        gradient.addColorStop(0, 'rgba(255, 50, 0, 0.5)');
        gradient.addColorStop(0.18, 'rgba(255, 130, 0, 0.35)');
        gradient.addColorStop(0.38, 'rgba(255, 220, 0, 0.2)');
        gradient.addColorStop(1, 'transparent');
        octx.fillStyle = gradient; octx.fillRect(0, 0, imgW, imgH);
        ctx.drawImage(overlayCanvas, imgX, findingsEndY + 56, imgW, imgH);
      }

      var imgBottomY = findingsEndY + 56 + imgH + 24;
      ctx.strokeStyle = '#E2E8F0'; ctx.beginPath(); ctx.moveTo(40, imgBottomY); ctx.lineTo(760, imgBottomY); ctx.stroke();
      ctx.fillStyle = '#475569'; ctx.font = '13px Inter, sans-serif';
      ctx.fillText('This result is intended to assist healthcare professionals and should not replace', 40, imgBottomY + 24);
      ctx.fillText('professional medical diagnosis.', 40, imgBottomY + 44);

      var fileNameParts = [];
      if (currentPatientName) fileNameParts.push(currentPatientName);
      if (currentPatientMrn) fileNameParts.push(currentPatientMrn);
      fileNameParts.push('fracture-detection-report');
      var fileName = fileNameParts.join('-').replace(/[^a-z0-9\-_]/gi, '').toLowerCase() + '.png';

      var link = document.createElement('a');
      link.download = fileName;
      link.href = canvas.toDataURL('image/png');
      link.click();
    }

    var downloadBtn = document.getElementById('btn-download');
    if (downloadBtn) downloadBtn.addEventListener('click', downloadReport);
    var reportBtn = document.getElementById('report-btn');
    if (reportBtn) reportBtn.addEventListener('click', downloadReport);

    var findingsItems = findingsText;

    saveAnalysis(
      imageData,
      result.prediction,
      result.confidence,
      result.inferenceTimeSec,
      findingsItems,
      patientId
    );

    /* ── Batch queue navigation ── */
    var queueData = sessionStorage.getItem('fracturedetect:queue');
    var remainingCount = parseInt(sessionStorage.getItem('fracturedetect:remaining')) || 0;
    var batchNav = document.getElementById('batch-nav');
    var batchNavText = document.getElementById('batch-nav-text');
    var btnNextImage = document.getElementById('btn-next-image');

    if (batchNav && batchNavText) {
      var hasQueue = queueData;
      var totalRemaining = hasQueue ? JSON.parse(queueData).length : remainingCount;
      if (totalRemaining > 0) {
        batchNavText.textContent = hasQueue ? '1 of ' + (totalRemaining + 1) + ' analyzed — ' + totalRemaining + ' remaining' : totalRemaining + ' image(s) remaining';
        batchNav.classList.remove('hidden');
      }

      if (btnNextImage) {
        btnNextImage.addEventListener('click', function () {
          if (hasQueue) {
            var queue = JSON.parse(queueData);
            var next = queue.shift();
            if (next && next.data) {
              try {
                sessionStorage.setItem('fracturedetect:image', next.data);
                if (queue.length > 0) {
                  sessionStorage.setItem('fracturedetect:queue', JSON.stringify(queue));
                  sessionStorage.setItem('fracturedetect:remaining', queue.length);
                } else {
                  sessionStorage.removeItem('fracturedetect:queue');
                  sessionStorage.removeItem('fracturedetect:remaining');
                }
                sessionStorage.removeItem('fracturedetect:result');
                window.location.href = '/processing';
              } catch (err) {
                console.warn('Failed to navigate to next image:', err);
              }
            }
          } else {
            sessionStorage.removeItem('fracturedetect:result');
            window.location.href = '/analyze';
          }
        });
      }
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'e' || e.key === 'E') {
        if (!e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          downloadBtn?.click();
        }
      }
      if (e.key === 'n' || e.key === 'N') {
        if (!e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          if (batchNav && !batchNav.classList.contains('hidden')) {
            btnNextImage?.click();
          } else {
            btnAnother?.click();
          }
        }
      }
    });
  })();
</script>

