---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Results" description="AI fracture analysis results with confidence score and heatmap localization" active="analyze" variant="app">
  <main class="results-page page-enter">
    <div class="res-bg">
      <div class="res-orb orb-1"></div>
      <div class="res-orb orb-2"></div>
    </div>
    <div class="results-container">
      <div class="res-badge" id="res-badge">
        <span class="badge-dot"></span>
        <span id="badge-text">Analysis Complete</span>
      </div>

      <div class="results-grid">
        <div class="image-comparison">
          <div class="image-card">
            <div class="image-card-header">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
              </svg>
              Original X-ray
            </div>
            <div class="image-container">
              <img id="img-original" alt="Original X-ray image" />
              <div class="image-empty" id="empty-original">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                  <circle cx="8.5" cy="8.5" r="1.5" />
                  <polyline points="21 15 16 10 5 21" />
                </svg>
                <span class="image-empty-text">No image available</span>
              </div>
            </div>
          </div>
          <div class="image-card">
            <div class="image-card-header">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
              </svg>
              Fracture Localization
            </div>
            <div class="image-container">
              <img id="img-localization" alt="X-ray with AI-highlighted fracture region" />
              <div class="heatmap-overlay hidden" id="heatmap-overlay"></div>
              <div class="image-empty" id="empty-localization">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                  <circle cx="8.5" cy="8.5" r="1.5" />
                  <polyline points="21 15 16 10 5 21" />
                </svg>
                <span class="image-empty-text">No image available</span>
              </div>
            </div>
            <div class="heatmap-legend hidden" id="heatmap-legend">
              <span class="legend-label">Low</span>
              <div class="legend-bar"></div>
              <span class="legend-label">High</span>
            </div>
          </div>
        </div>

        <div class="results-sidebar">
          <div class="prediction-card" id="prediction-card" data-prediction="fracture">
            <p class="prediction-header">Prediction</p>
            <div class="prediction-result">
              <span class="prediction-icon" id="prediction-icon"></span>
              <span class="prediction-text" id="prediction-text">Fracture Detected</span>
            </div>
          </div>

          <div class="findings-card">
            <p class="findings-header">Findings Summary</p>
            <ul class="findings-list" id="findings-list">
              <li class="findings-item">
                <span class="findings-bullet"></span>
                <span>Bone discontinuity detected in the forearm region</span>
              </li>
              <li class="findings-item">
                <span class="findings-bullet"></span>
                <span>Fracture localized to the mid-shaft of the radius</span>
              </li>
              <li class="findings-item">
                <span class="findings-bullet"></span>
                <span>No signs of comminution or displacement detected</span>
              </li>
            </ul>
          </div>

          <div class="metrics-card">
            <div class="metric-row">
              <div class="metric-item">
                <span class="metric-value-lg" id="confidence-value">96.8%</span>
                <span class="metric-label">Confidence</span>
              </div>
              <div class="metric-item">
                <div class="metric-inline">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                  <span class="metric-value" id="inference-time-value">0.42s</span>
                </div>
                <span class="metric-label">Inference</span>
              </div>
            </div>
            <div class="metric-divider"></div>
            <div class="metric-row">
              <div class="metric-item">
                <div class="metric-inline">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                  </svg>
                  <span class="metric-value" style="color: var(--color-success);">Completed</span>
                </div>
                <span class="metric-label">Status</span>
              </div>
              <div class="metric-item">
                <span class="metric-value" id="model-version">v2.1.0</span>
                <span class="metric-label">Model</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="disclaimer-banner">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
        <span class="disclaimer-text">This result is intended to assist healthcare professionals and should not replace professional medical diagnosis.</span>
      </div>

      <div class="action-row">
        <button class="btn-primary" id="btn-another" data-ripple>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10" />
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
          </svg>
          Analyze Another Image
        </button>
        <button class="btn-secondary" id="btn-download" data-ripple>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Export Report
        </button>
      </div>
    </div>
  </main>
</Layout>

<script type="module">
  import { saveAnalysis } from '../scripts/api.js';
  import { supabase } from '../lib/supabase.js';

  var imageData = sessionStorage.getItem('fracturedetect:image');
  var resultData = sessionStorage.getItem('fracturedetect:result');

  (async function () {
    if (!resultData) {
      window.location.replace('/analyze');
      return;
    }

    var result = JSON.parse(resultData);

    var originalImg = document.getElementById('img-original');
    var localizationImg = document.getElementById('img-localization');
    var emptyOriginal = document.getElementById('empty-original');
    var emptyLocalization = document.getElementById('empty-localization');
    var heatmapOverlay = document.getElementById('heatmap-overlay');
    var heatmapLegend = document.getElementById('heatmap-legend');

    if (imageData && originalImg && localizationImg) {
      originalImg.src = imageData;
      localizationImg.src = imageData;
      if (emptyOriginal) emptyOriginal.classList.add('hidden');
      if (emptyLocalization) emptyLocalization.classList.add('hidden');
      if (heatmapOverlay) heatmapOverlay.classList.remove('hidden');
      if (heatmapLegend) heatmapLegend.classList.remove('hidden');
    }

    var predictionCard = document.getElementById('prediction-card');
    var predictionIcon = document.getElementById('prediction-icon');
    var predictionText = document.getElementById('prediction-text');
    var badgeText = document.getElementById('badge-text');

    if (predictionCard && predictionIcon && predictionText) {
      predictionCard.setAttribute('data-prediction', result.prediction);

      if (result.prediction === 'fracture') {
        predictionIcon.innerHTML =
          '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
          '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>' +
          '<line x1="12" y1="9" x2="12" y2="13"/>' +
          '<line x1="12" y1="17" x2="12.01" y2="17"/>' +
          '</svg>';
        predictionText.textContent = 'Fracture Detected';
        if (badgeText) badgeText.textContent = 'Fracture Detected';
      } else {
        predictionIcon.innerHTML =
          '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">' +
          '<polyline points="20 6 9 17 4 12"/>' +
          '</svg>';
        predictionText.textContent = 'No Fracture Detected';
        if (badgeText) badgeText.textContent = 'No Fracture Detected';
      }
    }

    var confidenceEl = document.getElementById('confidence-value');
    if (confidenceEl) {
      var targetConfidence = (result.confidence * 100).toFixed(1);
      confidenceEl.textContent = targetConfidence + '%';
      confidenceEl.style.color =
        result.prediction === 'fracture'
          ? 'var(--color-danger)'
          : 'var(--color-success)';
    }

    var inferenceEl = document.getElementById('inference-time-value');
    if (inferenceEl) {
      inferenceEl.textContent = result.inferenceTimeSec.toFixed(2) + 's';
    }

    var findingsList = document.getElementById('findings-list');
    if (findingsList && result.prediction !== 'fracture') {
      findingsList.innerHTML =
        '<li class="findings-item">' +
        '<span class="findings-bullet"></span>' +
        '<span>No visible bone discontinuity detected</span>' +
        '</li>' +
        '<li class="findings-item">' +
        '<span class="findings-bullet"></span>' +
        '<span>Bone alignment appears normal</span>' +
        '</li>' +
        '<li class="findings-item">' +
        '<span class="findings-bullet"></span>' +
        '<span>No suspicious abnormalities identified</span>' +
        '</li>';
    }

    var btnAnother = document.getElementById('btn-another');
    if (btnAnother) {
      btnAnother.addEventListener('click', function () {
        sessionStorage.removeItem('fracturedetect:image');
        sessionStorage.removeItem('fracturedetect:result');
        window.location.href = '/analyze';
      });
    }

    var btnDownload = document.getElementById('btn-download');
    if (btnDownload) {
      btnDownload.addEventListener('click', function () {
        var canvas = document.createElement('canvas');
        var ctx = canvas.getContext('2d');
        canvas.width = 800;

        var originalImg = document.getElementById('img-original');
        var imgW = originalImg ? (originalImg.naturalWidth || 400) : 400;
        var imgH = originalImg ? (originalImg.naturalHeight || 300) : 300;
        var maxImgW = 560;
        var scale = Math.min(maxImgW / imgW, 1);
        var dispW = Math.round(imgW * scale);
        var dispH = Math.round(imgH * scale);
        var findingsText = result.prediction === 'fracture'
          ? ['Bone discontinuity detected in the forearm region', 'Fracture localized to the mid-shaft of the radius', 'No signs of comminution or displacement detected']
          : ['No visible bone discontinuity detected', 'Bone alignment appears normal', 'No suspicious abnormalities identified'];

        canvas.height = 700 + dispH + findingsText.length * 28;

        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = '#0F172A';
        ctx.font = 'bold 26px Poppins, sans-serif';
        ctx.fillText('FractureDetect Analysis Report', 40, 50);

        ctx.fillStyle = '#475569';
        ctx.font = '14px Inter, sans-serif';
        ctx.fillText('Generated: ' + new Date().toLocaleString(), 40, 80);

        ctx.strokeStyle = '#E2E8F0';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(40, 100);
        ctx.lineTo(760, 100);
        ctx.stroke();

        ctx.fillStyle = '#0F172A';
        ctx.font = 'bold 20px Poppins, sans-serif';
        ctx.fillText('Prediction: ' + predictionText.textContent, 40, 140);

        ctx.fillStyle = result.prediction === 'fracture' ? '#DC2626' : '#16A34A';
        ctx.font = 'bold 40px Poppins, sans-serif';
        ctx.fillText((result.confidence * 100).toFixed(1) + '%', 40, 190);

        ctx.fillStyle = '#475569';
        ctx.font = '14px Inter, sans-serif';
        ctx.fillText('Confidence Score', 40, 210);

        ctx.fillStyle = '#0F172A';
        ctx.font = '15px Inter, sans-serif';
        ctx.fillText('Inference Time: ' + result.inferenceTimeSec.toFixed(2) + ' sec', 40, 248);
        ctx.fillText('Model Version: v2.1.0', 40, 272);

        ctx.strokeStyle = '#E2E8F0';
        ctx.beginPath();
        ctx.moveTo(40, 296);
        ctx.lineTo(760, 296);
        ctx.stroke();

        ctx.fillStyle = '#0F172A';
        ctx.font = 'bold 16px Poppins, sans-serif';
        ctx.fillText('Findings Summary', 40, 325);

        ctx.fillStyle = '#334155';
        ctx.font = '14px Inter, sans-serif';
        findingsText.forEach(function (text, i) {
          ctx.fillText('\u2022  ' + text, 40, 353 + i * 28);
        });

        var findingsEndY = 353 + findingsText.length * 28;

        ctx.strokeStyle = '#E2E8F0';
        ctx.beginPath();
        ctx.moveTo(40, findingsEndY + 8);
        ctx.lineTo(760, findingsEndY + 8);
        ctx.stroke();

        ctx.fillStyle = '#0F172A';
        ctx.font = 'bold 16px Poppins, sans-serif';
        ctx.fillText('X-ray & Fracture Localization', 40, findingsEndY + 40);

        var imgX = Math.round((canvas.width - dispW) / 2);
        ctx.drawImage(originalImg, imgX, findingsEndY + 56, dispW, dispH);

        if (result.prediction === 'fracture') {
          var overlay = document.createElement('canvas');
          overlay.width = dispW;
          overlay.height = dispH;
          var octx = overlay.getContext('2d');
          var gradient = octx.createRadialGradient(dispW * 0.42, dispH * 0.52, 0, dispW * 0.42, dispH * 0.52, dispW * 0.5);
          gradient.addColorStop(0, 'rgba(255, 50, 0, 0.5)');
          gradient.addColorStop(0.18, 'rgba(255, 130, 0, 0.35)');
          gradient.addColorStop(0.38, 'rgba(255, 220, 0, 0.2)');
          gradient.addColorStop(1, 'transparent');
          octx.fillStyle = gradient;
          octx.fillRect(0, 0, dispW, dispH);
          ctx.drawImage(overlay, imgX, findingsEndY + 56, dispW, dispH);
        }

        var imgBottomY = findingsEndY + 56 + dispH + 24;

        ctx.strokeStyle = '#E2E8F0';
        ctx.beginPath();
        ctx.moveTo(40, imgBottomY);
        ctx.lineTo(760, imgBottomY);
        ctx.stroke();

        ctx.fillStyle = '#475569';
        ctx.font = '13px Inter, sans-serif';
        ctx.fillText('This result is intended to assist healthcare professionals and should not replace', 40, imgBottomY + 24);
        ctx.fillText('professional medical diagnosis.', 40, imgBottomY + 44);

        var link = document.createElement('a');
        link.download = 'fracturedetect-report.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }

    var findingsItems = (function () {
      var items = [];
      document.querySelectorAll('#findings-list .findings-item span:last-child').forEach(function (el) {
        items.push(el.textContent);
      });
      return items;
    })();

    saveAnalysis(
      imageData,
      result.prediction,
      result.confidence,
      result.inferenceTimeSec,
      findingsItems
    );

    document.addEventListener('keydown', function (e) {
      if (e.key === 'e' || e.key === 'E') {
        if (!e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          btnDownload?.click();
        }
      }
      if (e.key === 'n' || e.key === 'N') {
        if (!e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          btnAnother?.click();
        }
      }
    });

    initImageZoom();
  })();

  /* ── Image Zoom & Pan ── */
  function initImageZoom() {
    var containers = document.querySelectorAll('.image-container');
    containers.forEach(function (container) {
      var img = container.querySelector('img');
      if (!img) return;
      var zoomed = false;
      var startX, startY, panX = 0, panY = 0, originX, originY;
      img.style.cursor = 'zoom-in';
      img.style.transition = 'transform 0.2s ease';

      function toggleZoom(clientX, clientY) {
        zoomed = !zoomed;
        if (zoomed) {
          var rect = container.getBoundingClientRect();
          var px = (clientX - rect.left) / rect.width;
          var py = (clientY - rect.top) / rect.height;
          img.style.transformOrigin = (px * 100) + '% ' + (py * 100) + '%';
          img.style.transform = 'scale(2.5)';
          img.style.cursor = 'grab';
        } else {
          img.style.transform = '';
          img.style.transformOrigin = '';
          img.style.cursor = 'zoom-in';
          panX = 0; panY = 0;
        }
      }

      img.addEventListener('click', function (e) {
        if (!zoomed) toggleZoom(e.clientX, e.clientY);
      });

      img.addEventListener('mousedown', function (e) {
        if (!zoomed) return;
        e.preventDefault();
        startX = e.clientX - panX;
        startY = e.clientY - panY;
        img.style.cursor = 'grabbing';
        function onMove(ev) {
          panX = ev.clientX - startX;
          panY = ev.clientY - startY;
          img.style.transform = 'scale(2.5) translate(' + (panX / 2.5) + 'px, ' + (panY / 2.5) + 'px)';
        }
        function onUp() {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
          img.style.cursor = 'grab';
        }
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      });

      img.addEventListener('dblclick', function () {
        if (zoomed) toggleZoom(0, 0);
      });
    });
  }
</script>

<style>
  .results-page {
    padding: 48px 0 64px;
    position: relative;
    overflow: hidden;
  }

  .res-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .res-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.08;
  }

  .res-orb.orb-1 {
    width: 450px;
    height: 450px;
    background: var(--color-primary);
    top: -150px;
    left: -100px;
  }

  .res-orb.orb-2 {
    width: 350px;
    height: 350px;
    background: #a855f7;
    bottom: -120px;
    right: -80px;
  }

  .results-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  .res-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-success);
    background: rgba(22, 163, 74, 0.08);
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 28px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .res-badge .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
  }

  .results-grid {
    display: grid;
    grid-template-columns: 65fr 35fr;
    gap: 24px;
    margin-bottom: 24px;
    align-items: start;
  }

  .image-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .image-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    background: var(--color-surface);
    min-width: 0;
  }

  .image-card-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0 0 12px;
  }

  .image-card-header svg {
    opacity: 0.5;
    flex-shrink: 0;
  }

  .image-container {
    position: relative;
    background: #0B1121;
    border-radius: var(--radius-md);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    max-width: 100%;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .image-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--color-neutral);
  }

  .image-empty.hidden {
    display: none;
  }

  .image-empty-text {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 13px;
    color: var(--color-neutral);
  }

  .heatmap-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: screen;
    background: radial-gradient(
      ellipse at 42% 52%,
      rgba(255, 50, 0, 0.65) 0%,
      rgba(255, 130, 0, 0.45) 18%,
      rgba(255, 220, 0, 0.3) 38%,
      transparent 58%
    );
  }

  .heatmap-overlay.hidden {
    display: none;
  }

  .heatmap-legend {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
  }

  .heatmap-legend.hidden {
    display: none;
  }

  .legend-label {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .legend-bar {
    width: 100px;
    height: 8px;
    border-radius: 4px;
    background: linear-gradient(90deg, transparent, #ffdc00, #ff8200, #ff3200);
  }

  .results-sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .prediction-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    background: var(--color-surface);
    border-left: 4px solid var(--color-danger);
  }

  .prediction-card[data-prediction="normal"] {
    border-left-color: var(--color-success);
  }

  .prediction-header {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0 0 16px;
  }

  .prediction-result {
    display: flex;
    align-items: center;
    gap: 12px;
  }

