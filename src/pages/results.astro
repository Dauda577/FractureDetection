---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Results" description="AI fracture analysis results with confidence score and heatmap localization" active="analyze" variant="app">
  <main class="results-page page-enter">
    <div class="dash-layout">
      <div class="dash-main">
        <div class="dash-content">

          <div class="top-bar">
            <div class="top-left">
              <h1 class="top-title">Analysis Results</h1>
              <p class="top-subtitle">AI-powered fracture detection outcome</p>
            </div>
            <div class="top-right">
              <a href="/analyze" class="top-btn-primary" id="btn-another">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                New Analysis
              </a>
              <button class="top-btn-secondary" id="btn-redo" title="Re-analyze same image">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" /></svg>
                Re-analyze
              </button>
              <button class="top-btn-secondary" id="btn-redo-other" title="Re-analyze for another patient">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><polyline points="17 11 19 13 23 9" /></svg>
                Another Patient
              </button>
            </div>
          </div>

          <div class="row row-1">
            <div class="card card-diag">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Diagnosis</span>
              </div>
              <div class="diag-result">
                <span class="diag-badge" id="diag-badge">No Result</span>
              </div>
              <div class="diag-meta" id="diag-meta">Run an analysis to see results</div>
              <div class="diag-cross-head hidden" id="cross-head-notice">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Segmentation model detected a possible fracture region despite classification of "Healthy" — clinical review recommended</span>
              </div>
            </div>

            <div class="card card-conf">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                <span>Confidence Score</span>
              </div>
              <div class="gauge-wrap">
                <svg class="gauge-svg" viewBox="0 0 120 120">
                  <circle class="gauge-bg" cx="60" cy="60" r="50" fill="none" stroke="var(--color-bg-subtle)" stroke-width="8" />
                  <circle class="gauge-fill" id="gauge-fill" cx="60" cy="60" r="50" fill="none" stroke="var(--color-primary)" stroke-width="8" stroke-linecap="round" stroke-dasharray="314.16" stroke-dashoffset="314.16" transform="rotate(-90 60 60)" />
                  <text class="gauge-text" id="gauge-text" x="60" y="60" text-anchor="middle" dominant-baseline="central" font-size="22" font-weight="700" fill="currentColor">—</text>
                </svg>
              </div>
              <div class="conf-label">Confidence</div>
            </div>

            <div class="card card-ood">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
                <span>Novel Image Score</span>
              </div>
              <div class="ood-value" id="ood-value">—</div>
              <div class="ood-label" id="ood-label">No data</div>
              <div class="ood-bar-wrap">
                <div class="ood-bar-fill" id="ood-bar-fill" style="width:0%"></div>
              </div>
            </div>



          </div>

          <div class="row row-2">
            <div class="pipeline-step">
              <div class="step-label">Original X-ray</div>
              <div class="step-img-wrap">
                <img id="img-original" class="step-img" alt="Original X-ray" />
                <div class="step-empty" id="empty-original">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                  <span>No image</span>
                </div>
              </div>
            </div>

            <div class="pipeline-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
            </div>

            <div class="pipeline-step">
              <div class="step-label">Location Of Fracture</div>
              <div class="step-img-wrap">
                <img id="img-heatmap" class="step-img" alt="Heatmap" />
                <div class="step-empty" id="empty-heatmap">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                  <span>No image</span>
                </div>
              </div>
            </div>
          </div>

          <div class="report-card card">
            <div class="card-header">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              <span>Download Report</span>
            </div>
            <p class="report-desc">Download a printable summary of this analysis, including the patient details, diagnosis, confidence score, and findings.</p>
            <button class="report-btn" id="report-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              Download Report
            </button>
          </div>

          <div class="batch-nav hidden" id="batch-nav">
            <div class="batch-nav-info">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" /></svg>
              <span id="batch-nav-text">1 of 3 analyzed</span>
            </div>
            <button class="btn-primary" id="btn-next-image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
              Next Image
            </button>
          </div>

        </div>
      </div>
    </div>

    <div class="zoom-overlay hidden" id="zoom-overlay">
      <div class="zoom-backdrop" id="zoom-backdrop"></div>
      <div class="zoom-card">
        <div class="zoom-toolbar">
          <div class="zoom-tabs" id="zoom-tabs">
            <button class="zoom-tab active" data-view="original">Original</button>
            <button class="zoom-tab" data-view="heatmap">Heatmap</button>
          </div>
          <div class="zoom-controls">
            <button class="zoom-btn" id="zoom-out" title="Zoom out">−</button>
            <button class="zoom-btn" id="zoom-reset" title="Reset zoom">1:1</button>
            <button class="zoom-btn" id="zoom-in" title="Zoom in">+</button>
            <button class="zoom-btn zoom-close-btn" id="zoom-close" title="Close">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </div>
        <div class="zoom-stage" id="zoom-stage">
          <img class="zoom-img" id="zoom-img" alt="Zoomed view" draggable="false" />
        </div>
      </div>
    </div>

  </main>
</Layout>

<script type="module">
  import { saveAnalysis } from '../scripts/api.js';
  import { getUser } from '../scripts/auth.js';

  var imageData = sessionStorage.getItem('fracturedetect:image');
  var resultData = sessionStorage.getItem('fracturedetect:result');

  (async function () {
    if (!resultData) {
      window.location.replace('/analyze');
      return;
    }

    var result = JSON.parse(resultData);
    var isFracture = result.prediction === 'Fractured';
    var confMatch = (result.confidence_display || '').match(/^([\d.]+)%/);
    var confNum = confMatch ? parseFloat(confMatch[1]) : 0;

    var origImg = document.getElementById('img-original');
    var heatImg = document.getElementById('img-heatmap');
    var emptyOrig = document.getElementById('empty-original');
    var emptyHeat = document.getElementById('empty-heatmap');

    if (imageData && origImg) {
      origImg.src = imageData;
      if (emptyOrig) emptyOrig.classList.add('hidden');
    }
    if (result.heatmap_png_base64 && heatImg) {
      heatImg.src = 'data:image/png;base64,' + result.heatmap_png_base64;
      if (emptyHeat) emptyHeat.classList.add('hidden');
    } else if (imageData && heatImg) {
      heatImg.src = imageData;
      if (emptyHeat) emptyHeat.classList.add('hidden');
    }

    /* Diagnosis */
    var diagBadge = document.getElementById('diag-badge');
    var diagMeta = document.getElementById('diag-meta');
    if (isFracture) {
      diagBadge.textContent = 'Fractured';
      diagBadge.style.color = 'var(--color-danger)';
      diagBadge.style.background = 'rgba(220,38,38,0.1)';
      diagMeta.textContent = 'Fracture detected';
    } else {
      diagBadge.textContent = 'Healthy';
      diagBadge.style.color = 'var(--color-success)';
      diagBadge.style.background = 'rgba(22,163,74,0.1)';
      diagMeta.textContent = 'No fracture detected';
    }

    var crossHeadNotice = document.getElementById('cross-head-notice');
    if (result.cross_head_disagreement === true) {
      crossHeadNotice.classList.remove('hidden');
    }

    /* Confidence gauge */
    var gaugeFill = document.getElementById('gauge-fill');
    var gaugeText = document.getElementById('gauge-text');
    var circumference = 314.16;
    var offset = circumference - (confNum / 100) * circumference;
    if (gaugeFill) {
      gaugeFill.style.strokeDashoffset = offset;
      gaugeFill.style.stroke = isFracture ? 'var(--color-danger)' : 'var(--color-success)';
    }
    if (gaugeText) gaugeText.textContent = confNum.toFixed(1) + '%';

    /* OOD score */
    var oodScore = result.ood_score != null ? result.ood_score : 0;
    var oodLabelText = oodScore > 26.883
      ? 'High — Expert review strongly recommended'
      : (oodScore > 19.358 ? 'Moderate — Consider expert review' : 'Low — Familiar case');
    var oodValue = document.getElementById('ood-value');
    var oodLabel = document.getElementById('ood-label');
    var oodFill = document.getElementById('ood-bar-fill');
    if (oodValue) oodValue.textContent = oodScore.toFixed(1);
    if (oodLabel) {
      oodLabel.textContent = oodLabelText;
      oodLabel.className = 'ood-label';
      if (oodScore > 26.883) oodLabel.classList.add('ood-high');
      else if (oodScore > 19.358) oodLabel.classList.add('ood-moderate');
    }
    if (oodFill) {
      oodFill.style.width = Math.min(Math.max(oodScore / 26.883 * 100, 0), 100) + '%';
      if (oodScore > 26.883) oodFill.style.background = 'var(--color-danger)';
      else if (oodScore > 19.358) oodFill.style.background = '#f59e0b';
      else oodFill.style.background = 'var(--color-success)';
    }

    /* Findings (used for report export + saved analysis) */
    var findingsText = [];
    findingsText.push('Prediction: ' + (isFracture ? 'Fracture detected' : 'No fracture detected'));
    findingsText.push('Confidence: ' + result.confidence_display);
    findingsText.push('OOD: ' + oodScore.toFixed(3) + ' (' + oodLabelText + ')');
    if (isFracture) {
      findingsText.push('Localized fracture region highlighted on heatmap');
    }

    /* Patient info (used for report export filename + patient line) */
    var patientId = sessionStorage.getItem('fracturedetect:patient_id');
    var currentPatientName = '';
    var currentPatientMrn = '';
    var currentPatientAge = '';
    var currentPatientGender = '';
    var currentPatientReason = '';
    var currentClinicianName = '';
    var currentClinicianEmail = '';
    if (patientId) {
      import('../scripts/patients.js').then(function (mod) {
        mod.getPatient(patientId).then(function (p) {
          if (p) {
            currentPatientName = p.name || '';
            currentPatientMrn = p.medical_record_id || '';
            currentPatientAge = p.age ? String(p.age) : '';
            currentPatientGender = p.gender ? p.gender.charAt(0).toUpperCase() + p.gender.slice(1) : '';
            currentPatientReason = p.notes || '';
          }
        });
      });
    }
    getUser().then(function (u) {
      if (u) {
        currentClinicianName = u.name || '';
        currentClinicianEmail = u.email || '';
      }
    });

    /* Buttons */
    var btnAnother = document.getElementById('btn-another');
    if (btnAnother) {
      btnAnother.addEventListener('click', function (e) {
        sessionStorage.setItem('fracturedetect:from_results', '1');
        sessionStorage.removeItem('fracturedetect:image');
        sessionStorage.removeItem('fracturedetect:result');
        sessionStorage.removeItem('fracturedetect:queue');
        window.location.href = '/analyze';
      });
    }

    var btnRedo = document.getElementById('btn-redo');
    if (btnRedo) {
      btnRedo.addEventListener('click', function () {
        sessionStorage.removeItem('fracturedetect:result');
        sessionStorage.removeItem('fracturedetect:queue');
        window.location.href = '/processing';
      });
    }

    var btnRedoOther = document.getElementById('btn-redo-other');
    if (btnRedoOther) {
      btnRedoOther.addEventListener('click', function () {
        sessionStorage.setItem('fracturedetect:from_results', '1');
        sessionStorage.removeItem('fracturedetect:result');
        sessionStorage.removeItem('fracturedetect:queue');
        sessionStorage.removeItem('fracturedetect:patient_id');
        window.location.href = '/analyze';
      });
    }

    /* Report download (PDF via jsPDF) */
    async function downloadReport() {
      var { jsPDF } = await import('jspdf');
      var doc = new jsPDF({ unit: 'mm', format: 'a4' });
      var PW = 210; var M = 14; var CW = PW - M * 2;
      var y = 0;
      var BLUE = [37, 99, 235]; var DK = [15, 23, 42]; var MG = [71, 85, 105];

      /* ── Blue header banner ── */
      doc.setFillColor.apply(doc, BLUE);
      doc.rect(0, 0, PW, 32, 'F');
      doc.setFont('helvetica', 'bold'); doc.setFontSize(20); doc.setTextColor(255, 255, 255);
      doc.text('FractureDetect', M, 14);
      doc.setFontSize(10); doc.setFont('helvetica', 'normal');
      doc.text('Analysis Report', M, 22);
      doc.setFontSize(8);
      doc.text('Generated: ' + new Date().toLocaleString(), M, 27.5);
      y = 40;

      /* ── Helper: draw section box ── */
      function drawSection(title, startY, boxH) {
        doc.setDrawColor(226, 232, 240); doc.setFillColor(255, 255, 255);
        doc.roundedRect(M, startY, CW, boxH, 3, 3, 'FD');
        doc.setFillColor.apply(doc, BLUE); doc.rect(M, startY, CW, 7, 'F');
        doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor(255, 255, 255);
        doc.text(title, M + 4, startY + 5);
        doc.setDrawColor(226, 232, 240);
        doc.line(M, startY + 7, PW - M, startY + 7);
        return startY + 12;
      }

      /* ── Patient section ── */
      var patientH = (currentPatientName || currentPatientMrn) ? 42 : 0;
      if (patientH) {
        var py = drawSection('PATIENT', y, patientH);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor.apply(doc, DK);
        doc.text('Name: ' + (currentPatientName || '\u2014'), M + 4, py + 1);
        doc.text('Age: ' + (currentPatientAge || '\u2014'), M + CW / 2, py + 1);
        doc.text('Gender: ' + (currentPatientGender || '\u2014'), M + 4, py + 10);
        doc.text('MRN: ' + (currentPatientMrn || '\u2014'), M + CW / 2, py + 10);
        doc.text('Reason: ' + (currentPatientReason || '\u2014'), M + 4, py + 19);
        y += patientH + 6;
      }

      /* ── Clinician section ── */
      var clinH = (currentClinicianName || currentClinicianEmail) ? 22 : 0;
      if (clinH) {
        var cy = drawSection('CLINICIAN', y, clinH);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor.apply(doc, DK);
        doc.text('Performed by: ' + (currentClinicianName || '') + (currentClinicianEmail ? ' (' + currentClinicianEmail + ')' : '') || '\u2014', M + 4, cy + 1);
        y += clinH + 6;
      }

      /* ── Cross-head disagreement warning ── */
      var crossDisagree = false;
      try { var stored = JSON.parse(sessionStorage.getItem('fracturedetect:result') || '{}'); crossDisagree = stored.cross_head_disagreement === true; } catch (e) {}
      if (crossDisagree) {
        doc.setFillColor(254, 242, 242); doc.setDrawColor(220, 38, 38);
        doc.roundedRect(M, y, CW, 18, 3, 3, 'FD');
        doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor(220, 38, 38);
        doc.text('Cross-Head Disagreement', M + 4, y + 7);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(7);
        doc.text('Segmentation detected a possible fracture despite classification of "Healthy" \u2014 clinical review recommended.', M + 4, y + 12.5);
        y += 24;
      }

      /* ── Findings section ── */
      var findH = 10 + findingsText.length * 6;
      var fy = drawSection('FINDINGS', y, findH);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor.apply(doc, DK);
      findingsText.forEach(function (t, i) {
        doc.text('\u2022  ' + t, M + 6, fy + 1 + i * 6);
      });
      y += findH + 6;

      /* ── Images section ── */
      var origImgEl = document.getElementById('img-original');
      if (origImgEl && origImgEl.src && origImgEl.complete && origImgEl.naturalWidth > 0) {
        var imgH = 62; var imgW = imgH * (origImgEl.naturalWidth / origImgEl.naturalHeight);
        if (imgW > CW * 0.46) { imgW = CW * 0.46; imgH = imgW * (origImgEl.naturalHeight / origImgEl.naturalWidth); }
        var imgSectionH = imgH + 24;
        if (y + imgSectionH > 270) { doc.addPage(); y = 20; }
        var iy = drawSection('ATTACHMENTS', y, imgSectionH);

        doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.setTextColor.apply(doc, MG);
        doc.text('Original', M + 6, iy + imgH + 9, { align: 'center', maxWidth: imgW });
        doc.addImage(origImgEl, 'JPEG', M + 6, iy + 2, imgW, imgH);
        doc.setDrawColor(226, 232, 240); doc.rect(M + 6, iy + 2, imgW, imgH);

        var hx = M + 8 + imgW + 6;
        doc.text('Heatmap', hx, iy + imgH + 9, { align: 'center', maxWidth: imgW });
        var heatImgEl = document.getElementById('img-heatmap');
        if (heatImgEl && heatImgEl.src && heatImgEl.src.startsWith('data:image/png;base64,')) {
          var heatOc = document.createElement('canvas');
          heatOc.width = 800; heatOc.height = 600;
          var hoctx = heatOc.getContext('2d');
          hoctx.drawImage(heatImgEl, 0, 0, 800, 600);
          doc.addImage(heatOc.toDataURL('image/png'), 'PNG', hx, iy + 2, imgW, imgH);
          doc.rect(hx, iy + 2, imgW, imgH);
        }
        y += imgSectionH + 6;
      }

      /* ── Footer bar ── */
      doc.setFillColor(248, 250, 252); doc.setDrawColor(226, 232, 240);
      doc.roundedRect(M, y, CW, 16, 3, 3, 'FD');
      doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.setTextColor.apply(doc, MG);
      doc.text('fracture-detection.vercel.app', M + 4, y + 6);
      doc.text('Confidential \u2014 For clinical decision support only', M + 4, y + 11);
      doc.text('Page 1', PW - M - 4, y + 6, { align: 'right' });

      /* ── Filename ── */
      var fnParts = [];
      if (currentPatientName) fnParts.push(currentPatientName);
      if (currentPatientMrn) fnParts.push(currentPatientMrn);
      fnParts.push('fracture-detection-report');
      var fileName = fnParts.join('-').replace(/[^a-z0-9\-_]/gi, '').toLowerCase() + '.pdf';

      doc.save(fileName);
    }

    var reportBtn = document.getElementById('report-btn');
    if (reportBtn) reportBtn.addEventListener('click', downloadReport);

    var findingsItems = findingsText;

    saveAnalysis(
      imageData,
      isFracture ? 'fracture' : 'normal',
      confNum / 100,
      result.inference_time_sec || 0,
      findingsItems,
      patientId,
      result.heatmap_png_base64 || null
    );

    /* ── Batch queue navigation ── */
    var queueData = sessionStorage.getItem('fracturedetect:queue');
    var remainingCount = parseInt(sessionStorage.getItem('fracturedetect:remaining')) || 0;
    var batchNav = document.getElementById('batch-nav');
    var batchNavText = document.getElementById('batch-nav-text');
    var btnNextImage = document.getElementById('btn-next-image');

    if (batchNav && batchNavText) {
      var hasQueue = queueData;
      var totalRemaining = hasQueue ? JSON.parse(queueData).length : remainingCount;
      if (totalRemaining > 0) {
        batchNavText.textContent = hasQueue ? '1 of ' + (totalRemaining + 1) + ' analyzed — ' + totalRemaining + ' remaining' : totalRemaining + ' image(s) remaining';
        batchNav.classList.remove('hidden');
      }

      if (btnNextImage) {
        btnNextImage.addEventListener('click', function () {
          if (hasQueue) {
            var queue = JSON.parse(queueData);
            var next = queue.shift();
            if (next && next.data) {
              try {
                sessionStorage.setItem('fracturedetect:image', next.data);
                if (queue.length > 0) {
                  sessionStorage.setItem('fracturedetect:queue', JSON.stringify(queue));
                  sessionStorage.setItem('fracturedetect:remaining', queue.length);
                } else {
                  sessionStorage.removeItem('fracturedetect:queue');
                  sessionStorage.removeItem('fracturedetect:remaining');
                }
                sessionStorage.removeItem('fracturedetect:result');
                window.location.href = '/processing';
              } catch (err) {
                console.warn('Failed to navigate to next image:', err);
              }
            }
          } else {
            sessionStorage.removeItem('fracturedetect:result');
            window.location.href = '/analyze';
          }
        });
      }
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'n' || e.key === 'N') {
        if (!e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          if (batchNav && !batchNav.classList.contains('hidden')) {
            btnNextImage?.click();
          } else {
            btnAnother?.click();
          }
        }
      }
    });

    /* ── Centered image zoom modal ── */
    var zoomOverlay = document.getElementById('zoom-overlay');
    var zoomStage = document.getElementById('zoom-stage');
    var zoomImg = document.getElementById('zoom-img');
    var zoomTabs = document.getElementById('zoom-tabs');
    var zoomBackdrop = document.getElementById('zoom-backdrop');
    var btnZoomIn = document.getElementById('zoom-in');
    var btnZoomOut = document.getElementById('zoom-out');
    var btnZoomReset = document.getElementById('zoom-reset');
    var btnZoomClose = document.getElementById('zoom-close');

    var zs = { scale: 1, x: 0, y: 0, view: 'original' };
    var zdrag = false, zdsX = 0, zdsY = 0, zimgX = 0, zimgY = 0;
    var ztouchDist0 = 0, ztouchScale0 = 1;

    function zApply() {
      zoomImg.style.transform = 'translate(' + zs.x + 'px,' + zs.y + 'px) scale(' + zs.scale + ')';
    }

    function zClamp() {
      zs.scale = Math.max(0.5, Math.min(5, zs.scale));
      var maxP = Math.max(0, (zs.scale - 1) * zoomStage.clientWidth / 2);
      zs.x = Math.max(-maxP, Math.min(maxP, zs.x));
      zs.y = Math.max(-maxP, Math.min(maxP, zs.y));
      zApply();
    }

    function zOpen(view) {
      zs.view = view; zs.scale = 1; zs.x = 0; zs.y = 0;
      zoomImg.src = view === 'original' ? origImg.src : heatImg.src;
      zoomImg.style.objectFit = view === 'original' ? 'contain' : 'cover';
      zApply();
      zoomOverlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      var tabs = zoomTabs.querySelectorAll('.zoom-tab');
      tabs.forEach(function (t) { t.classList.toggle('active', t.getAttribute('data-view') === view); });
      var hasHeat = heatImg.src && heatImg.src !== origImg.src;
      zoomTabs.classList.toggle('hidden', !hasHeat);
    }

    function zClose() {
      zoomOverlay.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function zZoomIn(a) { zs.scale *= (a || 1.3); zClamp(); }
    function zZoomOut(a) { zs.scale /= (a || 1.3); zClamp(); }
    function zReset() { zs.scale = 1; zs.x = 0; zs.y = 0; zApply(); }

    document.querySelectorAll('.step-img-wrap').forEach(function (w, i) {
      w.addEventListener('click', function () { zOpen(i === 0 ? 'original' : 'heatmap'); });
    });

    zoomTabs.addEventListener('click', function (e) {
      var tab = e.target.closest('.zoom-tab');
      if (!tab) return;
      zOpen(tab.getAttribute('data-view'));
    });

    zoomBackdrop.addEventListener('click', zClose);
    btnZoomClose.addEventListener('click', zClose);
    btnZoomIn.addEventListener('click', function () { zZoomIn(); });
    btnZoomOut.addEventListener('click', function () { zZoomOut(); });
    btnZoomReset.addEventListener('click', zReset);

    zoomStage.addEventListener('wheel', function (e) {
      e.preventDefault();
      var d = e.deltaY > 0 ? 0.875 : 1.1428;
      var rect = zoomStage.getBoundingClientRect();
      var mx = e.clientX - rect.left - rect.width / 2;
      var my = e.clientY - rect.top - rect.height / 2;
      var ns = zs.scale * d;
      ns = Math.max(0.5, Math.min(5, ns));
      var r = ns / zs.scale;
      zs.x = zs.x * r + mx * (1 - r);
      zs.y = zs.y * r + my * (1 - r);
      zs.scale = ns;
      zClamp();
    });

    zoomStage.addEventListener('mousedown', function (e) {
      if (e.button !== 0) return;
      zdrag = true;
      zdsX = e.clientX; zdsY = e.clientY;
      zimgX = zs.x; zimgY = zs.y;
      zoomStage.style.cursor = 'grabbing';
      e.preventDefault();
    });

    window.addEventListener('mousemove', function (e) {
      if (!zdrag) return;
      zs.x = zimgX + (e.clientX - zdsX);
      zs.y = zimgY + (e.clientY - zdsY);
      zClamp();
    });

    window.addEventListener('mouseup', function () {
      if (!zdrag) return;
      zdrag = false;
      zoomStage.style.cursor = zs.scale > 1.02 ? 'grab' : 'default';
    });

    zoomStage.addEventListener('touchstart', function (e) {
      if (e.touches.length === 2) {
        zdrag = false;
        ztouchDist0 = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        ztouchScale0 = zs.scale;
      } else if (e.touches.length === 1) {
        zdrag = true;
        zdsX = e.touches[0].clientX; zdsY = e.touches[0].clientY;
        zimgX = zs.x; zimgY = zs.y;
      }
    }, { passive: false });

    zoomStage.addEventListener('touchmove', function (e) {
      if (e.touches.length === 2) {
        e.preventDefault();
        var dist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        zs.scale = Math.max(0.5, Math.min(5, ztouchScale0 * (dist / ztouchDist0)));
        zClamp();
      } else if (zdrag && e.touches.length === 1) {
        zs.x = zimgX + (e.touches[0].clientX - zdsX);
        zs.y = zimgY + (e.touches[0].clientY - zdsY);
        zClamp();
      }
    }, { passive: false });

    zoomStage.addEventListener('touchend', function () { zdrag = false; });

    document.addEventListener('keydown', function (e) {
      if (zoomOverlay.classList.contains('hidden')) return;
      if (e.key === 'Escape') { zClose(); }
      if (e.key === '+' || e.key === '=') { zZoomIn(); }
      if (e.key === '-') { zZoomOut(); }
      if (e.key === '0') { zReset(); }
    });

    zoomImg.addEventListener('dblclick', function () {
      if (zs.scale >= 2) { zReset(); } else { zs.scale = 2; zClamp(); }
    });

  })();
</script>

