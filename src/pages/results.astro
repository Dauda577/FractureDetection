---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Results" description="AI fracture analysis results with confidence score and heatmap localization" active="analyze" variant="app">
  <main class="results-page page-enter">
    <div class="dash-layout">
      <div class="dash-main">
        <div class="dash-content">

          <div class="top-bar">
            <div class="top-left">
              <h1 class="top-title">Analysis Results</h1>
              <p class="top-subtitle">AI-powered fracture detection outcome</p>
            </div>
            <div class="top-right">
              <a href="/analyze" class="top-btn-primary" id="btn-another">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                New Analysis
              </a>
              <button class="top-icon-btn" id="btn-download" title="Export Report">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              </button>
            </div>
          </div>

          <div class="row row-1">
            <div class="card card-diag">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Diagnosis</span>
              </div>
              <div class="diag-result">
                <span class="diag-badge" id="diag-badge">No Result</span>
              </div>
              <div class="diag-meta" id="diag-meta">Run an analysis to see results</div>
            </div>

            <div class="card card-conf">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                <span>Confidence Score</span>
              </div>
              <div class="gauge-wrap">
                <svg class="gauge-svg" viewBox="0 0 120 120">
                  <circle class="gauge-bg" cx="60" cy="60" r="50" fill="none" stroke="var(--color-bg-subtle)" stroke-width="8" />
                  <circle class="gauge-fill" id="gauge-fill" cx="60" cy="60" r="50" fill="none" stroke="var(--color-primary)" stroke-width="8" stroke-linecap="round" stroke-dasharray="314.16" stroke-dashoffset="314.16" transform="rotate(-90 60 60)" />
                  <text class="gauge-text" id="gauge-text" x="60" y="60" text-anchor="middle" dominant-baseline="central" font-size="22" font-weight="700" fill="currentColor">—</text>
                </svg>
              </div>
              <div class="conf-label">Confidence</div>
            </div>

            <div class="card card-ood">
              <div class="card-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
                <span>Novelty / OOD Score</span>
              </div>
              <div class="ood-value" id="ood-value">—</div>
              <div class="ood-label" id="ood-label">No data</div>
              <div class="ood-bar-wrap">
                <div class="ood-bar-fill" id="ood-bar-fill" style="width:0%"></div>
              </div>
            </div>

          </div>

          <div class="row row-2">
            <div class="pipeline-step">
              <div class="step-label">Original X-ray</div>
              <div class="step-img-wrap">
                <img id="img-original" class="step-img" alt="Original X-ray" />
                <div class="step-empty" id="empty-original">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                  <span>No image</span>
                </div>
              </div>
            </div>

            <div class="pipeline-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
            </div>

            <div class="pipeline-step">
              <div class="step-label">Predicted Heatmap</div>
              <div class="step-img-wrap">
                <img id="img-heatmap" class="step-img" alt="Heatmap" />
                <div class="step-empty" id="empty-heatmap">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                  <span>No image</span>
                </div>
              </div>
            </div>
          </div>

          <div class="report-card card">
            <div class="card-header">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              <span>Export Report</span>
            </div>
            <p class="report-desc">Download a printable summary of this analysis, including the patient details, diagnosis, confidence score, and findings.</p>
            <button class="report-btn" id="report-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              Download Report
            </button>
          </div>

          <div class="batch-nav hidden" id="batch-nav">
            <div class="batch-nav-info">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" /></svg>
              <span id="batch-nav-text">1 of 3 analyzed</span>
            </div>
            <button class="btn-primary" id="btn-next-image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
              Next Image
            </button>
          </div>

        </div>
      </div>
    </div>
  </main>
</Layout>

<script type="module">
  import { saveAnalysis } from '../scripts/api.js';

  var imageData = sessionStorage.getItem('fracturedetect:image');
  var resultData = sessionStorage.getItem('fracturedetect:result');

  (async function () {
    if (!resultData) {
      window.location.replace('/analyze');
      return;
    }

    var result = JSON.parse(resultData);
    var isFracture = result.prediction === 'fracture';
    var confNum = parseFloat((result.confidence * 100).toFixed(1));

    var origImg = document.getElementById('img-original');
    var heatImg = document.getElementById('img-heatmap');
    var emptyOrig = document.getElementById('empty-original');
    var emptyHeat = document.getElementById('empty-heatmap');

    if (imageData && origImg && heatImg) {
      origImg.src = imageData;
      heatImg.src = imageData;
      if (emptyOrig) emptyOrig.classList.add('hidden');
      if (emptyHeat) emptyHeat.classList.add('hidden');
    }

    /* Diagnosis */
    var diagBadge = document.getElementById('diag-badge');
    var diagMeta = document.getElementById('diag-meta');
    if (isFracture) {
      diagBadge.textContent = 'Fracture Detected';
      diagBadge.style.color = 'var(--color-danger)';
      diagBadge.style.background = 'rgba(220,38,38,0.1)';
      diagMeta.textContent = 'High confidence positive finding';
    } else {
      diagBadge.textContent = 'Normal';
      diagBadge.style.color = 'var(--color-success)';
      diagBadge.style.background = 'rgba(22,163,74,0.1)';
      diagMeta.textContent = 'No fracture detected';
    }

    /* Confidence gauge */
    var gaugeFill = document.getElementById('gauge-fill');
    var gaugeText = document.getElementById('gauge-text');
    var circumference = 314.16;
    var offset = circumference - (confNum / 100) * circumference;
    if (gaugeFill) {
      gaugeFill.style.strokeDashoffset = offset;
      gaugeFill.style.stroke = isFracture ? 'var(--color-danger)' : 'var(--color-success)';
    }
    if (gaugeText) gaugeText.textContent = confNum + '%';

    /* OOD score */
    var oodScore = 18.4;
    var oodValue = document.getElementById('ood-value');
    var oodLabel = document.getElementById('ood-label');
    var oodFill = document.getElementById('ood-bar-fill');
    if (oodValue) oodValue.textContent = oodScore.toFixed(1);
    if (oodLabel) oodLabel.textContent = oodScore < 25 ? 'Low — in-distribution' : oodScore < 50 ? 'Moderate' : 'High — out-of-distribution';
    if (oodFill) oodFill.style.width = Math.min(oodScore, 100) + '%';

    /* Findings (used for report export + saved analysis) */
    var findingsText = isFracture
      ? ['Bone discontinuity detected in the forearm region', 'Fracture localized to the mid-shaft of the radius', 'No signs of comminution or displacement detected']
      : ['No visible bone discontinuity detected', 'Bone alignment appears normal', 'No suspicious abnormalities identified'];

    /* Patient info (used for report export filename + patient line) */
    var patientId = sessionStorage.getItem('fracturedetect:patient_id');
    var currentPatientName = '';
    var currentPatientMrn = '';
    if (patientId) {
      import('../scripts/patients.js').then(function (mod) {
        mod.getPatient(patientId).then(function (p) {
          if (p) {
            currentPatientName = p.name || '';
            currentPatientMrn = p.medical_record_id || '';
          }
        });
      });
    }

    /* Buttons */
    var btnAnother = document.getElementById('btn-another');
    if (btnAnother) {
      btnAnother.addEventListener('click', function (e) {
        sessionStorage.removeItem('fracturedetect:image');
        sessionStorage.removeItem('fracturedetect:result');
        sessionStorage.removeItem('fracturedetect:queue');
        window.location.href = '/analyze';
      });
    }

    /* Report download (PDF via jsPDF) */
    async function downloadReport() {
      var { jsPDF } = await import('jspdf');
      var doc = new jsPDF({ unit: 'mm', format: 'a4' });
      var pageW = 210;
      var margin = 20;
      var y = 20;
      var lineH = 5;

      /* ── Header ── */
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(22);
      doc.setTextColor(15, 23, 42);
      doc.text('FractureDetect Analysis Report', margin, y); y += 10;

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);
      doc.setTextColor(71, 85, 105);
      doc.text('Generated: ' + new Date().toLocaleString(), margin, y); y += 9;

      /* ── Patient line ── */
      if (currentPatientName || currentPatientMrn) {
        doc.text('Patient: ' + (currentPatientName || '\u2014') + (currentPatientMrn ? '  (' + currentPatientMrn + ')' : ''), margin, y); y += 8;
        doc.setDrawColor(226, 232, 240);
        doc.line(margin, y, pageW - margin, y); y += 10;
      } else {
        doc.setDrawColor(226, 232, 240);
        doc.line(margin, y, pageW - margin, y); y += 10;
      }

      /* ── Prediction ── */
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(14);
      doc.setTextColor(15, 23, 42);
      doc.text('Prediction: ' + diagBadge.textContent, margin, y); y += 11;

      doc.setFontSize(32);
      doc.setTextColor(isFracture ? 220 : 22, isFracture ? 38 : 163, isFracture ? 38 : 74);
      doc.text(confNum + '%', margin, y); y += 12;

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);
      doc.setTextColor(71, 85, 105);
      doc.text('Confidence Score', margin, y); y += 10;

      /* ── Novelty / OOD Score ── */
      doc.setFontSize(13);
      doc.setTextColor(15, 23, 42);
      doc.text('Novelty / OOD Score: ' + oodScore.toFixed(1), margin, y); y += lineH + 2;
      doc.setFontSize(10);
      doc.setTextColor(oodScore < 25 ? 22 : oodScore < 50 ? 202 : 220, oodScore < 25 ? 163 : oodScore < 50 ? 138 : 38, oodScore < 25 ? 74 : oodScore < 50 ? 30 : 38);
      doc.text(oodScore < 25 ? 'Low \u2014 in-distribution' : oodScore < 50 ? 'Moderate' : 'High \u2014 out-of-distribution', margin, y); y += 11;

      /* ── Findings ── */
      doc.setDrawColor(226, 232, 240);
      doc.line(margin, y, pageW - margin, y); y += 9;
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(13);
      doc.setTextColor(15, 23, 42);
      doc.text('Findings Summary', margin, y); y += 8;

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);
      doc.setTextColor(51, 65, 85);
      findingsText.forEach(function (t) {
        doc.text('\u2022  ' + t, margin, y); y += 7;
      });

      y += 5;

      /* ── X-ray Image ── */
      doc.setDrawColor(226, 232, 240);
      doc.line(margin, y, pageW - margin, y); y += 9;
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(13);
      doc.setTextColor(15, 23, 42);
      doc.text('X-ray Image', margin, y); y += 7;

      var origImgEl = document.getElementById('img-original');
      if (origImgEl && origImgEl.src && origImgEl.complete && origImgEl.naturalWidth > 0) {
        var imgW = 130, imgH = 97.5;
        var imgX = (pageW - imgW) / 2;
        if (y + imgH > 270) { doc.addPage(); y = 20; }
        doc.addImage(origImgEl, 'JPEG', imgX, y, imgW, imgH);

        if (isFracture) {
          var oc = document.createElement('canvas');
          oc.width = 800; oc.height = 600;
          var octx = oc.getContext('2d');
          octx.drawImage(origImgEl, 0, 0, 800, 600);
          var gradient = octx.createRadialGradient(336, 312, 0, 336, 312, 400);
          gradient.addColorStop(0, 'rgba(255, 50, 0, 0.5)');
          gradient.addColorStop(0.18, 'rgba(255, 130, 0, 0.35)');
          gradient.addColorStop(0.38, 'rgba(255, 220, 0, 0.2)');
          gradient.addColorStop(1, 'transparent');
          octx.fillStyle = gradient; octx.fillRect(0, 0, 800, 600);
          var heatData = oc.toDataURL('image/png');
          doc.addImage(heatData, 'PNG', imgX, y, imgW, imgH);
        }

        y += imgH + 8;
      }

      /* ── Disclaimer ── */
      doc.setDrawColor(226, 232, 240);
      doc.line(margin, y, pageW - margin, y); y += 8;
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(9);
      doc.setTextColor(71, 85, 105);
      doc.text('This result is intended to assist healthcare professionals and should not replace', margin, y); y += 5;
      doc.text('professional medical diagnosis.', margin, y);

      /* ── Filename ── */
      var fileNameParts = [];
      if (currentPatientName) fileNameParts.push(currentPatientName);
      if (currentPatientMrn) fileNameParts.push(currentPatientMrn);
      fileNameParts.push('fracture-detection-report');
      var fileName = fileNameParts.join('-').replace(/[^a-z0-9\-_]/gi, '').toLowerCase() + '.pdf';

      doc.save(fileName);
    }

    var downloadBtn = document.getElementById('btn-download');
    if (downloadBtn) downloadBtn.addEventListener('click', downloadReport);
    var reportBtn = document.getElementById('report-btn');
    if (reportBtn) reportBtn.addEventListener('click', downloadReport);

    var findingsItems = findingsText;

    saveAnalysis(
      imageData,
      result.prediction,
      result.confidence,
      result.inferenceTimeSec,
      findingsItems,
      patientId
    );

    /* ── Batch queue navigation ── */
    var queueData = sessionStorage.getItem('fracturedetect:queue');
    var remainingCount = parseInt(sessionStorage.getItem('fracturedetect:remaining')) || 0;
    var batchNav = document.getElementById('batch-nav');
    var batchNavText = document.getElementById('batch-nav-text');
    var btnNextImage = document.getElementById('btn-next-image');

    if (batchNav && batchNavText) {
      var hasQueue = queueData;
      var totalRemaining = hasQueue ? JSON.parse(queueData).length : remainingCount;
      if (totalRemaining > 0) {
        batchNavText.textContent = hasQueue ? '1 of ' + (totalRemaining + 1) + ' analyzed — ' + totalRemaining + ' remaining' : totalRemaining + ' image(s) remaining';
        batchNav.classList.remove('hidden');
      }

      if (btnNextImage) {
        btnNextImage.addEventListener('click', function () {
          if (hasQueue) {
            var queue = JSON.parse(queueData);
            var next = queue.shift();
            if (next && next.data) {
              try {
                sessionStorage.setItem('fracturedetect:image', next.data);
                if (queue.length > 0) {
                  sessionStorage.setItem('fracturedetect:queue', JSON.stringify(queue));
                  sessionStorage.setItem('fracturedetect:remaining', queue.length);
                } else {
                  sessionStorage.removeItem('fracturedetect:queue');
                  sessionStorage.removeItem('fracturedetect:remaining');
                }
                sessionStorage.removeItem('fracturedetect:result');
                window.location.href = '/processing';
              } catch (err) {
                console.warn('Failed to navigate to next image:', err);
              }
            }
          } else {
            sessionStorage.removeItem('fracturedetect:result');
            window.location.href = '/analyze';
          }
        });
      }
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'e' || e.key === 'E') {
        if (!e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          downloadBtn?.click();
        }
      }
      if (e.key === 'n' || e.key === 'N') {
        if (!e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          if (batchNav && !batchNav.classList.contains('hidden')) {
            btnNextImage?.click();
          } else {
            btnAnother?.click();
          }
        }
      }
    });
  })();
</script>

<style>
  .hidden { display: none !important; }

  .results-page {
    position: relative;
    background: var(--color-bg-subtle);
    min-height: calc(100vh - 68px);
    padding: 0;
  }

  .dash-layout { display: flex; max-width: 100%; min-height: calc(100vh - 68px); }
  .dash-main { flex: 1; min-width: 0; background: var(--color-bg-subtle); }
  .dash-content { max-width: 960px; padding: 20px 24px 24px; margin: 0 auto; }

  .top-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; gap: 12px; }
  .top-left { display: flex; flex-direction: column; gap: 2px; }
  .top-title { font-family: var(--font-heading); font-weight: 600; font-size: 20px; color: var(--color-text); margin: 0; letter-spacing: -0.02em; }
  .top-subtitle { font-family: var(--font-body); font-size: 13px; color: var(--color-text-muted); margin: 0; }
  .top-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .top-btn-primary {
    display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
    font-family: var(--font-body); font-weight: 600; font-size: 12px; color: white;
    background: linear-gradient(135deg, var(--color-primary), #1d4ed8);
    padding: 7px 14px; border: none; border-radius: var(--radius-md);
    cursor: pointer; transition: all 0.2s ease; white-space: nowrap;
    box-shadow: 0 4px 12px rgba(37,99,235,0.25);
  }
  .top-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,0.35); }
  .top-icon-btn {
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--color-surface); border: 1px solid var(--color-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--color-text-muted); cursor: pointer; transition: all 0.15s;
  }
  .top-icon-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

  .row-1 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }
  .card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 14px 16px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.03);
  }
  .card-header {
    display: flex; align-items: center; gap: 6px;
    font-family: var(--font-body); font-weight: 600; font-size: 10px;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-text-muted); margin-bottom: 8px;
  }
  .card-header svg { opacity: 0.5; flex-shrink: 0; }

  .diag-result { margin-bottom: 6px; }
  .diag-badge { display: inline-block; font-family: var(--font-heading); font-weight: 600; font-size: 13px; padding: 4px 10px; border-radius: var(--radius-md); background: var(--color-bg-subtle); color: var(--color-text-muted); }
  .diag-meta { font-family: var(--font-body); font-size: 11px; color: var(--color-text-muted); line-height: 1.4; }

  .gauge-wrap { text-align: center; padding: 0; }
  .gauge-svg { width: 56px; height: 56px; display: block; margin: 0 auto; }
  .gauge-fill { transition: stroke-dashoffset 0.6s ease; }
  .conf-label { text-align: center; font-family: var(--font-body); font-size: 10px; color: var(--color-text-muted); margin-top: 2px; }

  .ood-value { font-family: var(--font-heading); font-weight: 700; font-size: 22px; color: var(--color-text); margin-bottom: 2px; }
  .ood-label { font-family: var(--font-body); font-size: 11px; color: var(--color-success); margin-bottom: 8px; }
  .ood-bar-wrap { height: 4px; background: var(--color-bg-subtle); border-radius: 3px; overflow: hidden; }
  .ood-bar-fill { height: 100%; background: var(--color-success); border-radius: 3px; transition: width 0.5s ease; }

  .row-2 { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; }
  .pipeline-step { flex: 1; min-width: 0; display: flex; flex-direction: column; height: 100%; }
  .pipeline-arrow { flex-shrink: 0; color: var(--color-neutral); opacity: 0.4; }
  .step-label {
    font-family: var(--font-body); font-weight: 600; font-size: 10px;
    text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted);
    margin-bottom: 6px; text-align: center;
  }
  .step-img-wrap {
    position: relative; background: #0B1121; border-radius: var(--radius-md);
    aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--color-border);
    flex: 1;
  }
  .step-img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .step-empty {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 6px;
    color: var(--color-neutral); font-family: var(--font-body); font-size: 11px;
  }

