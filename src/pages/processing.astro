---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Processing" description="Analyzing X-ray image with AI fracture detection model" active="analyze" variant="app">
  <main class="processing-page page-enter">
    <div class="proc-bg">
      <div class="proc-orb orb-1 fd-orb-drift" style="--float-duration:20s"></div>
      <div class="proc-orb orb-2 fd-orb-drift" style="--float-duration:16s;--float-delay:-5s"></div>
    </div>
    <div class="processing-container">
      <div class="proc-badge">
        <span class="badge-dot"></span>
        Analyzing
      </div>

      <div class="scanner-wrap">
        <div class="scanner-viewbox" id="scanner-viewbox">
          <svg class="scanner-bone" viewBox="0 0 200 260" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M100 30 C80 30 55 45 40 70 C25 95 20 120 25 140 C30 160 40 175 55 185 C70 195 85 200 100 200 C115 200 130 195 145 185 C160 175 170 160 175 140 C180 120 175 95 160 70 C145 45 120 30 100 30Z" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.12)" stroke-width="1.5"/>
            <path d="M100 60 C88 60 78 68 72 82 C66 96 64 112 66 125 C68 138 74 148 82 154 C90 160 95 162 100 162 C105 162 110 160 118 154 C126 148 132 138 134 125 C136 112 134 96 128 82 C122 68 112 60 100 60Z" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
            <line x1="50" y1="100" x2="70" y2="100" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
            <line x1="130" y1="100" x2="150" y2="100" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
            <line x1="45" y1="130" x2="65" y2="130" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
            <line x1="135" y1="130" x2="155" y2="130" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
          </svg>
          <div class="scan-line" id="scan-line"></div>
          <div class="scan-ring scan-ring-1"></div>
          <div class="scan-ring scan-ring-2"></div>
          <div class="scan-ring scan-ring-3"></div>
          <div class="corner-bracket corner-tl"></div>
          <div class="corner-bracket corner-tr"></div>
          <div class="corner-bracket corner-bl"></div>
          <div class="corner-bracket corner-br"></div>
        </div>
        <div class="scan-status" id="scan-status">
          <span class="scan-dot"></span>
          <span>Initializing scan&hellip;</span>
        </div>
      </div>

      <div aria-live="polite">
        <h2 class="processing-title">Analyzing X-ray, please wait&hellip;</h2>
      </div>
      <p class="processing-subtext">
        Our AI model is processing the image. This may take a few seconds.
      </p>

      <div class="steps-track">
        <div class="step active" id="step-1">
          <div class="step-circle">1</div>
          <span class="step-label">Loading</span>
        </div>
        <div class="step-connector active"></div>
        <div class="step" id="step-2">
          <div class="step-circle">2</div>
          <span class="step-label">Analyzing</span>
        </div>
        <div class="step-connector"></div>
        <div class="step" id="step-3">
          <div class="step-circle">3</div>
          <span class="step-label">Results</span>
        </div>
      </div>

      <div class="progress-area">
        <div
          class="progress-track"
          id="progress-track"
          role="progressbar"
          aria-valuenow="0"
          aria-valuemin="0"
          aria-valuemax="100"
        >
          <div class="progress-fill" id="progress-fill"></div>
        </div>
        <span class="progress-label" id="progress-label">0%</span>
      </div>

      <div class="proc-details">
        <div class="proc-detail-item">
          <div class="proc-detail-dot"></div>
          <span>Preprocessing image&hellip;</span>
        </div>
        <div class="proc-detail-item" id="detail-model">
          <div class="proc-detail-dot"></div>
          <span>Running detection model&hellip;</span>
        </div>
        <div class="proc-detail-item" id="detail-heatmap">
          <div class="proc-detail-dot"></div>
          <span>Generating heatmap&hellip;</span>
        </div>
      </div>

      <div class="info-banner">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
        <span>Please do not refresh or close this page.</span>
      </div>
    </div>
  </main>
</Layout>

<script>
  (function () {
    var imageData = sessionStorage.getItem('fracturedetect:image');
    if (!imageData) {
      window.location.replace('/analyze');
      return;
    }

    function simulateProgress(callback) {
      var DURATION = 3500;
      var TARGET = 98;
      var fillEl = document.getElementById('progress-fill');
      var labelEl = document.getElementById('progress-label');
      var barEl = document.getElementById('progress-track');
      var scanLine = document.getElementById('scan-line');
      var scanStatus = document.getElementById('scan-status');
      var startTime = performance.now();

      var step2El = document.getElementById('step-2');
      var step3El = document.getElementById('step-3');
      var detailModel = document.getElementById('detail-model');
      var detailHeatmap = document.getElementById('detail-heatmap');

      var phases = [
        { at: 0, text: 'Preprocessing image&hellip;', dot: true },
        { at: 15, text: 'Running detection model&hellip;', dot: true },
        { at: 35, text: 'Analyzing bone structures&hellip;', dot: true },
        { at: 55, text: 'Generating heatmap&hellip;', dot: true },
        { at: 75, text: 'Calculating confidence score&hellip;', dot: true },
        { at: 90, text: 'Finalizing results&hellip;', dot: false }
      ];
      var currentPhase = -1;
      var lastValue = -1;

      function easeOut(t) {
        return 1 - Math.pow(1 - t, 3);
      }

      function frame(now) {
        var elapsed = now - startTime;
        var t = Math.min(elapsed / DURATION, 1);
        var value = Math.round(easeOut(t) * TARGET);

        if (value !== lastValue) {
          lastValue = value;
          if (fillEl && labelEl && barEl) {
            fillEl.style.width = value + '%';
            labelEl.textContent = value + '%';
            barEl.setAttribute('aria-valuenow', value);
          }
        }

        if (scanLine) {
          var scanT = (Math.sin(elapsed / 1200) + 1) / 2;
          scanLine.style.transform = 'translateY(' + (scanT * 100) + '%)';
        }

        for (var p = phases.length - 1; p >= 0; p--) {
          if (value >= phases[p].at && p > currentPhase) {
            currentPhase = p;
            if (scanStatus) {
              scanStatus.innerHTML = '<span class="scan-dot' + (phases[p].dot ? ' dot-active' : '') + '"></span><span>' + phases[p].text + '</span>';
            }
            break;
          }
        }

        if (value >= 15 && step2El && !step2El.classList.contains('active')) {
          step2El.classList.add('active');
          if (detailModel) detailModel.classList.add('active');
        }
        if (value >= 45 && step3El && !step3El.classList.contains('active')) {
          step3El.classList.add('active');
          if (detailHeatmap) detailHeatmap.classList.add('active');
        }

        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          if (scanStatus) {
            scanStatus.innerHTML = '<span class="scan-dot dot-done"></span><span>Scan complete</span>';
          }
          setTimeout(callback, 400);
        }
      }

      requestAnimationFrame(frame);
    }

    function generateMockResult() {
      var isFracture = Math.random() < 0.7;
      return {
        prediction: isFracture ? 'fracture' : 'normal',
        confidence: isFracture
          ? +(0.89 + Math.random() * 0.10).toFixed(3)
          : +(0.85 + Math.random() * 0.12).toFixed(3),
        inferenceTimeSec: +(0.28 + Math.random() * 0.33).toFixed(2),
      };
    }

    simulateProgress(function () {
      var result = generateMockResult();
      try {
        sessionStorage.setItem('fracturedetect:result', JSON.stringify(result));
      } catch (e) {}
      window.location.href = '/results';
    });
  })();
</script>

<style>
  .processing-page {
    min-height: calc(100vh - 68px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    position: relative;
    overflow: hidden;
  }

  .proc-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .proc-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.1;
  }

  .proc-orb.orb-1 {
    width: 400px;
    height: 400px;
    background: var(--color-primary);
    top: -120px;
    right: -80px;
  }

  .proc-orb.orb-2 {
    width: 300px;
    height: 300px;
    background: #a855f7;
    bottom: -100px;
    left: -60px;
  }

  .processing-container {
    max-width: 520px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .proc-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-primary);
    background: rgba(37, 99, 235, 0.08);
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 28px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .proc-badge .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    animation: pulse-dot 1.2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }



  .processing-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.3;
    color: var(--color-text);
    margin: 0 0 10px;
  }

  .processing-subtext {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 36px;
    max-width: 400px;
  }

  .scanner-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
  }

  .scanner-viewbox {
    position: relative;
    width: 180px;
    height: 220px;
    background: #0B1121;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.06), 0 8px 32px rgba(0,0,0,0.3);
  }

  .scanner-bone {
    width: 120px;
    height: auto;
    opacity: 0.6;
    z-index: 1;
  }

  .scan-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.8), rgba(56, 189, 248, 1), rgba(56, 189, 248, 0.8), transparent);
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.5), 0 0 30px rgba(56, 189, 248, 0.2);
    top: 0;
    z-index: 2;
    pointer-events: none;
    will-change: transform;
  }

  .scan-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(56, 189, 248, 0.12);
    pointer-events: none;
    z-index: 0;
  }

  .scan-ring-1 {
    width: 140px;
    height: 140px;
    animation: scan-ring-expand 3s ease-out infinite;
  }

  .scan-ring-2 {
    width: 100px;
    height: 100px;
    animation: scan-ring-expand 3s ease-out 0.6s infinite;
  }

  .scan-ring-3 {
    width: 60px;
    height: 60px;
    animation: scan-ring-expand 3s ease-out 1.2s infinite;
  }

  @keyframes scan-ring-expand {
    0% { transform: scale(0.6); opacity: 0.6; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  .corner-bracket {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(56, 189, 248, 0.35);
    border-style: solid;
    z-index: 3;
  }

  .corner-tl { top: 8px; left: 8px; border-width: 2px 0 0 2px; border-radius: 3px 0 0 0; }
  .corner-tr { top: 8px; right: 8px; border-width: 2px 2px 0 0; border-radius: 0 3px 0 0; }
  .corner-bl { bottom: 8px; left: 8px; border-width: 0 0 2px 2px; border-radius: 0 0 0 3px; }
  .corner-br { bottom: 8px; right: 8px; border-width: 0 2px 2px 0; border-radius: 0 0 3px 0; }

  .scan-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .scan-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #64748B;
    flex-shrink: 0;
  }

  .scan-dot.dot-active {
    background: #38BDF8;
    box-shadow: 0 0 6px rgba(56, 189, 248, 0.5);
    animation: pulse-dot 0.8s ease-in-out infinite;
  }

  .scan-dot.dot-done {
    background: #16A34A;
    box-shadow: 0 0 6px rgba(22, 163, 74, 0.4);
  }

  .steps-track {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 32px;
    width: 100%;
    max-width: 360px;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 1;
  }

  .step-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle);
    border: 2px solid var(--color-border);
    transition: all 0.3s ease;
  }

  .step.active .step-circle {
    color: white;
    background: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
  }

  .step-label {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .step.active .step-label {
    color: var(--color-primary);
  }

  .step-connector {
    flex: 1;
    height: 2px;
    background: var(--color-border);
    margin: 0 4px;
    margin-bottom: 28px;
    transition: background 0.3s ease;
  }

  .step-connector.active {
    background: var(--color-primary);
  }

  .progress-area {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin-bottom: 28px;
  }

  .progress-track {
    flex: 1;
    height: 8px;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-primary), #3b82f6);
    border-radius: var(--radius-sm);
    transition: width 0.1s linear;
  }

  .progress-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    color: var(--color-primary);
    min-width: 40px;
    text-align: right;
    flex-shrink: 0;
  }

  .proc-details {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }

  .proc-detail-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-muted);
    padding: 10px 16px;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    opacity: 0.5;
    transition: all 0.3s ease;
  }

  .proc-detail-item.active {
    opacity: 1;
    background: rgba(37, 99, 235, 0.06);
    color: var(--color-text);
  }

  .proc-detail-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border);
    flex-shrink: 0;
    transition: background 0.3s ease;
  }

  .proc-detail-item.active .proc-detail-dot {
    background: var(--color-primary);
    box-shadow: 0 0 6px rgba(37, 99, 235, 0.4);
    animation: pulse-dot 1.2s ease-in-out infinite;
  }

  .info-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.4;
    text-align: left;
    width: 100%;
    box-sizing: border-box;
  }

  .info-banner svg {
    flex-shrink: 0;
    color: var(--color-neutral);
  }

  @media (max-width: 480px) {
    .processing-page {
      padding: 40px 20px;
    }

    .processing-title {
      font-size: 20px;
    }

    .processing-subtext {
      font-size: 15px;
      margin-bottom: 28px;
    }

    .scanner-viewbox {
      width: 150px;
      height: 180px;
    }

    .scanner-bone {
      width: 90px;
    }

    .steps-track {
      max-width: 300px;
    }

    .step-circle {
      width: 32px;
      height: 32px;
      font-size: 13px;
    }

    .info-banner {
      font-size: 13px;
      padding: 12px 14px;
    }
  }
</style>
