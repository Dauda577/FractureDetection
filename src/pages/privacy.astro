---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Privacy Policy"
  description="FractureDetect Privacy Policy - How we collect, use, and protect your data"
  active="about"
  variant="marketing"
>
  <main class="page-enter">
    <section class="hero legal-hero">
      <div class="hero-container">
        <div class="hero-content reveal" style="transition-delay:0.1s">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            Privacy Policy
          </div>
          <h1 class="hero-title">Your privacy matters</h1>
          <p class="hero-description">
            Last updated: July 28, 2026. This policy explains how FractureDetect
            ("we", "us", "our") collects, uses, and protects your information
            when you use our AI-powered fracture detection platform.
          </p>
          <div class="hero-meta">
            <span class="meta-item"
              ><svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                  x1="8"
                  y1="2"
                  x2="8"
                  y2="6"></line><line x1="3" y1="10" x2="21" y2="10"
                ></line></svg
              > Effective: July 28, 2026</span
            >
            <span class="meta-item"
              ><svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"
                ></path></svg
              > Version 2.1</span
            >
          </div>
        </div>
      </div>
    </section>

    <section class="legal-content reveal" style="transition-delay:0.1s">
      <div class="legal-container">
        <nav class="legal-toc" aria-label="Table of contents">
          <h3>Contents</h3>
          <ol>
            <li><a href="#data-collection">1. Information We Collect</a></li>
            <li><a href="#data-use">2. How We Use Your Information</a></li>
            <li><a href="#data-sharing">3. Data Sharing & Disclosure</a></li>
            <li><a href="#data-security">4. Data Security</a></li>
            <li><a href="#data-retention">5. Data Retention</a></li>
            <li><a href="#your-rights">6. Your Rights</a></li>
            <li><a href="#cookies">7. Cookies & Tracking</a></li>
            <li><a href="#international">8. International Transfers</a></li>
            <li><a href="#children">9. Children's Privacy</a></li>
            <li><a href="#changes">10. Changes to This Policy</a></li>
            <li><a href="#contact">11. Contact Us</a></li>
          </ol>
        </nav>

        <article class="legal-article">
          <section id="data-collection">
            <h2>1. Information We Collect</h2>
            <h3>1.1 Personal Information</h3>
            <p>We collect information you provide directly to us:</p>
            <ul>
              <li>
                <strong>Account Information:</strong> Name, email address, password
                (hashed), and professional credentials when you create an account.
              </li>
              <li>
                <strong>Patient Data:</strong> Patient names, ages, genders, medical
                record numbers, and clinical notes — only when you voluntarily enter
                them for analysis.
              </li>
              <li>
                <strong>Images:</strong> X-ray images you upload for analysis, including
                any embedded metadata (DICOM tags).
              </li>
              <li>
                <strong>Communications:</strong> Messages you send to our support
                team.
              </li>
            </ul>

            <h3>1.2 Automatically Collected Information</h3>
            <ul>
              <li>
                <strong>Usage Data:</strong> Page views, feature interactions, analysis
                counts, and timing data.
              </li>
              <li>
                <strong>Device Information:</strong> IP address, browser type, operating
                system, and device identifiers.
              </li>
              <li>
                <strong>Log Data:</strong> Server logs including request timestamps,
                response codes, and error details.
              </li>
            </ul>
          </section>

          <section id="data-use">
            <h2>2. How We Use Your Information</h2>
            <p>We use your information to:</p>
            <ul>
              <li>
                Provide, maintain, and improve our fracture detection service
              </li>
              <li>
                Process and analyze uploaded X-ray images using our AI models
              </li>
              <li>
                Generate and deliver analysis reports with confidence scores and
                heatmaps
              </li>
              <li>Manage your account and authenticate access</li>
              <li>
                Send service-related communications (account updates, security
                alerts)
              </li>
              <li>Respond to your inquiries and provide customer support</li>
              <li>Monitor and analyze usage trends to improve our platform</li>
              <li>Comply with legal obligations and enforce our terms</li>
            </ul>
            <p>
              We do <strong>not</strong> use your medical images or patient data to
              train or improve The models without explicit consent.
            </p>
          </section>

          <section id="data-sharing">
            <h2>3. Data Sharing & Disclosure</h2>
            <p>
              We do not sell your personal information. We may share data only
              in these circumstances:
            </p>
            <ul>
              <li>
                <strong>Service Providers:</strong> Trusted third parties who process
                data on our behalf (cloud hosting, email delivery, analytics) under
                strict data processing agreements.
              </li>
              <li>
                <strong>Legal Requirements:</strong> When required by law, court order,
                or governmental request.
              </li>
              <li>
                <strong>Business Transfers:</strong> In connection with a merger,
                acquisition, or sale of assets, with notice and consent where required.
              </li>
              <li>
                <strong>Anonymized Data:</strong> Aggregated, de-identified usage
                statistics that cannot be linked to individuals.
              </li>
            </ul>
          </section>

          <section id="data-security">
            <h2>4. Data Security</h2>
            <p>
              We implement appropriate technical and organizational measures:
            </p>
            <ul>
              <li>
                <strong>Encryption:</strong> TLS 1.3 for data in transit; AES-256
                for data at rest.
              </li>
              <li>
                <strong>Access Controls:</strong> Role-based access, principle of
                least privilege, and regular access reviews.
              </li>
              <li>
                <strong>Infrastructure:</strong> SOC 2 Type II certified cloud providers
                with continuous monitoring.
              </li>
              <li>
                <strong>Incident Response:</strong> Documented breach notification
                procedures with 72-hour reporting where required.
              </li>
              <li>
                <strong>HIPAA Compliance:</strong> Business Associate Agreements with
                all subprocessors handling PHI.
              </li>
            </ul>
          </section>

          <section id="data-retention">
            <h2>5. Data Retention</h2>
            <ul>
              <li>
                <strong>Account Data:</strong> Retained while your account is active
                and for 30 days after deletion request.
              </li>
              <li>
                <strong>Patient Records:</strong> Retained per your institutional
                policy or until you delete them; minimum 6 years for medical records
                where applicable.
              </li>
              <li>
                <strong>Images & Analysis Results:</strong> Retained in your account
                until manually deleted.
              </li>
              <li>
                <strong>Usage Logs:</strong> Retained for 12 months for security and
                analytics.
              </li>
              <li>
                <strong>Backups:</strong> Encrypted backups retained for up to 90
                days.
              </li>
            </ul>
          </section>

          <section id="your-rights">
            <h2>6. Your Rights</h2>
            <p>Depending on your jurisdiction, you may have the right to:</p>
            <ul>
              <li>
                <strong>Access:</strong> Request a copy of your personal data.
              </li>
              <li>
                <strong>Rectification:</strong> Correct inaccurate or incomplete data.
              </li>
              <li>
                <strong>Erasure:</strong> Request deletion of your data (subject to
                legal retention requirements).
              </li>
              <li>
                <strong>Portability:</strong> Receive your data in a structured, machine-readable
                format.
              </li>
              <li>
                <strong>Restriction:</strong> Limit processing of your data.
              </li>
              <li>
                <strong>Objection:</strong> Object to processing based on legitimate
                interests.
              </li>
              <li>
                <strong>Withdraw Consent:</strong> Where processing is based on consent.
              </li>
            </ul>
            <p>
              To exercise these rights, email <a
                href="mailto:privacy@fracturedetect.ai"
                >privacy@fracturedetect.ai</a
              >. We respond within 30 days.
            </p>
          </section>

          <section id="cookies">
            <h2>7. Cookies & Tracking</h2>
            <p>We use:</p>
            <ul>
              <li>
                <strong>Essential Cookies:</strong> Session authentication, CSRF protection,
                security.
              </li>
              <li>
                <strong>Analytics Cookies:</strong> Anonymous usage statistics (opt-out
                available).
              </li>
              <li>
                <strong>Preference Cookies:</strong> Remember your UI preferences
                (theme, language).
              </li>
            </ul>
            <p>
              You can manage cookie preferences in your browser settings.
              Disabling essential cookies may break core functionality.
            </p>
          </section>

          <section id="international">
            <h2>8. International Transfers</h2>
            <p>
              Our servers are located in the United States. If you access our
              service from outside the US, your data will be transferred to and
              processed in the US. We rely on Standard Contractual Clauses and
              adequacy decisions for lawful transfer. By using our service, you
              consent to this transfer.
            </p>
          </section>

          <section id="children">
            <h2>9. Children's Privacy</h2>
            <p>
              Our service is not directed to individuals under 18. We do not
              knowingly collect personal information from children. If you
              believe we have collected data from a minor, contact us
              immediately for deletion.
            </p>
          </section>

          <section id="changes">
            <h2>10. Changes to This Policy</h2>
            <p>
              We may update this policy periodically. Material changes will be
              communicated via email and/or prominent notice on our platform 30
              days before taking effect. Continued use constitutes acceptance.
            </p>
          </section>

          <section id="contact">
            <h2>11. Contact Us</h2>
            <p>Questions about this policy or your data?</p>
            <ul>
              <li>
                Email: <a href="mailto:privacy@fracturedetect.ai"
                  >privacy@fracturedetect.ai</a>
              </li>
              <li>
                Mail: FractureDetect Privacy Team, 100 Medical AI Drive, San
                Francisco, CA 94105
              </li>
            </ul>
            <p>
              For data protection officer inquiries: <a
                href="mailto:dpo@fracturedetect.ai">dpo@fracturedetect.ai</a>
            </p>
          </section>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script type="module">
  (function () {
    var tocLinks = document.querySelectorAll(".legal-toc a");
    var sections = document.querySelectorAll(".legal-article section[id]");

    tocLinks.forEach(function (link) {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        var targetId = this.getAttribute("href").slice(1);
        var target = document.getElementById(targetId);
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          history.pushState(null, "", "#" + targetId);
        }
      });
    });

    // Highlight active TOC item on scroll
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            tocLinks.forEach(function (l) {
              l.classList.toggle(
                "toc-active",
                l.getAttribute("href") === "#" + entry.target.id,
              );
            });
          }
        });
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: 0 },
    );

    sections.forEach(function (s) {
      observer.observe(s);
    });
  })();
</script>

<style>
  .legal-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: 48px 24px;
  }
  .hero-container {
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-primary);
    background: rgba(37, 99, 235, 0.08);
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .hero-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 44px;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0 0 20px;
    letter-spacing: -0.02em;
  }
  .hero-description {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 24px;
    max-width: 640px;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .legal-content {
    padding: 48px 24px 80px;
  }
  .legal-container {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 48px;
  }
  .legal-toc {
    position: sticky;
    top: 100px;
    align-self: start;
  }
  .legal-toc h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 16px;
  }
  .legal-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .legal-toc a {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .legal-toc a:hover,
  .legal-toc a.toc-active {
    color: var(--color-primary);
    font-weight: 500;
  }
  .legal-toc a.toc-active {
    color: var(--color-primary);
  }

  .legal-article {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .legal-article section {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .legal-article section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .legal-article h2 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 24px;
    color: var(--color-text);
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }
  .legal-article h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    color: var(--color-text);
    margin: 24px 0 10px;
  }
  .legal-article p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0 0 12px;
  }
  .legal-article p:last-child {
    margin-bottom: 0;
  }
  .legal-article ul {
    margin: 8px 0 12px;
    padding-left: 20px;
  }
  .legal-article li {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }
  .legal-article a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-article a:hover {
    color: var(--color-primary);
  }
  .legal-article strong {
    color: var(--color-text);
  }

  @media (max-width: 1024px) {
    .legal-container {
      grid-template-columns: 220px 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 900px) {
    .legal-container {
      grid-template-columns: 1fr;
    }
    .legal-toc {
      position: static;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 24px;
    }
    .legal-toc ol {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 10px;
    }
    .legal-toc a {
      font-size: 13px;
      padding: 4px 8px;
      border-radius: 4px;
      background: var(--color-bg-subtle);
    }
  }
  @media (max-width: 480px) {
    .legal-hero {
      min-height: auto;
      padding: 40px 20px 24px;
    }
    .hero-title {
      font-size: 28px;
    }
    .hero-description {
      font-size: 16px;
    }
    .legal-content {
      padding: 32px 20px 60px;
    }
    .legal-article h2 {
      font-size: 20px;
    }
    .legal-article h3 {
      font-size: 15px;
    }
    .legal-article p,
    .legal-article li {
      font-size: 14px;
    }
  }
</style>
