---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---
<Layout title="Dashboard" description="Your FractureDetect analysis dashboard" active="account" variant="app">
  <main class="dash-page page-enter">
    <div id="dash-gate" class="dash-gate">
      <div class="dash-gate-card">
        <div class="dash-gate-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <h1 class="dash-gate-title">Dashboard</h1>
        <p class="dash-gate-subtext">Sign in or create an account to view your analysis dashboard, history, and insights.</p>
        <div class="dash-gate-buttons">
          <a href="/signup" class="btn-submit fd-magnetic" data-ripple>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="8.5" cy="7" r="4" />
              <line x1="20" y1="8" x2="20" y2="14" />
              <line x1="23" y1="11" x2="17" y2="11" />
            </svg>
            Create Account
          </a>
          <a href="/signin" class="btn-submit-alt fd-magnetic" data-ripple>Sign In</a>
        </div>
      </div>
    </div>

    <div id="dash-ui" class="hidden">
      <div class="dash-layout">
        <Sidebar active="dashboard" />
        <div class="dash-main">
          <div class="dash-content">

            <div id="analysis-view">

              <div class="top-bar">
                <div class="top-left">
                  <h1 class="top-title">Dashboard</h1>
                  <p class="top-subtitle">Overview of your fracture analysis results</p>
                </div>
                <div class="top-right">
                  <a href="/analyze" class="top-btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    New Analysis
                  </a>
                  <button class="top-icon-btn" id="btn-notifications" title="Notifications">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                    <span class="notif-dot"></span>
                  </button>
                  <div class="top-avatar" id="top-avatar">
                    <span id="top-avatar-initial">U</span>
                  </div>
                </div>
              </div>

              <div class="row row-1">
                <div class="card card-diag">
                  <div class="card-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <span>Diagnosis</span>
                  </div>
                  <div class="diag-result">
                    <span class="diag-badge" id="diag-badge">No Result</span>
                  </div>
                  <div class="diag-meta" id="diag-meta">Run an analysis to see results</div>
                </div>

                <div class="card card-conf">
                  <div class="card-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    <span>Confidence Score</span>
                  </div>
                  <div class="gauge-wrap">
                    <svg class="gauge-svg" viewBox="0 0 120 120">
                      <circle class="gauge-bg" cx="60" cy="60" r="50" fill="none" stroke="var(--color-bg-subtle)" stroke-width="8" />
                      <circle class="gauge-fill" id="gauge-fill" cx="60" cy="60" r="50" fill="none" stroke="var(--color-primary)" stroke-width="8" stroke-linecap="round" stroke-dasharray="314.16" stroke-dashoffset="314.16" transform="rotate(-90 60 60)" />
                      <text class="gauge-text" id="gauge-text" x="60" y="60" text-anchor="middle" dominant-baseline="central" font-size="22" font-weight="700" fill="currentColor">—</text>
                    </svg>
                  </div>
                  <div class="conf-label">Confidence</div>
                </div>

                <div class="card card-ood">
                  <div class="card-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
                    <span>Novelty / OOD Score</span>
                  </div>
                  <div class="ood-value" id="ood-value">—</div>
                  <div class="ood-label" id="ood-label">No data</div>
                  <div class="ood-bar-wrap">
                    <div class="ood-bar-fill" id="ood-bar-fill" style="width:0%"></div>
                  </div>
                </div>

                <div class="card card-reco">
                  <div class="card-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    <span>Recommendation</span>
                  </div>
                  <div class="reco-text" id="reco-text">Run an analysis to receive a recommendation.</div>
                  <div class="reco-severity" id="reco-severity"></div>
                </div>
              </div>

              <div class="row row-2">
                <div class="pipeline-step">
                  <div class="step-label">Original X-ray</div>
                  <div class="step-img-wrap">
                    <img id="img-original" class="step-img" alt="Original X-ray" />
                    <div class="step-empty" id="empty-original">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                      <span>No image</span>
                    </div>
                    <button class="step-zoom" id="zoom-original" title="Zoom">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /><line x1="11" y1="8" x2="11" y2="14" /><line x1="8" y1="11" x2="14" y2="11" /></svg>
                    </button>
                  </div>
                </div>

                <div class="pipeline-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>

                <div class="pipeline-step">
                  <div class="step-label">Predicted Heatmap</div>
                  <div class="step-img-wrap">
                    <img id="img-heatmap" class="step-img" alt="Heatmap" />
                    <div class="step-empty" id="empty-heatmap">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                      <span>No image</span>
                    </div>
                    <button class="step-zoom" id="zoom-heatmap" title="Zoom">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /><line x1="11" y1="8" x2="11" y2="14" /><line x1="8" y1="11" x2="14" y2="11" /></svg>
                    </button>
                  </div>
                </div>

                <div class="pipeline-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>

                <div class="pipeline-step">
                  <div class="step-label">Segmentation Mask</div>
                  <div class="step-img-wrap">
                    <img id="img-segmentation" class="step-img" alt="Segmentation mask" />
                    <div class="step-empty" id="empty-segmentation">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5" /></svg>
                      <span>No mask</span>
                    </div>
                    <button class="step-zoom" id="zoom-segmentation" title="Zoom">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /><line x1="11" y1="8" x2="11" y2="14" /><line x1="8" y1="11" x2="14" y2="11" /></svg>
                    </button>
                  </div>
                </div>

                <div class="pipeline-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>

                <div class="pipeline-step">
                  <div class="step-label">Overlay</div>
                  <div class="step-img-wrap">
                    <div class="overlay-container" id="overlay-container">
                      <img id="img-overlay" class="step-img" alt="Overlay" />
                      <div class="overlay-heatmap" id="overlay-heatmap"></div>
                    </div>
                    <div class="step-empty" id="empty-overlay">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><rect x="8" y="8" width="8" height="8" /></svg>
                      <span>No overlay</span>
                    </div>
                    <button class="step-zoom" id="zoom-overlay" title="Zoom">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /><line x1="11" y1="8" x2="11" y2="14" /><line x1="8" y1="11" x2="14" y2="11" /></svg>
                    </button>
                  </div>
                  <div class="opacity-control" id="opacity-control">
                    <label class="opacity-label">Opacity</label>
                    <input type="range" class="opacity-slider" id="opacity-slider" min="0" max="100" value="50" />
                    <span class="opacity-value" id="opacity-value">50%</span>
                  </div>
                </div>
              </div>

              <div class="row row-3">
                <div class="card card-probs">
                  <div class="card-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10" /><path d="M12 20V4" /><path d="M6 20v-6" /></svg>
                    <span>Prediction Probabilities</span>
                  </div>
                  <div class="probs-chart" id="probs-chart">
                    <div class="prob-bar-row">
                      <span class="prob-label">Fracture</span>
                      <div class="prob-bar-track">
                        <div class="prob-bar-fill prob-bar-danger" id="prob-bar-fracture" style="width:0%"></div>
                      </div>
                      <span class="prob-value" id="prob-value-fracture">—</span>
                    </div>
                    <div class="prob-bar-row">
                      <span class="prob-label">Normal</span>
                      <div class="prob-bar-track">
                        <div class="prob-bar-fill prob-bar-safe" id="prob-bar-normal" style="width:0%"></div>
                      </div>
                      <span class="prob-value" id="prob-value-normal">—</span>
                    </div>
                  </div>
                  <div class="probs-empty" id="probs-empty">Run an analysis to see probabilities.</div>
                </div>

                <div class="card card-speedo">
                  <div class="card-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    <span>Novelty Score</span>
                  </div>
                  <div class="speedo-wrap">
                    <svg class="speedo-svg" viewBox="0 0 200 120">
                      <path class="speedo-track" d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="var(--color-bg-subtle)" stroke-width="12" stroke-linecap="round" />
                      <path class="speedo-fill" id="speedo-fill" d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="var(--color-success)" stroke-width="12" stroke-linecap="round" stroke-dasharray="226" stroke-dashoffset="226" />
                      <line class="speedo-needle" id="speedo-needle" x1="100" y1="100" x2="100" y2="30" stroke="var(--color-text)" stroke-width="2.5" stroke-linecap="round" transform="rotate(-90 100 100)" />
                      <circle cx="100" cy="100" r="5" fill="var(--color-text)" />
                      <text class="speedo-label" x="100" y="30" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-text-muted)">OOD</text>
                      <text class="speedo-readout" id="speedo-readout" x="100" y="80" text-anchor="middle" font-size="20" font-weight="700" fill="currentColor">—</text>
                    </svg>
                  </div>
                  <div class="speedo-status" id="speedo-status">No data</div>
                </div>

                <div class="card card-info">
                  <div class="card-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                    <span>Key Information</span>
                  </div>
                  <div class="info-list">
                    <div class="info-row"><span class="info-key">Patient</span><span class="info-val" id="info-patient">—</span></div>
                    <div class="info-row"><span class="info-key">Analysis Date</span><span class="info-val" id="info-date">—</span></div>
                    <div class="info-row"><span class="info-key">Model</span><span class="info-val" id="info-model">v2.1.0</span></div>
                    <div class="info-row"><span class="info-key">Status</span><span class="info-val" id="info-status">Pending</span></div>
                    <div class="info-row"><span class="info-key">Image Type</span><span class="info-val" id="info-image-type">X-ray</span></div>
                  </div>
                </div>

                <div class="card card-report-card">
                  <div class="card-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                    <span>Generate Report</span>
                  </div>
                  <p class="report-desc">Download a comprehensive PDF report with all analysis results, images, and findings.</p>
                  <button class="report-btn" id="btn-report-download" data-ripple>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                    Download Report
                  </button>
                </div>
              </div>

              <div class="disclaimer-banner">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>This result is intended to assist healthcare professionals and should not replace professional medical diagnosis. Always consult a qualified medical professional for clinical decisions.</span>
              </div>

            </div>

            <div id="patients-view" class="hidden">
              <div class="patients-header">
                <h2 class="view-title">Patients</h2>
                <a href="/analyze" class="top-btn-primary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                  New Patient
                </a>
              </div>
              <div id="patients-list"><div class="skeleton-list"><div class="skeleton-row"></div><div class="skeleton-row"></div><div class="skeleton-row"></div></div></div>
              <div id="patients-empty" class="hidden">
                <div class="empty-state">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                  <p class="empty-title">No patients yet</p>
                  <p class="empty-text">Add a patient when you start a new analysis.</p>
                  <a href="/analyze" class="top-btn-primary">New Analysis</a>
                </div>
              </div>
            </div>

            <div id="history-view" class="hidden">
              <div class="view-header">
                <button id="history-back" class="view-back-btn hidden" aria-label="Back">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
                </button>
                <h2 class="view-title">Analysis History</h2>
              </div>
              <div id="history-list"><div class="skeleton-list"><div class="skeleton-row"></div><div class="skeleton-row"></div><div class="skeleton-row"></div></div></div>
              <div id="history-empty" class="hidden">
                <div class="empty-state">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                  <p class="empty-title">No analyses yet</p>
                  <p class="empty-text">Run your first analysis to see it here.</p>
                  <a href="/analyze" class="top-btn-primary">New Analysis</a>
                </div>
              </div>
            </div>

            <div id="reports-view" class="hidden">
              <div class="view-header">
                <h2 class="view-title">Reports</h2>
              </div>
              <div id="reports-list"><div class="skeleton-list"><div class="skeleton-row"></div><div class="skeleton-row"></div><div class="skeleton-row"></div></div></div>
              <div id="reports-empty" class="hidden">
                <div class="empty-state">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                  <p class="empty-title">No reports yet</p>
                  <p class="empty-text">Generated reports will appear here.</p>
                </div>
              </div>
            </div>

            <div id="settings-view" class="hidden">
              <div class="view-header">
                <h2 class="view-title">Settings</h2>
              </div>
              <div class="settings-card">
                <div class="settings-section">
                  <h3 class="settings-section-title">Profile</h3>
                  <div class="settings-row"><span class="settings-key">Name</span><span class="settings-val" id="settings-name">User</span></div>
                  <div class="settings-row"><span class="settings-key">Email</span><span class="settings-val" id="settings-email">user@example.com</span></div>
                </div>
                <div class="settings-section">
                  <h3 class="settings-section-title">Preferences</h3>
                  <div class="settings-row"><span class="settings-key">Notifications</span><span class="settings-val">Coming soon</span></div>
                  <div class="settings-row"><span class="settings-key">Theme</span><span class="settings-val">System</span></div>
                </div>
                <div class="settings-section">
                  <h3 class="settings-section-title">Account</h3>
                  <button class="settings-signout-btn" id="btn-settings-signout" data-ripple>Sign Out</button>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script type="module">
  import { isSignedIn, getUser, logout } from '../scripts/auth.js';

  var gate = document.getElementById('dash-gate');
  var dashUi = document.getElementById('dash-ui');

  var VIEWS = ['analysis-view', 'patients-view', 'history-view', 'reports-view', 'settings-view'];
  var VIEW_TITLES = {
    'analysis-view': 'Dashboard',
    'patients-view': 'Patients',
    'history-view': 'Analysis History',
    'reports-view': 'Reports',
    'settings-view': 'Settings'
  };
  var filteredPatientId = null;

  function showView(viewId) {
    VIEWS.forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.classList.toggle('hidden', id !== viewId);
    });
    document.querySelectorAll('.nav-item').forEach(function (el) { el.classList.remove('active'); });
    document.querySelectorAll('.nav-item').forEach(function (l) {
      var text = l.querySelector('span')?.textContent;
      if (text && text.toLowerCase() === (VIEW_TITLES[viewId] || '').toLowerCase()) l.classList.add('active');
    });
    if (viewId === 'patients-view') loadPatientsList();
    if (viewId === 'history-view') {
      filteredPatientId = null;
      var backBtn = document.getElementById('history-back');
      if (backBtn) backBtn.classList.add('hidden');
      var titleEl = document.querySelector('#history-view .view-title');
      if (titleEl) titleEl.textContent = 'Analysis History';
      loadHistoryList();
    }
  }

  async function init() {
    var signedIn = await isSignedIn();
    if (gate && dashUi) {
      if (signedIn) { gate.classList.add('hidden'); dashUi.classList.remove('hidden'); }
    }
    if (!signedIn) return;

    var user = await getUser();
    if (user) {
      var topInitial = document.getElementById('top-avatar-initial');
      if (topInitial) topInitial.textContent = user.name.charAt(0).toUpperCase();
      document.getElementById('settings-name').textContent = user.name;
      document.getElementById('settings-email').textContent = user.email;
    }

    document.querySelectorAll('.nav-item').forEach(function (item) {
      item.addEventListener('click', function (e) {
        var text = this.querySelector('span')?.textContent;
        var map = { 'Dashboard': 'analysis-view', 'Patients': 'patients-view', 'History': 'history-view', 'Reports': 'reports-view', 'Settings': 'settings-view' };
        if (map[text]) { e.preventDefault(); showView(map[text]); }
      });
    });

    document.getElementById('btn-settings-signout').addEventListener('click', function () {
      document.getElementById('sidebar-signout')?.click();
    });

    loadLastResult();
  }

  async function loadPatientsList() {
    var { getPatients } = await import('../scripts/patients.js');
    var patients = await getPatients();
    var list = document.getElementById('patients-list');
    var empty = document.getElementById('patients-empty');
    if (!patients.length) {
      list.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');
    list.innerHTML = patients.map(function (p) {
      var created = new Date(p.created_at).toLocaleDateString();
      var initials = p.name.split(' ').map(function (w) { return w.charAt(0); }).join('').toUpperCase().slice(0, 2);
      var ageGender = (p.age ? p.age + ' yrs' : '') + (p.gender ? ' &middot; ' + p.gender : '');
      var mrn = p.medical_record_id ? escapeHtml(p.medical_record_id) : '';
      return '<div class="patient-card" data-patient-id="' + p.id + '">' +
        '<div class="pc-avatar">' + initials + '</div>' +
        '<div class="pc-body">' +
          '<div class="pc-name">' + escapeHtml(p.name) + '</div>' +
          '<div class="pc-line">' + (ageGender || '—') + (mrn ? ' <span class="pc-mrn">' + mrn + '</span>' : '') + '</div>' +
          '<div class="pc-line pc-date">Registered ' + created + '</div>' +
        '</div>' +
        '<div class="pc-arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg></div>' +
      '</div>';
    }).join('');
    list.querySelectorAll('.patient-card').forEach(function (card) {
      card.addEventListener('click', function () {
        showPatientScans(card.getAttribute('data-patient-id'), card.querySelector('.pc-name').textContent);
      });
    });
  }

  async function showPatientScans(patientId, patientName) {
    var { getPatient } = await import('../scripts/patients.js');
    var patient = await getPatient(patientId);
    var name = patientName || (patient ? patient.name : 'Patient');
    var historyTitle = document.querySelector('#history-view .view-title');
    if (historyTitle) historyTitle.textContent = name + '\'s Scans';
    var historyBack = document.getElementById('history-back');
    if (historyBack) historyBack.classList.remove('hidden');
    filteredPatientId = patientId;
    loadHistoryList(patientId);
    showView('history-view');
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  async function loadHistoryList(patientId) {
    var { getAnalyses } = await import('../scripts/api.js');
    var analyses = await getAnalyses();
    var list = document.getElementById('history-list');
    var empty = document.getElementById('history-empty');
    if (patientId) analyses = analyses.filter(function (a) { return a.patient_id === patientId; });
    if (!analyses.length) {
      list.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');
    list.innerHTML = analyses.map(function (a) {
      var date = new Date(a.created_at).toLocaleString();
      var isFracture = a.prediction === 'fracture';
      var badgeClass = isFracture ? 'history-badge-danger' : 'history-badge-safe';
      var label = isFracture ? 'Fracture' : 'Normal';
      return '<div class="history-card">' +
        '<div class="history-card-left">' +
          '<span class="history-badge ' + badgeClass + '">' + label + '</span>' +
          '<span class="history-conf">' + (a.confidence * 100).toFixed(1) + '%</span>' +
        '</div>' +
        '<div class="history-card-mid">' +
          '<span class="history-date">' + date + '</span>' +
          '<span class="history-id">' + (a.id || '—') + '</span>' +
        '</div>' +
        '<div class="history-card-right">' +
          '<a href="/results" class="history-view-link">View</a>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  function loadLastResult() {
    var imgData = sessionStorage.getItem('fracturedetect:image');
    var resultData = sessionStorage.getItem('fracturedetect:result');
    if (!resultData) return;

    var result = JSON.parse(resultData);
    var isFracture = result.prediction === 'fracture';
    var confNum = parseFloat((result.confidence * 100).toFixed(1));

    var diagBadge = document.getElementById('diag-badge');
    var diagMeta = document.getElementById('diag-meta');
    if (isFracture) {
      diagBadge.textContent = 'Fracture Detected';
      diagBadge.style.color = 'var(--color-danger)';
      diagBadge.style.background = 'rgba(220,38,38,0.1)';
      diagMeta.textContent = 'High confidence positive finding';
    } else {
      diagBadge.textContent = 'Normal';
      diagBadge.style.color = 'var(--color-success)';
      diagBadge.style.background = 'rgba(22,163,74,0.1)';
      diagMeta.textContent = 'No fracture detected';
    }

    var gaugeFill = document.getElementById('gauge-fill');
    var gaugeText = document.getElementById('gauge-text');
    var circumference = 314.16;
    var offset = circumference - (confNum / 100) * circumference;
    if (gaugeFill) {
      gaugeFill.style.strokeDashoffset = offset;
      gaugeFill.style.stroke = isFracture ? 'var(--color-danger)' : 'var(--color-success)';
    }
    if (gaugeText) gaugeText.textContent = confNum + '%';

    var oodScore = 18.4;
    var oodValue = document.getElementById('ood-value');
    var oodLabel = document.getElementById('ood-label');
    var oodFill = document.getElementById('ood-bar-fill');
    if (oodValue) oodValue.textContent = oodScore.toFixed(1);
    if (oodLabel) oodLabel.textContent = oodScore < 25 ? 'Low — in-distribution' : oodScore < 50 ? 'Moderate' : 'High — out-of-distribution';
    if (oodFill) oodFill.style.width = Math.min(oodScore, 100) + '%';

    var recoText = document.getElementById('reco-text');
    var recoSeverity = document.getElementById('reco-severity');
    if (isFracture) {
      recoText.textContent = 'Immediate medical consultation recommended. Please consult with an orthopedic specialist for further evaluation and treatment planning.';
      recoSeverity.textContent = 'Action Required';
      recoSeverity.className = 'reco-severity reco-severity-danger';
    } else {
      recoText.textContent = 'No signs of fracture detected. Continue routine monitoring as recommended by your healthcare provider.';
      recoSeverity.textContent = 'Routine';
      recoSeverity.className = 'reco-severity reco-severity-safe';
    }

    var probFracture = document.getElementById('prob-bar-fracture');
    var probNormal = document.getElementById('prob-bar-normal');
    var probValFracture = document.getElementById('prob-value-fracture');
    var probValNormal = document.getElementById('prob-value-normal');
    var probsEmpty = document.getElementById('probs-empty');
    if (probFracture && probNormal) {
      probsEmpty.style.display = 'none';
      var fracPct = isFracture ? confNum : (100 - confNum);
      var normPct = isFracture ? (100 - confNum) : confNum;
      probFracture.style.width = fracPct + '%';
      probNormal.style.width = normPct + '%';
      probValFracture.textContent = fracPct.toFixed(1) + '%';
      probValNormal.textContent = normPct.toFixed(1) + '%';
    }

    var speedoFill = document.getElementById('speedo-fill');
    var speedoNeedle = document.getElementById('speedo-needle');
    var speedoReadout = document.getElementById('speedo-readout');
    var speedoStatus = document.getElementById('speedo-status');
    if (speedoFill && speedoNeedle) {
      var maxDash = 226;
      var oodAngle = Math.min(oodScore / 100, 1) * 180;
      var oodOffset = maxDash - (oodAngle / 180) * maxDash;
      speedoFill.style.strokeDashoffset = oodOffset;
      speedoNeedle.setAttribute('transform', 'rotate(' + (oodAngle - 90) + ' 100 100)');
      speedoReadout.textContent = oodScore.toFixed(1);
      if (oodScore < 25) {
        speedoFill.style.stroke = 'var(--color-success)';
        speedoStatus.textContent = 'In-distribution';
        speedoStatus.style.color = 'var(--color-success)';
      } else if (oodScore < 50) {
        speedoFill.style.stroke = '#f59e0b';
        speedoStatus.textContent = 'Borderline';
        speedoStatus.style.color = '#f59e0b';
      } else {
        speedoFill.style.stroke = 'var(--color-danger)';
        speedoStatus.textContent = 'Out-of-distribution';
        speedoStatus.style.color = 'var(--color-danger)';
      }
    }

    var infoPatient = document.getElementById('info-patient');
    var infoDate = document.getElementById('info-date');
    var infoStatus = document.getElementById('info-status');
    var patientId = sessionStorage.getItem('fracturedetect:patient_id');
    if (patientId) {
      import('../scripts/patients.js').then(function (mod) {
        mod.getPatient(patientId).then(function (p) {
          if (p && infoPatient) infoPatient.textContent = p.name;
        });
      });
    }
    if (infoDate) infoDate.textContent = new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    if (infoStatus) {
      infoStatus.textContent = isFracture ? 'Fracture Detected' : 'Normal';
      infoStatus.style.color = isFracture ? 'var(--color-danger)' : 'var(--color-success)';
    }

    if (imgData) {
      var orig = document.getElementById('img-original');
      var heat = document.getElementById('img-heatmap');
      var seg = document.getElementById('img-segmentation');
      var overlay = document.getElementById('img-overlay');
      if (orig) { orig.src = imgData; document.getElementById('empty-original')?.classList.add('hidden'); }
      if (heat) { heat.src = imgData; document.getElementById('empty-heatmap')?.classList.add('hidden'); }
      if (seg) { document.getElementById('empty-segmentation')?.classList.add('hidden'); }
      if (overlay) {
        overlay.src = imgData;
        document.getElementById('empty-overlay')?.classList.add('hidden');
        var heatOverlay = document.getElementById('overlay-heatmap');
        if (heatOverlay && isFracture) {
          heatOverlay.style.background = 'radial-gradient(ellipse at 42% 52%, rgba(255,50,0,0.65) 0%, rgba(255,130,0,0.45) 18%, rgba(255,220,0,0.3) 38%, transparent 58%)';
          heatOverlay.style.opacity = '0.5';
        }
      }
    }

    var slider = document.getElementById('opacity-slider');
    var opacityValue = document.getElementById('opacity-value');
    var heatOverlay = document.getElementById('overlay-heatmap');
    if (slider && opacityValue && heatOverlay) {
      slider.addEventListener('input', function () {
        var val = this.value;
        opacityValue.textContent = val + '%';
        heatOverlay.style.opacity = (val / 100);
      });
    }

    var downloadBtn = document.getElementById('btn-report-download');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', function () {
        var canvas = document.createElement('canvas');
        var ctx = canvas.getContext('2d');
        canvas.width = 800;
        var imgW = 400, imgH = 300;
        var findingsText = isFracture
          ? ['Bone discontinuity detected in the forearm region', 'Fracture localized to the mid-shaft of the radius', 'No signs of comminution or displacement detected']
          : ['No visible bone discontinuity detected', 'Bone alignment appears normal', 'No suspicious abnormalities identified'];
        canvas.height = 700 + imgH + findingsText.length * 28;

        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#0F172A';
        ctx.font = 'bold 26px Poppins, sans-serif';
        ctx.fillText('FractureDetect Analysis Report', 40, 50);
        ctx.fillStyle = '#475569';
        ctx.font = '14px Inter, sans-serif';
        ctx.fillText('Generated: ' + new Date().toLocaleString(), 40, 80);
        ctx.strokeStyle = '#E2E8F0';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(40, 100); ctx.lineTo(760, 100); ctx.stroke();

        ctx.fillStyle = '#0F172A';
        ctx.font = 'bold 20px Poppins, sans-serif';
        ctx.fillText('Prediction: ' + diagBadge.textContent, 40, 140);
        ctx.fillStyle = isFracture ? '#DC2626' : '#16A34A';
        ctx.font = 'bold 40px Poppins, sans-serif';
        ctx.fillText(confNum + '%', 40, 190);
        ctx.fillStyle = '#475569';
        ctx.font = '14px Inter, sans-serif';
        ctx.fillText('Confidence Score', 40, 210);
        ctx.fillStyle = '#0F172A';
        ctx.font = '15px Inter, sans-serif';
        ctx.fillText('Inference Time: ' + (result.inferenceTimeSec || 0).toFixed(2) + ' sec', 40, 248);
        ctx.fillText('Model Version: v2.1.0', 40, 272);

        ctx.strokeStyle = '#E2E8F0'; ctx.beginPath(); ctx.moveTo(40, 296); ctx.lineTo(760, 296); ctx.stroke();
        ctx.fillStyle = '#0F172A'; ctx.font = 'bold 16px Poppins, sans-serif';
        ctx.fillText('Findings Summary', 40, 325);
        ctx.fillStyle = '#334155'; ctx.font = '14px Inter, sans-serif';
        findingsText.forEach(function (t, i) { ctx.fillText('\u2022  ' + t, 40, 353 + i * 28); });

        var findingsEndY = 353 + findingsText.length * 28;
        ctx.strokeStyle = '#E2E8F0'; ctx.beginPath(); ctx.moveTo(40, findingsEndY + 8); ctx.lineTo(760, findingsEndY + 8); ctx.stroke();
        ctx.fillStyle = '#0F172A'; ctx.font = 'bold 16px Poppins, sans-serif';
        ctx.fillText('X-ray Image', 40, findingsEndY + 40);

        var imgX = Math.round((canvas.width - imgW) / 2);
        var origImg = document.getElementById('img-original');
        if (origImg && origImg.src) ctx.drawImage(origImg, imgX, findingsEndY + 56, imgW, imgH);

        if (isFracture) {
          var overlayCanvas = document.createElement('canvas');
          overlayCanvas.width = imgW; overlayCanvas.height = imgH;
          var octx = overlayCanvas.getContext('2d');
          var gradient = octx.createRadialGradient(imgW * 0.42, imgH * 0.52, 0, imgW * 0.42, imgH * 0.52, imgW * 0.5);
          gradient.addColorStop(0, 'rgba(255, 50, 0, 0.5)');
          gradient.addColorStop(0.18, 'rgba(255, 130, 0, 0.35)');
          gradient.addColorStop(0.38, 'rgba(255, 220, 0, 0.2)');
          gradient.addColorStop(1, 'transparent');
          octx.fillStyle = gradient; octx.fillRect(0, 0, imgW, imgH);
          ctx.drawImage(overlayCanvas, imgX, findingsEndY + 56, imgW, imgH);
        }

        var imgBottomY = findingsEndY + 56 + imgH + 24;
        ctx.strokeStyle = '#E2E8F0'; ctx.beginPath(); ctx.moveTo(40, imgBottomY); ctx.lineTo(760, imgBottomY); ctx.stroke();
        ctx.fillStyle = '#475569'; ctx.font = '13px Inter, sans-serif';
        ctx.fillText('This result is intended to assist healthcare professionals and should not replace', 40, imgBottomY + 24);
        ctx.fillText('professional medical diagnosis.', 40, imgBottomY + 44);

        var link = document.createElement('a');
        link.download = 'fracturedetect-report.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }
  }

  window.initZoom = function (imgId, zoomBtnId) {
    var img = document.getElementById(imgId);
    var btn = document.getElementById(zoomBtnId);
    if (!img || !btn) return;
    var zoomed = false;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      zoomed = !zoomed;
      img.style.transform = zoomed ? 'scale(2)' : '';
      img.style.cursor = zoomed ? 'zoom-out' : 'zoom-in';
      img.style.zIndex = zoomed ? '10' : '';
      btn.style.opacity = zoomed ? '1' : '';
    });
  };

  initZoom('img-original', 'zoom-original');
  initZoom('img-heatmap', 'zoom-heatmap');
  initZoom('img-segmentation', 'zoom-segmentation');
  initZoom('img-overlay', 'zoom-overlay');

  init();
</script>

<style>
  .hidden { display: none !important; }

  .dash-gate {
    display: flex; align-items: center; justify-content: center;
    min-height: calc(100vh - 68px); padding: 48px 24px;
  }
  .dash-gate-card {
    max-width: 460px; width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 48px 40px; text-align: center;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .dash-gate-icon {
    width: 72px; height: 72px; border-radius: 20px;
    background: rgba(37,99,235,0.08);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 24px; color: var(--color-primary);
  }
  .dash-gate-title { font-family: var(--font-heading); font-weight: 600; font-size: 28px; line-height: 1.25; color: var(--color-text); margin: 0 0 12px; letter-spacing: -0.02em; }
  .dash-gate-subtext { font-family: var(--font-body); font-size: 16px; line-height: 1.6; color: var(--color-text-muted); margin: 0 0 32px; }
  .dash-gate-buttons { display: flex; flex-direction: column; gap: 12px; }
  .btn-submit {
    display: flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none;
    font-family: var(--font-body); font-weight: 600; font-size: 15px; color: white;
    background: linear-gradient(135deg, var(--color-primary), #1d4ed8);
    padding: 12px 24px; border: none; border-radius: var(--radius-md);
    cursor: pointer; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(37,99,235,0.25);
  }
  .btn-submit:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,0.35); }
  .btn-submit-alt {
    display: flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none;
    font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--color-text);
    background: var(--color-surface); padding: 12px 24px;
    border: 1px solid var(--color-border); border-radius: var(--radius-md);
    cursor: pointer; transition: all 0.2s ease;
  }
  .btn-submit-alt:hover { border-color: var(--color-primary); color: var(--color-primary); transform: translateY(-1px); }

  /* ── Layout ── */
  .dash-page { position: relative; background: var(--color-bg-subtle); min-height: calc(100vh - 68px); padding: 0; }
  .dash-layout { display: flex; max-width: 100%; min-height: calc(100vh - 68px); }
  .dash-main { flex: 1; min-width: 0; background: var(--color-bg-subtle); margin-left: 256px; }
  .dash-content { max-width: 1400px; padding: 24px 32px 40px; margin: 0 auto; }

  /* ── Top Bar ── */
  .top-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; gap: 16px; }
  .top-left { display: flex; flex-direction: column; gap: 2px; }
  .top-title { font-family: var(--font-heading); font-weight: 600; font-size: 26px; color: var(--color-text); margin: 0; letter-spacing: -0.02em; }
  .top-subtitle { font-family: var(--font-body); font-size: 14px; color: var(--color-text-muted); margin: 0; }
  .top-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .top-btn-primary {
    display: inline-flex; align-items: center; gap: 8px; text-decoration: none;
    font-family: var(--font-body); font-weight: 600; font-size: 14px; color: white;
    background: linear-gradient(135deg, var(--color-primary), #1d4ed8);
    padding: 10px 20px; border: none; border-radius: var(--radius-md);
    cursor: pointer; transition: all 0.2s ease; white-space: nowrap;
    box-shadow: 0 4px 12px rgba(37,99,235,0.25);
  }
  .top-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,0.35); }
  .top-icon-btn {
    position: relative; width: 38px; height: 38px; border-radius: 50%;
    background: var(--color-surface); border: 1px solid var(--color-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--color-text-muted); cursor: pointer; transition: all 0.15s;
  }
  .top-icon-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .notif-dot {
    position: absolute; top: 8px; right: 8px; width: 7px; height: 7px;
    border-radius: 50%; background: var(--color-danger); border: 2px solid var(--color-surface);
  }
  .top-avatar {
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--color-primary); border: 2px solid var(--color-border);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-heading); font-weight: 600; font-size: 14px; color: white;
    flex-shrink: 0; cursor: default;
  }

  /* ── Row 1: Stat Cards ── */
  .row-1 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
  .card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 18px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.03);
  }
  .card-header {
    display: flex; align-items: center; gap: 6px;
    font-family: var(--font-body); font-weight: 600; font-size: 10px;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-text-muted); margin-bottom: 12px;
  }
  .card-header svg { opacity: 0.5; flex-shrink: 0; }

  .diag-result { margin-bottom: 6px; }
  .diag-badge { display: inline-block; font-family: var(--font-heading); font-weight: 600; font-size: 15px; padding: 5px 12px; border-radius: var(--radius-md); background: var(--color-bg-subtle); color: var(--color-text-muted); }
  .diag-meta { font-family: var(--font-body); font-size: 12px; color: var(--color-text-muted); line-height: 1.4; }

  .gauge-wrap { text-align: center; padding: 4px 0; }
  .gauge-svg { width: 72px; height: 72px; display: block; margin: 0 auto; }
  .gauge-fill { transition: stroke-dashoffset 0.6s ease; }
  .conf-label { text-align: center; font-family: var(--font-body); font-size: 11px; color: var(--color-text-muted); margin-top: 2px; }

  .ood-value { font-family: var(--font-heading); font-weight: 700; font-size: 26px; color: var(--color-text); margin-bottom: 2px; }
  .ood-label { font-family: var(--font-body); font-size: 12px; color: var(--color-success); margin-bottom: 10px; }
  .ood-bar-wrap { height: 5px; background: var(--color-bg-subtle); border-radius: 3px; overflow: hidden; }
  .ood-bar-fill { height: 100%; background: var(--color-success); border-radius: 3px; transition: width 0.5s ease; }

  .reco-text { font-family: var(--font-body); font-size: 12px; line-height: 1.5; color: var(--color-text-muted); margin-bottom: 10px; }
  .reco-severity {
    display: inline-block; font-family: var(--font-body); font-weight: 600; font-size: 11px;
    padding: 4px 10px; border-radius: var(--radius-md);
  }
  .reco-severity-danger { color: var(--color-danger); background: rgba(220,38,38,0.1); }
  .reco-severity-safe { color: var(--color-success); background: rgba(22,163,74,0.1); }

  /* ── Row 2: Image Pipeline ── */
  .row-2 { display: flex; align-items: center; gap: 8px; margin-bottom: 24px; }
  .pipeline-step { flex: 1; min-width: 0; }
