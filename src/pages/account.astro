---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---
<Layout title="Dashboard" description="Your FractureDetect analysis dashboard" active="account" variant="app">
  <main class="dash-page page-enter">
    <div id="dash-gate" class="dash-gate">
      <div class="dash-gate-card">
        <div class="dash-gate-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <h1 class="dash-gate-title">Dashboard</h1>
        <p class="dash-gate-subtext">Sign in or create an account to view your analysis dashboard, history, and insights.</p>
        <div class="dash-gate-buttons">
          <a href="/signup" class="btn-submit fd-magnetic" data-ripple>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="8.5" cy="7" r="4" />
              <line x1="20" y1="8" x2="20" y2="14" />
              <line x1="23" y1="11" x2="17" y2="11" />
            </svg>
            Create Account
          </a>
          <a href="/signin" class="btn-submit-alt fd-magnetic" data-ripple>Sign In</a>
        </div>
      </div>
    </div>

    <div id="dash-ui" class="hidden">
      <div class="dash-layout">
        <Sidebar active="dashboard" />
        <div class="dash-main">
          <div class="dash-content">
            <div class="dash-top-bar">
              <h1 class="dash-heading" id="dash-heading">Analysis Dashboard</h1>
              <div class="dash-top-right">
                <span class="dash-date" id="dash-date"></span>
                <button class="dash-refresh" id="dash-refresh" title="Refresh">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                </button>
              </div>
            </div>

            <div id="analysis-view">
              <div class="row row-top" id="row-summary">
                <div class="panel panel-diag" id="panel-diag">
                  <div class="panel-head">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <span>Diagnosis</span>
                  </div>
                  <div class="panel-diag-result" id="diag-result">
                    <span class="diag-badge" id="diag-badge">Fracture Detected</span>
                  </div>
                  <div class="panel-diag-meta" id="diag-meta">High confidence positive finding</div>
                </div>

                <div class="panel panel-conf" id="panel-conf">
                  <div class="panel-head">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    <span>Confidence Score</span>
                  </div>
                  <div class="panel-gauge-wrap">
                    <svg class="gauge-svg" viewBox="0 0 120 120">
                      <circle class="gauge-bg" cx="60" cy="60" r="50" fill="none" stroke="var(--color-bg-subtle)" stroke-width="8" />
                      <circle class="gauge-fill" id="gauge-fill" cx="60" cy="60" r="50" fill="none" stroke="var(--color-primary)" stroke-width="8" stroke-linecap="round" stroke-dasharray="314.16" stroke-dashoffset="220" transform="rotate(-90 60 60)" />
                      <text class="gauge-text" id="gauge-text" x="60" y="60" text-anchor="middle" dominant-baseline="central" font-size="22" font-weight="700" fill="currentColor">94.3%</text>
                    </svg>
                  </div>
                  <div class="panel-conf-label">Confidence</div>
                </div>

                <div class="panel panel-ood" id="panel-ood">
                  <div class="panel-head">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
                    <span>Novelty / OOD Score</span>
                  </div>
                  <div class="panel-ood-value" id="ood-value">18.4</div>
                  <div class="panel-ood-label">Low — in-distribution</div>
                  <div class="ood-bar-wrap">
                    <div class="ood-bar-fill" id="ood-bar-fill" style="width:18%"></div>
                  </div>
                </div>

                <div class="panel panel-report">
                  <div class="panel-head">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                    <span>Generate Report</span>
                  </div>
                  <div class="report-content">
                    <p class="report-desc">Download a comprehensive PDF report with all analysis results, images, and findings.</p>
                    <button class="report-btn" id="btn-report-download" data-ripple>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                      Download Report
                    </button>
                  </div>
                </div>
              </div>

              <div class="row row-mid" id="row-images">
                <div class="panel panel-img">
                  <div class="panel-head">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                    <span>Original X-ray</span>
                  </div>
                  <div class="panel-img-wrap">
                    <img id="img-original" class="panel-img" alt="Original X-ray" />
                    <div class="panel-img-empty" id="empty-original">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                      <span>No image</span>
                    </div>
                  </div>
                </div>
                <div class="panel panel-img">
                  <div class="panel-head">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                    <span>Predicted Heatmap</span>
                  </div>
                  <div class="panel-img-wrap">
                    <img id="img-heatmap" class="panel-img" alt="Heatmap" />
                    <div class="panel-img-empty" id="empty-heatmap">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                      <span>No image</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div id="patients-view" class="hidden">
              <div class="patients-header">
                <h2 class="patients-title">Patients</h2>
                <a href="/analyze" class="patients-add-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                  New Patient
                </a>
              </div>
              <div id="patients-list">
                <div class="patients-skeleton">
                  <div class="skeleton-row"></div>
                  <div class="skeleton-row"></div>
                  <div class="skeleton-row"></div>
                </div>
              </div>
              <div id="patients-empty" class="hidden">
                <div class="patients-empty-wrap">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                  <p class="patients-empty-title">No patients yet</p>
                  <p class="patients-empty-text">Add a patient when you start a new analysis.</p>
                  <a href="/analyze" class="history-empty-btn">New Analysis</a>
                </div>
              </div>
            </div>

            <div id="history-view" class="hidden">
              <div class="view-header">
                <button id="history-back" class="view-back-btn hidden" aria-label="Back to all analyses">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
                </button>
                <h2 class="view-title">Analysis History</h2>
              </div>
              <div id="history-list">
                <div class="patients-skeleton"><div class="skeleton-row"></div><div class="skeleton-row"></div><div class="skeleton-row"></div></div>
              </div>
              <div id="history-empty" class="hidden">
                <div class="patients-empty-wrap">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                  <p class="patients-empty-title">No analyses yet</p>
                  <p class="patients-empty-text">Run your first analysis to see it here.</p>
                  <a href="/analyze" class="history-empty-btn">New Analysis</a>
                </div>
              </div>
            </div>

            <div id="reports-view" class="hidden">
              <div class="view-header">
                <h2 class="view-title">Reports</h2>
              </div>
              <div id="reports-list">
                <div class="patients-skeleton"><div class="skeleton-row"></div><div class="skeleton-row"></div><div class="skeleton-row"></div></div>
              </div>
              <div id="reports-empty" class="hidden">
                <div class="patients-empty-wrap">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                  <p class="patients-empty-title">No reports yet</p>
                  <p class="patients-empty-text">Generated reports will appear here.</p>
                </div>
              </div>
            </div>

            <div id="settings-view" class="hidden">
              <div class="view-header">
                <h2 class="view-title">Settings</h2>
              </div>
              <div class="settings-card">
                <div class="settings-section">
                  <h3 class="settings-section-title">Profile</h3>
                  <div class="settings-row"><span class="settings-key">Name</span><span class="settings-val" id="settings-name">User</span></div>
                  <div class="settings-row"><span class="settings-key">Email</span><span class="settings-val" id="settings-email">user@example.com</span></div>
                </div>
                <div class="settings-section">
                  <h3 class="settings-section-title">Preferences</h3>
                  <div class="settings-row"><span class="settings-key">Notifications</span><span class="settings-val">Coming soon</span></div>
                  <div class="settings-row"><span class="settings-key">Theme</span><span class="settings-val">System</span></div>
                </div>
                <div class="settings-section">
                  <h3 class="settings-section-title">Account</h3>
                  <button class="settings-signout-btn" id="btn-settings-signout" data-ripple>Sign Out</button>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script type="module">
  import { isSignedIn, getUser, logout } from '../scripts/auth.js';

  var gate = document.getElementById('dash-gate');
  var dashUi = document.getElementById('dash-ui');

  var VIEWS = ['analysis-view', 'patients-view', 'history-view', 'reports-view', 'settings-view'];
  var VIEW_TITLES = {
    'analysis-view': 'Analysis Dashboard',
    'patients-view': 'Patients',
    'history-view': 'Analysis History',
    'reports-view': 'Reports',
    'settings-view': 'Settings'
  };
  var filteredPatientId = null;

  function showView(viewId) {
    var heading = document.getElementById('dash-heading');
    if (heading) heading.textContent = VIEW_TITLES[viewId] || 'Dashboard';
    VIEWS.forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.classList.toggle('hidden', id !== viewId);
    });
    document.querySelectorAll('.nav-item').forEach(function (el) { el.classList.remove('active'); });
    document.querySelectorAll('.nav-item').forEach(function (l) {
      var text = l.querySelector('span')?.textContent;
      if (text && text.toLowerCase() === (VIEW_TITLES[viewId] || '').toLowerCase()) l.classList.add('active');
    });
    if (viewId === 'patients-view') loadPatientsList();
    if (viewId === 'history-view') {
      filteredPatientId = null;
      var backBtn = document.getElementById('history-back');
      if (backBtn) backBtn.classList.add('hidden');
      var titleEl = document.querySelector('#history-view .view-title');
      if (titleEl) titleEl.textContent = 'Analysis History';
      loadHistoryList();
    }
  }

  async function init() {
    var signedIn = await isSignedIn();
    if (gate && dashUi) {
      if (signedIn) { gate.classList.add('hidden'); dashUi.classList.remove('hidden'); }
    }
    if (!signedIn) return;

    var user = await getUser();
    if (user) {
      document.getElementById('settings-name').textContent = user.name;
      document.getElementById('settings-email').textContent = user.email;
    }

    document.querySelectorAll('.nav-item').forEach(function (item) {
      item.addEventListener('click', function (e) {
        var text = this.querySelector('span')?.textContent;
        var map = { 'Dashboard': 'analysis-view', 'Patients': 'patients-view', 'History': 'history-view', 'Reports': 'reports-view', 'Settings': 'settings-view' };
        if (map[text]) { e.preventDefault(); showView(map[text]); }
      });
    });

    document.getElementById('dash-date').textContent = new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    document.getElementById('dash-refresh').addEventListener('click', function () { window.location.reload(); });
    document.getElementById('history-back').addEventListener('click', function () {
      filteredPatientId = null;
      document.getElementById('history-back').classList.add('hidden');
      document.querySelector('#history-view .view-title').textContent = 'Analysis History';
      showView('history-view');
    });
    document.getElementById('btn-settings-signout').addEventListener('click', function () {
      document.getElementById('sidebar-signout')?.click();
    });

    loadLastResult();
  }

  async function loadPatientsList() {
    var { getPatients } = await import('../scripts/patients.js');
    var patients = await getPatients();
    var list = document.getElementById('patients-list');
    var empty = document.getElementById('patients-empty');
    if (!patients.length) {
      list.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');
    list.innerHTML = patients.map(function (p) {
      var created = new Date(p.created_at).toLocaleDateString();
      var initials = p.name.split(' ').map(function (w) { return w.charAt(0); }).join('').toUpperCase().slice(0, 2);
      var ageGender = (p.age ? p.age + ' yrs' : '') + (p.gender ? ' &middot; ' + p.gender : '');
      var mrn = p.medical_record_id ? escapeHtml(p.medical_record_id) : '';
      return '<div class="patient-card" data-patient-id="' + p.id + '">' +
        '<div class="pc-avatar">' + initials + '</div>' +
        '<div class="pc-body">' +
          '<div class="pc-name">' + escapeHtml(p.name) + '</div>' +
          '<div class="pc-line">' + (ageGender || '—') + (mrn ? ' <span class="pc-mrn">' + mrn + '</span>' : '') + '</div>' +
          '<div class="pc-line pc-date">Registered ' + created + '</div>' +
        '</div>' +
        '<div class="pc-arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg></div>' +
      '</div>';
    }).join('');
    list.querySelectorAll('.patient-card').forEach(function (card) {
      card.addEventListener('click', function () {
        showPatientScans(card.getAttribute('data-patient-id'), card.querySelector('.pc-name').textContent);
      });
    });
  }

  async function showPatientScans(patientId, patientName) {
    var { getPatient } = await import('../scripts/patients.js');
    var patient = await getPatient(patientId);
    var name = patientName || (patient ? patient.name : 'Patient');
    var historyTitle = document.querySelector('#history-view .view-title');
    if (historyTitle) historyTitle.textContent = name + '\'s Scans';
    var historyBack = document.getElementById('history-back');
    if (historyBack) historyBack.classList.remove('hidden');
    filteredPatientId = patientId;
    loadHistoryList(patientId);
    showView('history-view');
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  async function loadHistoryList(patientId) {
    var { getAnalyses } = await import('../scripts/api.js');
    var analyses = await getAnalyses();
    var list = document.getElementById('history-list');
    var empty = document.getElementById('history-empty');
    if (patientId) analyses = analyses.filter(function (a) { return a.patient_id === patientId; });
    if (!analyses.length) {
      list.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');
    list.innerHTML = analyses.map(function (a) {
      var date = new Date(a.created_at).toLocaleString();
      var isFracture = a.prediction === 'fracture';
      var badgeClass = isFracture ? 'history-badge-danger' : 'history-badge-safe';
      var label = isFracture ? 'Fracture' : 'Normal';
      return '<div class="history-card">' +
        '<div class="history-card-left">' +
          '<span class="history-badge ' + badgeClass + '">' + label + '</span>' +
          '<span class="history-conf">' + (a.confidence * 100).toFixed(1) + '%</span>' +
        '</div>' +
        '<div class="history-card-mid">' +
          '<span class="history-date">' + date + '</span>' +
          '<span class="history-id">' + (a.id || '—') + '</span>' +
        '</div>' +
        '<div class="history-card-right">' +
          '<a href="/results" class="history-view-link">View</a>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  function loadLastResult() {
    var imgData = sessionStorage.getItem('fracturedetect:image');
    var resultData = sessionStorage.getItem('fracturedetect:result');
    if (!resultData) return;

    var result = JSON.parse(resultData);
    var isFracture = result.prediction === 'fracture';
    var confNum = parseFloat((result.confidence * 100).toFixed(1));

    var diagBadge = document.getElementById('diag-badge');
    var diagMeta = document.getElementById('diag-meta');
    if (isFracture) {
      diagBadge.textContent = 'Fracture Detected';
      diagBadge.style.color = 'var(--color-danger)';
      diagBadge.style.background = 'rgba(220,38,38,0.1)';
      diagMeta.textContent = 'High confidence positive finding';
    } else {
      diagBadge.textContent = 'Normal';
      diagBadge.style.color = 'var(--color-success)';
      diagBadge.style.background = 'rgba(22,163,74,0.1)';
      diagMeta.textContent = 'No fracture detected';
    }

    var gaugeFill = document.getElementById('gauge-fill');
    var gaugeText = document.getElementById('gauge-text');
    var circumference = 314.16;
    var offset = circumference - (confNum / 100) * circumference;
    if (gaugeFill) {
      gaugeFill.style.strokeDashoffset = offset;
      gaugeFill.style.stroke = isFracture ? 'var(--color-danger)' : 'var(--color-success)';
    }
    if (gaugeText) gaugeText.textContent = confNum + '%';

    var oodScore = 18.4;
    var oodValue = document.getElementById('ood-value');
    var oodFill = document.getElementById('ood-bar-fill');
    if (oodValue) oodValue.textContent = oodScore.toFixed(1);
    if (oodFill) oodFill.style.width = Math.min(oodScore, 100) + '%';

    if (imgData) {
      var orig = document.getElementById('img-original');
      var heat = document.getElementById('img-heatmap');
      if (orig) { orig.src = imgData; document.getElementById('empty-original')?.classList.add('hidden'); }
      if (heat) { heat.src = imgData; document.getElementById('empty-heatmap')?.classList.add('hidden'); }
    }

    var downloadBtn = document.getElementById('btn-report-download');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', function () {
        var canvas = document.createElement('canvas');
        var ctx = canvas.getContext('2d');
        canvas.width = 800;
        var imgW = 400, imgH = 300;
        var findingsText = isFracture
          ? ['Bone discontinuity detected in the forearm region', 'Fracture localized to the mid-shaft of the radius', 'No signs of comminution or displacement detected']
          : ['No visible bone discontinuity detected', 'Bone alignment appears normal', 'No suspicious abnormalities identified'];
        canvas.height = 700 + imgH + findingsText.length * 28;

        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#0F172A';
        ctx.font = 'bold 26px Poppins, sans-serif';
        ctx.fillText('FractureDetect Analysis Report', 40, 50);
        ctx.fillStyle = '#475569';
        ctx.font = '14px Inter, sans-serif';
        ctx.fillText('Generated: ' + new Date().toLocaleString(), 40, 80);
        ctx.strokeStyle = '#E2E8F0';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(40, 100); ctx.lineTo(760, 100); ctx.stroke();

        ctx.fillStyle = '#0F172A';
        ctx.font = 'bold 20px Poppins, sans-serif';
        ctx.fillText('Prediction: ' + diagBadge.textContent, 40, 140);
        ctx.fillStyle = isFracture ? '#DC2626' : '#16A34A';
        ctx.font = 'bold 40px Poppins, sans-serif';
        ctx.fillText(confNum + '%', 40, 190);
        ctx.fillStyle = '#475569';
        ctx.font = '14px Inter, sans-serif';
        ctx.fillText('Confidence Score', 40, 210);
        ctx.fillStyle = '#0F172A';
        ctx.font = '15px Inter, sans-serif';
        ctx.fillText('Inference Time: ' + (result.inferenceTimeSec || 0).toFixed(2) + ' sec', 40, 248);
        ctx.fillText('Model Version: v2.1.0', 40, 272);

        ctx.strokeStyle = '#E2E8F0'; ctx.beginPath(); ctx.moveTo(40, 296); ctx.lineTo(760, 296); ctx.stroke();
        ctx.fillStyle = '#0F172A'; ctx.font = 'bold 16px Poppins, sans-serif';
        ctx.fillText('Findings Summary', 40, 325);
        ctx.fillStyle = '#334155'; ctx.font = '14px Inter, sans-serif';
        findingsText.forEach(function (t, i) { ctx.fillText('\u2022  ' + t, 40, 353 + i * 28); });

        var findingsEndY = 353 + findingsText.length * 28;
        ctx.strokeStyle = '#E2E8F0'; ctx.beginPath(); ctx.moveTo(40, findingsEndY + 8); ctx.lineTo(760, findingsEndY + 8); ctx.stroke();
        ctx.fillStyle = '#0F172A'; ctx.font = 'bold 16px Poppins, sans-serif';
        ctx.fillText('X-ray Image', 40, findingsEndY + 40);

        var imgX = Math.round((canvas.width - imgW) / 2);
        var origImg = document.getElementById('img-original');
        if (origImg && origImg.src) ctx.drawImage(origImg, imgX, findingsEndY + 56, imgW, imgH);

        if (isFracture) {
          var overlay = document.createElement('canvas');
          overlay.width = imgW; overlay.height = imgH;
          var octx = overlay.getContext('2d');
          var gradient = octx.createRadialGradient(imgW * 0.42, imgH * 0.52, 0, imgW * 0.42, imgH * 0.52, imgW * 0.5);
          gradient.addColorStop(0, 'rgba(255, 50, 0, 0.5)');
          gradient.addColorStop(0.18, 'rgba(255, 130, 0, 0.35)');
          gradient.addColorStop(0.38, 'rgba(255, 220, 0, 0.2)');
          gradient.addColorStop(1, 'transparent');
          octx.fillStyle = gradient; octx.fillRect(0, 0, imgW, imgH);
          ctx.drawImage(overlay, imgX, findingsEndY + 56, imgW, imgH);
        }

        var imgBottomY = findingsEndY + 56 + imgH + 24;
        ctx.strokeStyle = '#E2E8F0'; ctx.beginPath(); ctx.moveTo(40, imgBottomY); ctx.lineTo(760, imgBottomY); ctx.stroke();
        ctx.fillStyle = '#475569'; ctx.font = '13px Inter, sans-serif';
        ctx.fillText('This result is intended to assist healthcare professionals and should not replace', 40, imgBottomY + 24);
        ctx.fillText('professional medical diagnosis.', 40, imgBottomY + 44);

        var link = document.createElement('a');
        link.download = 'fracturedetect-report.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }
  }

  init();
</script>

