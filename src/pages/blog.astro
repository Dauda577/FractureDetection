---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Blog" description="FractureDetect Blog - AI in medical imaging, fracture detection research, and product updates" active="blog" variant="marketing">
  <main class="page-enter">
    <section class="hero blog-hero">
      <div class="hero-container">
        <div class="hero-content reveal" style="transition-delay:0.1s">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            Blog
          </div>
          <h1 class="hero-title">Insights on <span class="text-gradient">AI</span> in Medical Imaging</h1>
          <p class="hero-description">
            Research insights, product updates, and stories from the intersection of deep learning and clinical radiology.
          </p>
        </div>
      </div>
    </section>

    <section class="blog-posts reveal" style="transition-delay:0.1s">
      <div class="posts-grid">
        <article class="post-card">
          <div class="post-category">Research</div>
          <div class="post-date">July 24, 2026</div>
          <h2 class="post-title">How We Built a 98.5% Accurate Fracture Detection Model</h2>
          <p class="post-excerpt">A deep dive into our CNN architecture, training pipeline, and validation methodology across 50,000+ radiographs from five institutions.</p>
          <div class="post-meta">
            <span class="post-author">Michael Rodriguez</span>
            <span class="post-read">8 min read</span>
          </div>
        </article>
        <article class="post-card">
          <div class="post-category">Engineering</div>
          <div class="post-date">July 18, 2026</div>
          <h2 class="post-title">Scaling Medical AI Inference to Sub-5-Second Response Times</h2>
          <p class="post-excerpt">How we optimized our PyTorch inference pipeline with ONNX Runtime, model quantization, and edge deployment strategies.</p>
          <div class="post-meta">
            <span class="post-author">James Park</span>
            <span class="post-read">6 min read</span>
          </div>
        </article>
        <article class="post-card">
          <div class="post-category">Clinical</div>
          <div class="post-date">July 10, 2026</div>
          <h2 class="post-title">10 Common Fractures AI Can Help Radiologists Detect Faster</h2>
          <p class="post-excerpt">From distal radius to femoral neck fractures — a clinical overview of how AI assists in emergency and routine radiology workflows.</p>
          <div class="post-meta">
            <span class="post-author">Dr. Sarah Chen</span>
            <span class="post-read">5 min read</span>
          </div>
        </article>
        <article class="post-card">
          <div class="post-category">Product</div>
          <div class="post-date">July 3, 2026</div>
          <h2 class="post-title">Introducing Batch Analysis: Process Multiple X-Rays in One Click</h2>
          <p class="post-excerpt">Our new batch upload feature lets clinicians queue multiple images and review results sequentially with progress tracking.</p>
          <div class="post-meta">
            <span class="post-author">Dr. Anjali Kumar</span>
            <span class="post-read">4 min read</span>
          </div>
        </article>
        <article class="post-card">
          <div class="post-category">Research</div>
          <div class="post-date">June 26, 2026</div>
          <h2 class="post-title">Out-of-Distribution Detection: Why It Matters for Medical AI</h2>
          <p class="post-excerpt">How we use novelty scoring to flag images that differ significantly from training data, preventing silent model failures in production.</p>
          <div class="post-meta">
            <span class="post-author">Michael Rodriguez</span>
            <span class="post-read">7 min read</span>
          </div>
        </article>
        <article class="post-card">
          <div class="post-category">Regulatory</div>
          <div class="post-date">June 20, 2026</div>
          <h2 class="post-title">Navigating FDA Clearance for AI-Powered Medical Device Software</h2>
          <p class="post-excerpt">A practical guide to the 510(k) pathway, SaMD classification, and building a quality management system for ML-based diagnostics.</p>
          <div class="post-meta">
            <span class="post-author">Dr. Anjali Kumar</span>
            <span class="post-read">10 min read</span>
          </div>
        </article>
      </div>
      <div class="blog-cta">
        <div class="newsletter-inline">
          <div>
            <h3>Stay up to date</h3>
            <p>Get the latest posts delivered to your inbox.</p>
          </div>
          <form class="blog-sub-form" onsubmit="event.preventDefault();var i=this.querySelector('input');if(i.value){window.showToast({message:'Subscribed!',type:'success'});i.value=''}">
            <input type="email" placeholder="your@email.com" class="blog-sub-input" required />
            <button type="submit" class="blog-sub-btn">Subscribe</button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-hero { padding: 80px 24px 48px; text-align: center; }
  .hero-container { max-width: var(--max-width); margin: 0 auto; }
  .hero-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-primary); background: rgba(37,99,235,0.08); padding: 6px 14px; border-radius: 20px; margin-bottom: 24px; letter-spacing: 0.02em; text-transform: uppercase; }
  .hero-title { font-family: var(--font-heading); font-weight: 600; font-size: 44px; line-height: 1.15; color: var(--color-text); margin: 0 0 16px; letter-spacing: -0.02em; }
  .text-gradient { background: linear-gradient(135deg, var(--color-primary), #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .hero-description { font-family: var(--font-body); font-size: 18px; line-height: 1.65; color: var(--color-text-muted); margin: 0 auto; max-width: 560px; }
  .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-primary); animation: pulse-dot 2s ease-in-out infinite; }
  @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .blog-posts { padding: 0 24px 80px; }
  .posts-grid { max-width: var(--max-width); margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 48px; }
  .post-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 28px; transition: all 0.25s ease; display: flex; flex-direction: column; gap: 0; }
  .post-card:hover { border-color: rgba(37,99,235,0.3); box-shadow: 0 8px 32px rgba(37,99,235,0.15); transform: translateY(-4px); }
  .post-category { display: inline-block; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-primary); background: rgba(37,99,235,0.08); padding: 4px 10px; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 10px; width: fit-content; }
  .post-date { font-family: var(--font-body); font-size: 13px; color: var(--color-text-muted); margin-bottom: 14px; }
  .post-title { font-family: var(--font-heading); font-weight: 600; font-size: 20px; line-height: 1.3; color: var(--color-text); margin: 0 0 10px; letter-spacing: -0.01em; }
  .post-excerpt { font-family: var(--font-body); font-size: 14px; line-height: 1.6; color: var(--color-text-muted); margin: 0 0 20px; flex: 1; }
  .post-meta { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-border); padding-top: 14px; }
  .post-author { font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-text); }
  .post-read { font-family: var(--font-body); font-size: 12px; color: var(--color-text-muted); }

  .blog-cta { max-width: var(--max-width); margin: 0 auto; }
  .newsletter-inline { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 32px 36px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .newsletter-inline h3 { font-family: var(--font-heading); font-weight: 600; font-size: 18px; color: var(--color-text); margin: 0 0 4px; }
  .newsletter-inline p { font-family: var(--font-body); font-size: 14px; color: var(--color-text-muted); margin: 0; }
  .blog-sub-form { display: flex; gap: 8px; flex-shrink: 0; }
  .blog-sub-input { font-family: var(--font-body); font-size: 14px; color: var(--color-text); background: var(--color-bg-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 11px 16px; outline: none; width: 240px; max-width: 100%; transition: all 0.15s; }
  .blog-sub-input:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
  .blog-sub-btn { font-family: var(--font-body); font-weight: 600; font-size: 14px; color: white; background: linear-gradient(135deg, var(--color-primary), #1d4ed8); border: none; border-radius: var(--radius-md); padding: 11px 22px; cursor: pointer; white-space: nowrap; transition: all 0.2s; box-shadow: 0 4px 12px rgba(37,99,235,0.25); }
  .blog-sub-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(37,99,235,0.35); }

  @media (max-width: 1024px) {
    .hero-title { font-size: 38px; }
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero-title { font-size: 30px; }
    .hero-description { font-size: 16px; }
    .posts-grid { grid-template-columns: 1fr; }
    .newsletter-inline { flex-direction: column; align-items: flex-start; }
    .blog-sub-form { width: 100%; }
    .blog-sub-input { flex: 1; width: auto; }
  }
  @media (max-width: 480px) {
    .hero-title { font-size: 24px; }
    .hero-description { font-size: 15px; }
    .newsletter-inline { padding: 24px 20px; }
  }
</style>
