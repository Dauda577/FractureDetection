---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Analyze" description="Upload an X-ray image for fracture detection" active="analyze" variant="marketing">
  <main class="analyze-page page-enter">
    <div class="auth-bg">
      <div class="auth-orb orb-1 fd-orb-drift" style="--float-duration:20s"></div>
      <div class="auth-orb orb-2 fd-orb-drift" style="--float-duration:16s;--float-delay:-5s"></div>
    </div>
    <div class="analyze-container">
      <div class="analyze-card">
        <div class="analyze-header">
          <div class="analyze-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            </svg>
          </div>
          <h1 class="analyze-title">Fracture Analysis</h1>
          <p class="analyze-subtitle">Upload an X-ray image to detect bone fractures</p>
        </div>
        <div id="analyze-loading" class="analyze-loading">
          <div class="loading-spinner"></div>
          <p class="loading-text">Loading...</p>
        </div>
        <div class="auth-demo hidden" id="auth-demo">
          <div class="demo-header">
            <svg class="demo-lock" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            <h2 class="demo-title">Sign in required</h2>
            <p class="demo-desc">Sign in or create an account to upload X-rays and get fracture analysis results.</p>
          </div>
          <div class="demo-actions">
            <a href="/signin" class="demo-btn-primary">Sign In</a>
            <a href="/signup" class="demo-btn-secondary">Create Account</a>
          </div>
        </div>
        <div class="welcome-signedin hidden" id="welcome-signedin">
          <div class="welcome-content">
            <svg class="welcome-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            </svg>
            <h2 class="welcome-title">Ready to analyze</h2>
            <p class="welcome-desc">Upload an X-ray image to get started with fracture detection. You can save results and download reports.</p>
            <button type="button" class="welcome-btn" id="btn-welcome-start">New Analysis</button>
          </div>
        </div>
        <div class="patient-ui hidden" id="patient-ui">
          <div class="patient-header">
            <h2 class="patient-title">Patient Information</h2>
            <p class="patient-desc">Enter patient details before uploading the X-ray. This info will appear on the report.</p>
          </div>
          <form id="patient-form" class="patient-form" novalidate>
            <div class="patient-fields">
              <div class="field">
                <label class="field-label" for="pt-name">Patient Name <span class="required">*</span></label>
                <input class="field-input" id="pt-name" name="name" type="text" placeholder="Full name" required autocomplete="off" />
              </div>
              <div class="field-row">
                <div class="field">
                  <label class="field-label" for="pt-age">Age <span class="required">*</span></label>
                  <input class="field-input" id="pt-age" name="age" type="number" min="0" max="150" placeholder="Years" required autocomplete="off" />
                </div>
                <div class="field">
                  <label class="field-label" for="pt-gender">Gender <span class="required">*</span></label>
                  <select class="field-input" id="pt-gender" name="gender" required autocomplete="off">
                    <option value="">Select...</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>
              <div class="field">
                <label class="field-label" for="pt-mrn">Medical Record ID <span class="required">*</span></label>
                <input class="field-input" id="pt-mrn" name="mrn" type="text" placeholder="e.g. MRN-12345" required autocomplete="off" />
              </div>
              <div class="field">
                <label class="field-label" for="pt-notes">Clinical Notes</label>
                <textarea class="field-input" id="pt-notes" name="notes" rows="2" placeholder="Relevant history or symptoms..." autocomplete="off"></textarea>
              </div>
            </div>
            <div class="patient-error hidden" id="patient-error" role="alert"></div>
            <button type="submit" class="patient-continue" id="patient-continue">Continue to Upload</button>
          </form>
        </div>
        <div class="upload-ui hidden" id="upload-ui">
          <div id="patient-badge" class="patient-badge hidden"></div>
          <div class="upload-header">
            <h2 class="upload-title">Upload X-ray</h2>
            <p class="upload-subtitle">Supported: PNG, JPEG (max 10 MB). The image must be a grayscale bone X-ray.</p>
          </div>
          <div class="upload-dropzone" id="upload-dropzone">
            <div class="dropzone-content">
              <svg class="dropzone-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" y1="3" x2="12" y2="15" />
              </svg>
              <p class="dropzone-text">Drag & drop X-ray here or <span class="dropzone-browse">browse</span></p>
              <p class="dropzone-hint">Grayscale PNG or JPEG under 10 MB</p>
            </div>
            <input type="file" id="file-input" accept="image/png,image/jpeg" class="file-input-hidden" multiple />
          </div>
          <div class="upload-preview hidden" id="upload-preview">
            <div class="preview-grid" id="preview-grid"></div>
          </div>
          <div class="error-msg hidden" id="upload-error" role="alert"></div>
          <div class="upload-action">
            <button class="btn-analyze hidden" id="btn-analyze">Analyze</button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script type="module">
  import { isSignedIn, getSupabase, getUserId } from '../scripts/auth.js';
  import { savePatient, checkMrnUnique } from '../scripts/patients.js';
  import { runInference } from '../scripts/inference.js';

  var currentPatientId = sessionStorage.getItem('fracturedetect:patient_id') || null;
  var currentPatientName = sessionStorage.getItem('fracturedetect:patient_name') || null;
  var currentPatientMrn = sessionStorage.getItem('fracturedetect:patient_mrn') || null;
  var fromResults = sessionStorage.getItem('fracturedetect:from_results');

  var upload = document.getElementById('upload-ui');
  var patientUi = document.getElementById('patient-ui');
  var welcome = document.getElementById('welcome-signedin');
  var btnWelcomeStart = document.getElementById('btn-welcome-start');
  var btnAnalyze = document.getElementById('btn-analyze');
  var fileInput = document.getElementById('file-input');
  var dropzone = document.getElementById('upload-dropzone');
  var previewGrid = document.getElementById('preview-grid');
  var previewSection = document.getElementById('upload-preview');
  var uploadError = document.getElementById('upload-error');
  var patientBadge = document.getElementById('patient-badge');
  var patientForm = document.getElementById('patient-form');
  var patientError = document.getElementById('patient-error');
  var patientContinue = document.getElementById('patient-continue');
  var demoSection = document.getElementById('auth-demo');
  var loadingEl = document.getElementById('analyze-loading');

  var fileQueue = [];

  if (currentPatientId && currentPatientName) {
    renderPatientBadge();
  }

  function renderPatientBadge() {
    if (!patientBadge || !currentPatientName) return;
    patientBadge.classList.remove('hidden');
    var parts = [currentPatientName];
    if (currentPatientMrn) parts.push('MRN: ' + currentPatientMrn);
    patientBadge.innerHTML = '<span class="badge-label">Patient:</span> <span class="badge-value">' + parts.join(' &middot; ') + '</span>' +
      ' <button type="button" class="badge-change" id="btn-change-patient">Change</button>';
    document.getElementById('btn-change-patient')?.addEventListener('click', function () {
      currentPatientId = null;
      currentPatientName = null;
      currentPatientMrn = null;
      sessionStorage.removeItem('fracturedetect:patient_id');
      sessionStorage.removeItem('fracturedetect:patient_name');
      sessionStorage.removeItem('fracturedetect:patient_mrn');
      upload.classList.add('hidden');
      patientUi.classList.remove('hidden');
      patientBadge.classList.add('hidden');
    });
  }

  btnWelcomeStart?.addEventListener('click', function () {
    welcome.classList.add('hidden');
    patientUi.classList.remove('hidden');
  });

  patientForm?.addEventListener('submit', async function (e) {
    e.preventDefault();
    patientError.classList.add('hidden');
    patientContinue.disabled = true;
    patientContinue.textContent = 'Saving...';

    var name = patientForm.name.value.trim();
    var age = patientForm.age.value.trim();
    var gender = patientForm.gender.value;
    var mrn = patientForm.mrn.value.trim();
    var notes = patientForm.notes.value.trim();

    if (!name) {
      patientError.textContent = 'Patient name is required.';
      patientError.classList.remove('hidden');
      patientContinue.disabled = false;
      patientContinue.textContent = 'Continue to Upload';
      return;
    }

    if (!age || !gender || !mrn) {
      patientError.textContent = 'Please fill in all required fields (Name, Age, Gender, Medical Record ID).';
      patientError.classList.remove('hidden');
      patientContinue.disabled = false;
      patientContinue.textContent = 'Continue to Upload';
      return;
    }

    var mrnUnique = await checkMrnUnique(mrn);
    if (!mrnUnique) {
      patientError.textContent = 'This Medical Record ID is already in use. Please use a different one.';
      patientError.classList.remove('hidden');
      patientContinue.disabled = false;
      patientContinue.textContent = 'Continue to Upload';
      return;
    }

    var patientId = await savePatient(name, parseInt(age), gender, mrn, notes || null);
    if (patientId) {
      currentPatientId = patientId;
      currentPatientName = name;
      currentPatientMrn = mrn;
      sessionStorage.setItem('fracturedetect:patient_id', patientId);
      sessionStorage.setItem('fracturedetect:patient_name', name);
      sessionStorage.setItem('fracturedetect:patient_mrn', mrn);
      renderPatientBadge();
      patientUi.classList.add('hidden');
      upload.classList.remove('hidden');
    } else {
      patientError.textContent = 'Failed to save patient info. Please try again.';
      patientError.classList.remove('hidden');
    }

    patientContinue.disabled = false;
    patientContinue.textContent = 'Continue to Upload';
  });

  function storeAndNavigate() {
    if (!currentPatientId) {
      uploadError.textContent = 'Please select or create a patient before analyzing.';
      uploadError.classList.remove('hidden');
      return;
    }
    if (fileQueue.length === 0) {
      uploadError.textContent = 'Please upload at least one X-ray image.';
      uploadError.classList.remove('hidden');
      return;
    }
    var reader = new FileReader();
    reader.onload = function (ev) {
      sessionStorage.setItem('fracturedetect:xray', ev.target.result);
      sessionStorage.setItem('fracturedetect:xray_name', fileQueue[0].name);
      window.location.href = '/processing';
    };
    reader.readAsDataURL(fileQueue[0]);
  }

  btnAnalyze?.addEventListener('click', storeAndNavigate);

  dropzone?.addEventListener('click', function () { fileInput.click(); });
  fileInput?.addEventListener('change', function () {
    if (fileInput.files && fileInput.files.length > 0) {
      addFiles(fileInput.files);
    }
  });

  dropzone?.addEventListener('dragover', function (e) {
    e.preventDefault();
    dropzone.classList.add('dropzone-active');
  });
  dropzone?.addEventListener('dragleave', function () {
    dropzone.classList.remove('dropzone-active');
  });
  dropzone?.addEventListener('drop', function (e) {
    e.preventDefault();
    dropzone.classList.remove('dropzone-active');
    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      addFiles(e.dataTransfer.files);
    }
  });

  const ALLOWED_TYPES = ['image/png', 'image/jpeg'];
  const MAX_SIZE = 10 * 1024 * 1024;

  function isValidFile(file) {
    return ALLOWED_TYPES.includes(file.type) && file.size <= MAX_SIZE;
  }

  function isGrayscaleImage(file) {
    return new Promise(function (resolve) {
      var img = new Image();
      var objectUrl = URL.createObjectURL(file);
      img.onload = function () {
        URL.revokeObjectURL(objectUrl);
        var canvas = document.createElement('canvas');
        var ctx = canvas.getContext('2d');
        var sampleStep = 4;
        var w = Math.min(img.naturalWidth, 512);
        var h = Math.min(img.naturalHeight, 512);
        canvas.width = w;
        canvas.height = h;
        ctx.drawImage(img, 0, 0, w, h);
        var imageData = ctx.getImageData(0, 0, w, h);
        var pixels = imageData.data;
        var total = 0;
        var grayscale = 0;
        var pixelThreshold = 15;
        var sumR = 0, sumG = 0, sumB = 0;
        for (var i = 0; i < pixels.length; i += 4 * sampleStep) {
          total++;
          var r = pixels[i];
          var g = pixels[i + 1];
          var b = pixels[i + 2];
          sumR += r; sumG += g; sumB += b;
          if (Math.abs(r - g) < pixelThreshold && Math.abs(r - b) < pixelThreshold && Math.abs(g - b) < pixelThreshold) {
            grayscale++;
          }
        }
        if (total === 0) { resolve(false); return; }
        var pixelRatio = grayscale / total;
        var avgR = sumR / total, avgG = sumG / total, avgB = sumB / total;
        var globalGray = Math.abs(avgR - avgG) < 25 && Math.abs(avgR - avgB) < 25 && Math.abs(avgG - avgB) < 25;
        resolve(pixelRatio >= 0.90 || globalGray);
      };
      img.onerror = function () {
        URL.revokeObjectURL(objectUrl);
        resolve(false);
      };
    });
  }

  function addFiles(files) {
    uploadError.classList.add('hidden');
    var validFiles = [];
    var errors = [];
    for (var i = 0; i < files.length; i++) {
      var file = files[i];
      if (!file) continue;
      if (!isValidFile(file)) {
        errors.push('"' + file.name + '" - must be PNG or JPEG under 10MB.');
        continue;
      }
      validFiles.push(file);
    }
    if (validFiles.length === 0) {
      if (errors.length > 0) {
        uploadError.textContent = errors.join(' ');
        uploadError.classList.remove('hidden');
      }
      return;
    }
    var grayscaleChecks = validFiles.map(function (file) {
      return isGrayscaleImage(file).then(function (isGray) {
        return { file: file, isGray: isGray };
      });
    });
    Promise.all(grayscaleChecks).then(function (results) {
      var grayscaleErrors = [];
      fileQueue = [];
      for (var j = 0; j < results.length; j++) {
        var r = results[j];
        if (!r.isGray) {
          grayscaleErrors.push('"' + r.file.name + '" Invalid image: Please upload a valid bone X-ray image.');
        } else {
          fileQueue.push(r.file);
        }
      }
      if (grayscaleErrors.length > 0) {
        uploadError.textContent = grayscaleErrors.join(' ');
        uploadError.classList.remove('hidden');
      }
      if (fileQueue.length === 0) return;
      renderPreview();
      btnAnalyze.classList.remove('hidden');
    });
  }

  function removeFile(index) {
    fileQueue.splice(index, 1);
    if (fileQueue.length === 0) {
      previewSection.classList.add('hidden');
      btnAnalyze.classList.add('hidden');
      previewGrid.innerHTML = '';
    } else {
      renderPreview();
    }
  }

  function renderPreview() {
    previewSection.classList.remove('hidden');
    previewGrid.innerHTML = '';
    for (var i = 0; i < fileQueue.length; i++) {
      var file = fileQueue[i];
      var reader = new FileReader();
      (function (idx, f) {
        reader.onload = function (ev) {
          var card = document.createElement('div');
          card.className = 'preview-card';
          card.innerHTML = '<img src="' + ev.target.result + '" alt="X-ray preview" class="preview-thumb" />' +
            '<div class="preview-info">' +
            '<span class="preview-name">' + f.name + '</span>' +
            '<span class="preview-size">' + (f.size / 1024).toFixed(1) + ' KB</span>' +
            '</div>' +
            '<button class="preview-remove" data-index="' + idx + '" title="Remove">&times;</button>';
          card.querySelector('.preview-remove')?.addEventListener('click', function (ev) {
            ev.stopPropagation();
            removeFile(idx);
          });
          previewGrid.appendChild(card);
        };
      })(i, file);
      reader.readAsDataURL(file);
    }
  }

  (async function init() {
    var signedIn = await isSignedIn();
    if (loadingEl) loadingEl.classList.add('hidden');
    if (!signedIn) {
      demoSection.classList.remove('hidden');
      return;
    }
    if (currentPatientId) {
      var fromResults = sessionStorage.getItem('fracturedetect:from_results');
      if (fromResults) {
        if (patientUi) patientUi.classList.remove('hidden');
      } else {
        if (upload) upload.classList.remove('hidden');
        loadPatientBadge();
      }
    } else {
      if (welcome) welcome.classList.remove('hidden');
    }
  })();

  function loadPatientBadge() {
    if (currentPatientId && currentPatientName) {
      renderPatientBadge();
    }
  }
</script>

<style>
  .analyze-page { min-height: calc(100vh - 68px); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .auth-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .auth-orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.08; }
  .auth-orb.orb-1 { width: 400px; height: 400px; background: var(--color-primary); top: -120px; right: -80px; }
  .auth-orb.orb-2 { width: 300px; height: 300px; background: #a855f7; bottom: -100px; left: -60px; }
  .analyze-container { max-width: 520px; width: 100%; padding: 24px; position: relative; z-index: 1; }
  .analyze-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 40px 32px 32px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
  .analyze-header { text-align: center; margin-bottom: 32px; }
  .analyze-icon { width: 48px; height: 48px; border-radius: 14px; background: var(--color-primary); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px; }
  .analyze-title { font-family: var(--font-heading); font-weight: 600; font-size: 24px; color: var(--color-text); margin: 0 0 8px; letter-spacing: -0.02em; }
  .analyze-subtitle { font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted); margin: 0; }
  .analyze-loading { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 48px 0; }
  .loading-spinner { width: 36px; height: 36px; border: 3px solid var(--color-border); border-top-color: var(--color-primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .loading-text { font-family: var(--font-body); font-size: 14px; color: var(--color-text-muted); margin: 0; }
  .auth-demo { text-align: center; }
  .demo-header { margin-bottom: 28px; }
  .demo-lock { color: #94a3b8; margin-bottom: 16px; }
  .demo-title { font-family: var(--font-heading); font-weight: 600; font-size: 20px; color: var(--color-text); margin: 0 0 8px; }
  .demo-desc { font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted); margin: 0; line-height: 1.5; }
  .demo-actions { display: flex; gap: 12px; justify-content: center; }
  .demo-btn-primary { font-family: var(--font-body); font-weight: 600; font-size: 15px; color: white; background: linear-gradient(135deg, var(--color-primary), #1d4ed8); padding: 12px 32px; border-radius: var(--radius-md); text-decoration: none; transition: all 0.2s; box-shadow: 0 4px 12px rgba(37,99,235,0.25); }
  .demo-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,0.35); }
  .demo-btn-secondary { font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-border); padding: 12px 32px; border-radius: var(--radius-md); text-decoration: none; transition: all 0.15s; }
  .demo-btn-secondary:hover { background: var(--color-bg-subtle); border-color: var(--color-border-strong); }
  .welcome-signedin { text-align: center; }
  .welcome-content { padding: 8px 0; }
  .welcome-icon { color: var(--color-primary); margin-bottom: 16px; }
  .welcome-title { font-family: var(--font-heading); font-weight: 600; font-size: 22px; color: var(--color-text); margin: 0 0 8px; }
  .welcome-desc { font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted); margin: 0 0 24px; line-height: 1.5; max-width: 360px; margin-left: auto; margin-right: auto; }
  .welcome-btn { font-family: var(--font-body); font-weight: 600; font-size: 15px; color: white; background: linear-gradient(135deg, var(--color-primary), #1d4ed8); padding: 12px 36px; border: none; border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(37,99,235,0.25); }
  .welcome-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,0.35); }
  .patient-ui { }
  .patient-header { margin-bottom: 24px; }
  .patient-title { font-family: var(--font-heading); font-weight: 600; font-size: 20px; color: var(--color-text); margin: 0 0 6px; }
  .patient-desc { font-family: var(--font-body); font-size: 14px; color: var(--color-text-muted); margin: 0; }
  .patient-form { display: flex; flex-direction: column; gap: 20px; }
  .patient-fields { display: flex; flex-direction: column; gap: 16px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .hidden { display: none !important; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label { font-family: var(--font-body); font-weight: 500; font-size: 14px; color: var(--color-text); }
  .required { color: var(--color-danger); }
  .field-input { font-family: var(--font-body); font-size: 15px; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 10px 14px; outline: none; transition: border-color 0.15s, box-shadow 0.15s; resize: vertical; }
  .field-input::placeholder { color: #94a3b8; }
  .field-input:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
  textarea.field-input { min-height: 60px; }
  .patient-error { font-family: var(--font-body); font-size: 14px; color: var(--color-danger); background: rgba(220,38,38,0.06); padding: 10px 14px; border-radius: var(--radius-md); }
  .patient-continue { font-family: var(--font-body); font-weight: 600; font-size: 15px; color: white; background: linear-gradient(135deg, var(--color-primary), #1d4ed8); padding: 12px 24px; border: none; border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(37,99,235,0.25); }
  .patient-continue:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,0.35); }
  .patient-continue:disabled { opacity: 0.6; cursor: default; transform: none; box-shadow: none; }
  .upload-ui { }
  .upload-header { margin-bottom: 20px; }
