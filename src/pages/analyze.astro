---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Upload" description="Upload X-ray images for AI-powered fracture analysis" active="analyze" variant="app">
  <main class="analyze-page page-enter">
    <div class="analyze-bg">
      <div class="analyze-orb orb-left fd-orb-drift" style="--float-duration:20s"></div>
      <div class="analyze-orb orb-right fd-orb-drift" style="--float-duration:16s;--float-delay:-5s"></div>
    </div>

    <div id="auth-gate" class="auth-gate">
      <div class="auth-gate-inner">
        <div class="auth-gate-steps">
          <div class="gate-step gate-step-1">
            <div class="gate-step-num">1</div>
            <div class="gate-step-content">
              <h3 class="gate-step-title">Create an Account</h3>
              <p class="gate-step-text">Sign up or sign in to save patient records and track your analysis history.</p>
            </div>
          </div>
          <div class="gate-step gate-step-2">
            <div class="gate-step-num">2</div>
            <div class="gate-step-content">
              <h3 class="gate-step-title">Enter Patient Info</h3>
              <p class="gate-step-text">Provide patient details before each X-ray analysis for organized record-keeping.</p>
            </div>
          </div>
          <div class="gate-step gate-step-3">
            <div class="gate-step-num">3</div>
            <div class="gate-step-content">
              <h3 class="gate-step-title">Upload &amp; Detect</h3>
              <p class="gate-step-text">Upload X-rays and let AI detect fractures with confidence scores and heatmaps.</p>
            </div>
          </div>
        </div>
        <div class="auth-gate-cta">
          <a href="/signup" class="btn-submit fd-magnetic" data-ripple id="btn-get-started">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="8.5" cy="7" r="4" />
              <line x1="20" y1="8" x2="20" y2="14" />
              <line x1="23" y1="11" x2="17" y2="11" />
            </svg>
            Get Started
          </a>
          <a href="/signin" class="btn-submit-alt fd-magnetic" data-ripple>I have an account</a>
        </div>
      </div>
    </div>

    <div id="patient-ui" class="hidden">
      <div class="patient-container">
        <div class="patient-card">
          <div class="upload-badge">
            <span class="badge-dot"></span>
            Patient Information
          </div>
          <h1 class="upload-title">Enter Patient Details</h1>
          <p class="upload-subtext">Provide patient information before proceeding with the X-ray analysis.</p>
          <form id="patient-form" class="patient-form" novalidate>
            <div class="patient-field">
              <label class="patient-label" for="patient-name">Full Name <span class="required">*</span></label>
              <input class="patient-input" id="patient-name" name="name" type="text" placeholder="e.g. John Doe" required />
            </div>
            <div class="patient-row">
              <div class="patient-field">
                <label class="patient-label" for="patient-age">Age</label>
                <input class="patient-input" id="patient-age" name="age" type="number" min="0" max="150" placeholder="e.g. 45" />
              </div>
              <div class="patient-field">
                <label class="patient-label" for="patient-gender">Gender</label>
                <select class="patient-input patient-select" id="patient-gender" name="gender">
                  <option value="">Select</option>
                  <option value="male">Male</option>
                  <option value="female">Female</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>
            <div class="patient-field">
              <label class="patient-label" for="patient-mrn">Medical Record ID</label>
              <input class="patient-input" id="patient-mrn" name="mrn" type="text" placeholder="e.g. MRN-12345" />
            </div>
            <div class="patient-field">
              <label class="patient-label" for="patient-notes">Notes (optional)</label>
              <textarea class="patient-input patient-textarea" id="patient-notes" name="notes" rows="2" placeholder="Any additional notes..."></textarea>
            </div>
            <p class="error-message" id="patient-error"></p>
            <button class="btn-analyze" id="btn-patient-continue" type="submit" data-ripple>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6" />
              </svg>
              Continue to Upload
            </button>
          </form>
        </div>
      </div>
    </div>

    <div id="upload-ui" class="hidden">
      <div class="analyze-container">
        <div class="upload-section">
          <div class="upload-badge">
            <span class="badge-dot"></span>
            AI Analysis
          </div>
          <h1 class="upload-title">Upload X-ray Images</h1>
          <div class="patient-badge" id="patient-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
            <span id="patient-badge-name">Patient</span>
            <button class="patient-change-btn" id="btn-change-patient">Change</button>
          </div>
          <p class="upload-subtext">Upload one or more X-ray images. Our model detects fractures with confidence scores and heatmaps.</p>

          <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Upload X-ray image files">
            <input type="file" id="file-input" accept="image/png,image/jpeg" multiple hidden aria-label="Choose X-ray image files" />
            <div class="dropzone-graphic">
              <svg class="dropzone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
                <line x1="12" y1="13" x2="12" y2="19" />
                <polyline points="9 16 12 13 15 16" />
              </svg>
            </div>
            <p class="dropzone-text">Drag and drop your images here</p>
            <p class="dropzone-link">or <span class="dropzone-link-text">click to browse</span></p>
            <p class="dropzone-caption">PNG, JPG, JPEG &middot; Max 10MB each &middot; Multiple allowed</p>
          </div>

          <p class="error-message" id="error-message"></p>

          <button class="btn-analyze" id="btn-analyze" data-ripple disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>
            <span id="btn-analyze-text">Analyze Image</span>
          </button>

          <div id="batch-queue" class="batch-queue hidden">
            <div class="batch-header">
              <span class="batch-count" id="batch-count">0 images</span>
              <button class="batch-clear-btn" id="btn-batch-clear">Clear all</button>
            </div>
            <div class="batch-strip" id="batch-strip"></div>
          </div>
        </div>

        <div class="preview-section">
          <div class="preview-card">
            <div class="preview-card-header">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
              </svg>
              <span>Preview</span>
              <button class="guide-toggle-btn" id="btn-guide-toggle" title="Toggle fracture guide overlay">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                Guide
              </button>
            </div>

            <div class="preview-empty" id="preview-empty">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
              </svg>
              <p class="preview-empty-text">No image selected yet</p>
            </div>

            <div class="preview-filled hidden" id="preview-filled">
              <div class="preview-image-wrapper" id="preview-image-wrapper">
                <img id="preview-image" alt="Uploaded X-ray image" />
                <div class="guide-overlay hidden" id="guide-overlay">
                  <svg class="guide-svg" viewBox="0 0 240 320" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g opacity="0.7">
                      <circle cx="85" cy="55" r="18" fill="rgba(239,68,68,0.25)" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 2" />
                      <circle cx="85" cy="55" r="3" fill="#ef4444" />
                      <text x="85" y="42" text-anchor="middle" font-size="8" fill="#ef4444" font-weight="600">Distal Radius</text>

                      <circle cx="68" cy="78" r="14" fill="rgba(239,68,68,0.25)" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 2" />
                      <circle cx="68" cy="78" r="3" fill="#ef4444" />
                      <text x="68" y="66" text-anchor="middle" font-size="8" fill="#ef4444" font-weight="600">Scaphoid</text>

                      <circle cx="80" cy="115" r="16" fill="rgba(239,68,68,0.25)" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 2" />
                      <circle cx="80" cy="115" r="3" fill="#ef4444" />
                      <text x="80" y="102" text-anchor="middle" font-size="8" fill="#ef4444" font-weight="600">Radius Shaft</text>

                      <circle cx="64" cy="118" r="14" fill="rgba(239,68,68,0.25)" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 2" />
                      <circle cx="64" cy="118" r="3" fill="#ef4444" />
                      <text x="64" y="138" text-anchor="middle" font-size="8" fill="#ef4444" font-weight="600">Ulna Shaft</text>

                      <circle cx="75" cy="170" r="16" fill="rgba(239,68,68,0.25)" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 2" />
                      <circle cx="75" cy="170" r="3" fill="#ef4444" />
                      <text x="75" y="158" text-anchor="middle" font-size="8" fill="#ef4444" font-weight="600">Olecranon</text>

                      <circle cx="70" cy="210" r="18" fill="rgba(239,68,68,0.25)" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 2" />
                      <circle cx="70" cy="210" r="3" fill="#ef4444" />
                      <text x="70" y="196" text-anchor="middle" font-size="8" fill="#ef4444" font-weight="600">Distal Humerus</text>

                      <circle cx="60" cy="260" r="16" fill="rgba(239,68,68,0.25)" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 2" />
                      <circle cx="60" cy="260" r="3" fill="#ef4444" />
                      <text x="60" y="248" text-anchor="middle" font-size="8" fill="#ef4444" font-weight="600">Humeral Shaft</text>

                      <circle cx="108" cy="175" r="10" fill="rgba(239,68,68,0.25)" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="3 2" />
                      <circle cx="108" cy="175" r="3" fill="#f59e0b" />
                      <text x="108" y="163" text-anchor="middle" font-size="8" fill="#f59e0b" font-weight="600">Radial Head</text>

                      <circle cx="105" cy="220" r="10" fill="rgba(239,68,68,0.25)" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="3 2" />
                      <circle cx="105" cy="220" r="3" fill="#f59e0b" />
                      <text x="105" y="238" text-anchor="middle" font-size="8" fill="#f59e0b" font-weight="600">Capitellum</text>

                      <path d="M48 285 L192 285" stroke="rgba(255,255,255,0.2)" stroke-width="1" stroke-dasharray="2 4" />
                      <text x="120" y="300" text-anchor="middle" font-size="7" fill="rgba(255,255,255,0.4)">Reference guide: common fracture sites</text>
                      <rect x="40" y="10" width="160" height="270" rx="8" stroke="rgba(255,255,255,0.1)" stroke-width="1" fill="none" />
                    </g>
                  </svg>
                </div>
                <button class="btn-delete" id="btn-delete" aria-label="Remove image">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6" />
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { isSignedIn } from '../scripts/auth.js';
  import { savePatient, getPatient } from '../scripts/patients.js';

  var currentPatientId = sessionStorage.getItem('fracturedetect:patient_id');

  function animateIn(el) {
    el.classList.remove('hidden');
    el.classList.remove('fade-out');
    el.classList.add('fade-in');
  }

  function animateOut(el) {
    el.classList.remove('fade-in');
    el.classList.add('fade-out');
    return new Promise(function (r) {
      el.addEventListener('animationend', function handler() {
        el.classList.add('hidden');
        el.classList.remove('fade-out');
        el.removeEventListener('animationend', handler);
        r();
      });
    });
  }

  (async function () {
    var signedIn = await isSignedIn();
    var gate = document.getElementById('auth-gate');
    var patientUi = document.getElementById('patient-ui');
    var upload = document.getElementById('upload-ui');

    if (!signedIn) {
      if (gate) { gate.classList.remove('hidden'); }
      return;
    }

    if (gate) { gate.classList.add('hidden'); }

    if (currentPatientId) {
      if (patientUi) patientUi.classList.add('hidden');
      if (upload) { upload.classList.remove('hidden'); animateIn(upload); loadPatientBadge(); }
    } else {
      if (patientUi) { patientUi.classList.remove('hidden'); animateIn(patientUi); }
    }
  })();

  var getStartedBtn = document.getElementById('btn-get-started');
  if (getStartedBtn) {
    getStartedBtn.addEventListener('click', async function (e) {
      var signedIn = await isSignedIn();
      if (signedIn) {
        e.preventDefault();
        var gate = document.getElementById('auth-gate');
        var patientUi = document.getElementById('patient-ui');
        if (gate) gate.classList.add('hidden');
        if (patientUi) { patientUi.classList.remove('hidden'); animateIn(patientUi); }
      }
    });
  }

  async function loadPatientBadge() {
    if (!currentPatientId) return;
    var p = await getPatient(currentPatientId);
    var el = document.getElementById('patient-badge-name');
    if (el && p) el.textContent = p.name;
  }

  var patientForm = document.getElementById('patient-form');
  var patientError = document.getElementById('patient-error');
  var patientContinue = document.getElementById('btn-patient-continue');

  if (patientForm) {
    patientForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (patientContinue) patientContinue.disabled = true;

      var name = document.getElementById('patient-name').value.trim();
      var age = document.getElementById('patient-age').value ? parseInt(document.getElementById('patient-age').value) : null;
      var gender = document.getElementById('patient-gender').value || null;
      var mrn = document.getElementById('patient-mrn').value.trim() || null;
      var notes = document.getElementById('patient-notes').value.trim() || null;

      if (!name) {
        if (patientError) {
          patientError.textContent = 'Please enter the patient name.';
          patientError.classList.add('visible');
        }
        if (patientContinue) patientContinue.disabled = false;
        return;
      }

      if (patientError) patientError.classList.remove('visible');

      if (patientContinue) patientContinue.textContent = 'Saving\u2026';
      var patientId = await savePatient(name, age, gender, mrn, notes);
      if (patientId) {
        try { sessionStorage.setItem('fracturedetect:patient_id', patientId); } catch (err) {}
        currentPatientId = patientId;
        var pu = document.getElementById('patient-ui');
        var up = document.getElementById('upload-ui');
        if (pu) await animateOut(pu);
        if (up) { up.classList.remove('hidden'); animateIn(up); loadPatientBadge(); }
        if (patientContinue) { patientContinue.textContent = 'Continue to Upload'; patientContinue.disabled = false; }
      } else {
        if (patientError) {
          patientError.textContent = 'Failed to save patient info. Please try again.';
          patientError.classList.add('visible');
        }
        if (patientContinue) patientContinue.disabled = false;
      }
    });
  }

  var changeBtn = document.getElementById('btn-change-patient');
  if (changeBtn) {
    changeBtn.addEventListener('click', function () {
      try { sessionStorage.removeItem('fracturedetect:patient_id'); } catch (e) {}
      window.location.reload();
    });
  }

  /* ── Multi-file batch upload state ── */
  var fileQueue = [];
  var selectedIndex = -1;
  var currentObjectUrl = null;

  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file-input');
  const errorMsg = document.getElementById('error-message');
  const btnAnalyze = document.getElementById('btn-analyze');
  const btnAnalyzeText = document.getElementById('btn-analyze-text');
  const previewEmpty = document.getElementById('preview-empty');
  const previewFilled = document.getElementById('preview-filled');
  const previewImage = document.getElementById('preview-image');
  const btnDelete = document.getElementById('btn-delete');
  const batchQueue = document.getElementById('batch-queue');
  const batchStrip = document.getElementById('batch-strip');
  const batchCount = document.getElementById('batch-count');
  const btnBatchClear = document.getElementById('btn-batch-clear');

  const ALLOWED_TYPES = ['image/png', 'image/jpeg', 'image/jpg'];
  const MAX_SIZE = 10 * 1024 * 1024;

  function isValidFile(file) {
    return ALLOWED_TYPES.includes(file.type) && file.size <= MAX_SIZE;
  }

  function showError(message) {
    if (errorMsg) {
      errorMsg.textContent = message;
      errorMsg.classList.add('visible');
    }
  }

  function clearError() {
    if (errorMsg) {
      errorMsg.textContent = '';
      errorMsg.classList.remove('visible');
    }
  }

  function renderBatchStrip() {
    batchStrip.innerHTML = '';
    fileQueue.forEach(function (file, i) {
      var thumb = document.createElement('div');
      thumb.className = 'batch-thumb' + (i === selectedIndex ? ' batch-thumb-active' : '');
      thumb.setAttribute('data-index', i);

      var url = URL.createObjectURL(file);
      var img = document.createElement('img');
      img.className = 'batch-thumb-img';
      img.src = url;

      var overlay = document.createElement('div');
      overlay.className = 'batch-thumb-overlay';
      overlay.textContent = (i + 1);

      thumb.appendChild(img);
      thumb.appendChild(overlay);

      thumb.addEventListener('click', function () {
        selectFile(i);
      });

      batchStrip.appendChild(thumb);
    });

    batchQueue.classList.remove('hidden');
    batchCount.textContent = fileQueue.length + ' image' + (fileQueue.length !== 1 ? 's' : '');
    updateAnalyzeButton();
  }

  function selectFile(index) {
    if (index < 0 || index >= fileQueue.length) return;
    selectedIndex = index;
    renderBatchStrip();

    var file = fileQueue[index];
    if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
    currentObjectUrl = URL.createObjectURL(file);
    previewImage.src = currentObjectUrl;
    previewEmpty.classList.add('hidden');
    previewFilled.classList.remove('hidden');
    btnAnalyze.disabled = false;
    clearError();
    hideGuide();
  }

  function updateAnalyzeButton() {
    if (fileQueue.length === 0) {
      btnAnalyze.disabled = true;
      btnAnalyzeText.textContent = 'Analyze Image';
    } else if (fileQueue.length === 1) {
      btnAnalyzeText.textContent = 'Analyze Image';
    } else {
      var remaining = fileQueue.length - selectedIndex;
      btnAnalyzeText.textContent = 'Analyze (' + remaining + ' of ' + fileQueue.length + ')';
    }
  }

  function addFiles(files) {
    var added = 0;
    var errors = [];
    for (var i = 0; i < files.length; i++) {
      var file = files[i];
      if (!file) continue;
      if (!isValidFile(file)) {
        errors.push('"' + file.name + '" - must be PNG or JPEG under 10MB.');
        continue;
      }
      fileQueue.push(file);
      added++;
    }

    if (errors.length > 0) {
      showError(errors.join(' '));
    } else {
      clearError();
    }

    if (added > 0) {
      if (selectedIndex < 0) {
        selectFile(0);
      } else {
        renderBatchStrip();
      }
    }
  }

  function removeCurrentFile() {
    if (selectedIndex < 0 || selectedIndex >= fileQueue.length) return;
    fileQueue.splice(selectedIndex, 1);
    if (currentObjectUrl) {
      URL.revokeObjectURL(currentObjectUrl);
      currentObjectUrl = null;
    }

    if (fileQueue.length === 0) {
      selectedIndex = -1;
      previewEmpty.classList.remove('hidden');
      previewFilled.classList.add('hidden');
      previewImage.src = '';
      btnAnalyze.disabled = true;
      batchQueue.classList.add('hidden');
      batchStrip.innerHTML = '';
      updateAnalyzeButton();
      clearError();
      hideGuide();
    } else {
      if (selectedIndex >= fileQueue.length) selectedIndex = fileQueue.length - 1;
      selectFile(selectedIndex);
    }
  }

  function clearAllFiles() {
    fileQueue.forEach(function (f) {
      /* object URLs will be cleaned up by the browser */
    });
    fileQueue = [];
    selectedIndex = -1;
    if (currentObjectUrl) {
      URL.revokeObjectURL(currentObjectUrl);
      currentObjectUrl = null;
    }
    previewEmpty.classList.remove('hidden');
    previewFilled.classList.add('hidden');
    previewImage.src = '';
    btnAnalyze.disabled = true;
    batchQueue.classList.add('hidden');
    batchStrip.innerHTML = '';
    fileInput.value = '';
    updateAnalyzeButton();
    clearError();
    hideGuide();
  }

  function storeAndNavigate() {
    if (selectedIndex < 0 || selectedIndex >= fileQueue.length) return;
    var file = fileQueue[selectedIndex];

    var reader = new FileReader();
    reader.onload = function (e) {
      try {
        sessionStorage.setItem('fracturedetect:image', e.target.result);

        var remaining = [];
        for (var i = selectedIndex + 1; i < fileQueue.length; i++) {
          remaining.push(i);
        }
        if (remaining.length > 0) {
          var queueData = [];
          var pendingReads = remaining.length;
          remaining.forEach(function (idx) {
            var r = new FileReader();
            r.onload = function (ev) {
              queueData.push({ index: idx, data: ev.target.result, name: fileQueue[idx].name });
              pendingReads--;
              if (pendingReads === 0) {
                sessionStorage.setItem('fracturedetect:queue', JSON.stringify(queueData));
                sessionStorage.removeItem('fracturedetect:patient_id');
                window.location.href = '/processing';
              }
            };
            r.readAsDataURL(fileQueue[idx]);
          });
        } else {
          sessionStorage.removeItem('fracturedetect:queue');
          sessionStorage.removeItem('fracturedetect:patient_id');
          window.location.href = '/processing';
        }
      } catch (err) {
        console.warn('Failed to store image in sessionStorage:', err);
      }
    };
    reader.onerror = function () {
      window.location.href = '/processing';
    };
    reader.readAsDataURL(file);
  }

  /* ── Guide overlay toggle ── */
  var guideOverlay = document.getElementById('guide-overlay');
  var guideToggleBtn = document.getElementById('btn-guide-toggle');
  var guideVisible = false;

  function showGuide() {
    if (guideOverlay) guideOverlay.classList.remove('hidden');
    if (guideToggleBtn) guideToggleBtn.classList.add('guide-active');
    guideVisible = true;
  }

  function hideGuide() {
    if (guideOverlay) guideOverlay.classList.add('hidden');
    if (guideToggleBtn) guideToggleBtn.classList.remove('guide-active');
    guideVisible = false;
  }

  function toggleGuide() {
    if (guideVisible) {
      hideGuide();
    } else {
      showGuide();
    }
  }

  if (guideToggleBtn) {
    guideToggleBtn.addEventListener('click', toggleGuide);
  }

  /* ── Dropzone events ── */
  if (dropzone) {
    var dragCounter = 0;

    dropzone.addEventListener('click', function () { fileInput?.click(); });
    dropzone.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput?.click();
      }
    });
    dropzone.addEventListener('dragenter', function (e) {
      e.preventDefault();
      dragCounter++;
      if (dragCounter === 1) {
        dropzone.classList.add('dragover');
        dropzone.classList.add('drag-hover');
      }
    });
    dropzone.addEventListener('dragover', function (e) { e.preventDefault(); });
    dropzone.addEventListener('dragleave', function () {
      dragCounter--;
      if (dragCounter === 0) {
        dropzone.classList.remove('dragover');
        dropzone.classList.remove('drag-hover');
      }
    });
    dropzone.addEventListener('drop', function (e) {
      e.preventDefault();
      dragCounter = 0;
      dropzone.classList.remove('dragover');
      dropzone.classList.remove('drag-hover');
      if (e.dataTransfer?.files?.length) {
        addFiles(Array.from(e.dataTransfer.files));
      }
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', function () {
      if (fileInput.files?.length) {
        addFiles(Array.from(fileInput.files));
      }
      fileInput.value = '';
    });
  }

  if (btnDelete) {
    btnDelete.addEventListener('click', function (e) {
      e.stopPropagation();
      removeCurrentFile();
    });
  }

  if (btnBatchClear) {
    btnBatchClear.addEventListener('click', clearAllFiles);
  }

  document.addEventListener('keydown', function (e) {
    if (e.ctrlKey && e.key === 'Enter' && btnAnalyze && !btnAnalyze.disabled) {
      e.preventDefault();
      storeAndNavigate();
    }
  });

  if (btnAnalyze) {
    btnAnalyze.addEventListener('click', storeAndNavigate);
  }

  /* ── Check for incoming batch from results page ── */
  (function () {
    var queueData = sessionStorage.getItem('fracturedetect:queue');
    if (queueData) {
      var items = JSON.parse(queueData);
      sessionStorage.removeItem('fracturedetect:queue');
      if (items && items.length > 0) {
        items.forEach(function (item) {
          var blob = dataURLToBlob(item.data);
          var file = new File([blob], item.name || 'image.png', { type: 'image/png' });
          fileQueue.push(file);
        });
        if (fileQueue.length > 0) {
          selectFile(0);
          batchQueue.classList.remove('hidden');
          batchCount.textContent = fileQueue.length + ' image' + (fileQueue.length !== 1 ? 's' : '');
          updateAnalyzeButton();
        }
      }
    }
  })();

  function dataURLToBlob(dataURL) {
    var parts = dataURL.split(',');
    var mime = parts[0].match(/:(.*?);/)[1];
    var bytes = atob(parts[1]);
    var len = bytes.length;
    var buf = new ArrayBuffer(len);
    var view = new Uint8Array(buf);
    for (var i = 0; i < len; i++) {
      view[i] = bytes.charCodeAt(i);
    }
    return new Blob([buf], { type: mime });
  }
</script>

