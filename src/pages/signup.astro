---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Sign Up" description="Create your FractureDetect account" active="signup" variant="marketing">
  <main class="auth-page page-enter">
    <div class="auth-bg">
      <div class="auth-orb orb-1 fd-orb-drift" style="--float-duration:20s"></div>
      <div class="auth-orb orb-2 fd-orb-drift" style="--float-duration:16s;--float-delay:-5s"></div>
    </div>
    <div class="auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <div class="auth-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
          </div>
          <h1 class="auth-title" id="auth-title">Create an account</h1>
          <p class="auth-subtitle" id="auth-subtitle">Get started with FractureDetect</p>
        </div>
        <form id="signup-form" class="auth-form" novalidate>
          <div class="field">
            <label class="field-label" for="name">Full name</label>
            <input class="field-input" id="name" name="name" type="text" placeholder="John Doe" required autocomplete="name" />
          </div>
          <div class="field">
            <label class="field-label" for="email">Email</label>
            <input class="field-input" id="email" name="email" type="email" placeholder="you@example.com" required autocomplete="email" />
          </div>
          <div class="field">
            <label class="field-label" for="password">Password</label>
            <div class="input-wrap">
              <input class="field-input" id="password" name="password" type="password" placeholder="Create a password" required minlength="6" autocomplete="new-password" />
              <button type="button" class="toggle-pw" id="toggle-pw" tabindex="-1" aria-label="Show password">
                <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                  <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                  <line x1="1" y1="1" x2="23" y2="23" />
                </svg>
              </button>
            </div>
          </div>
          <div class="field">
            <label class="field-label" for="confirm-password">Confirm password</label>
            <div class="input-wrap">
              <input class="field-input" id="confirm-password" name="confirm-password" type="password" placeholder="Confirm your password" required autocomplete="new-password" />
              <button type="button" class="toggle-pw" id="toggle-confirm-pw" tabindex="-1" aria-label="Show password">
                <svg class="eye-open-c" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <svg class="eye-closed-c" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                  <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                  <line x1="1" y1="1" x2="23" y2="23" />
                </svg>
              </button>
            </div>
          </div>
          <div class="error-msg" id="error-msg" role="alert"></div>
          <div class="success-msg" id="success-msg" role="status" style="display:none">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <span id="success-text">Account created! We sent a confirmation link to your email. Your account stays inactive until you click it.</span>
          </div>
          <div class="resend-row" id="resend-row" style="display:none">
            <span class="resend-note" id="resend-note">Haven't received it? Check spam, or</span>
            <button type="button" class="resend-btn" id="btn-resend">Resend email</button>
          </div>
          <button class="btn-submit" type="submit" id="btn-submit">Create Account</button>
        </form>
        <div class="divider">
          <span class="divider-line"></span>
          <span class="divider-text">or continue with</span>
          <span class="divider-line"></span>
        </div>
        <div class="social-btns">
          <button type="button" class="btn-social" id="btn-google">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Google
          </button>
          <button type="button" class="btn-social" id="btn-apple" disabled title="Coming soon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
            </svg>
            Apple
          </button>
        </div>
        <p class="auth-footer" id="auth-footer">
          Already have an account? <a href="/signin" class="auth-link">Sign in</a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script type="module">
  import { register, signInWithGoogle, resendConfirmationEmail } from '../scripts/auth.js';

  var form = document.getElementById('signup-form');
  var errorEl = document.getElementById('error-msg');
  var pwInput = document.getElementById('password');
  var confirmInput = document.getElementById('confirm-password');
  var toggleBtn = document.getElementById('toggle-pw');
  var toggleConfirmBtn = document.getElementById('toggle-confirm-pw');
  var googleBtn = document.getElementById('btn-google');
  var resendRow = document.getElementById('resend-row');
  var resendBtn = document.getElementById('btn-resend');
  var lastEmail = null;

  function showResend(email) {
    lastEmail = email;
    if (resendRow) resendRow.style.display = 'flex';
  }

  resendBtn?.addEventListener('click', async function () {
    if (!lastEmail) return;
    resendBtn.disabled = true;
    resendBtn.textContent = 'Sending\u2026';
    var result = await resendConfirmationEmail(lastEmail);
    if (result.ok) {
      if (window.showToast) {
        window.showToast({ type: 'success', message: 'Confirmation email resent. Check your inbox (and spam).', duration: 6000 });
      }
      resendBtn.textContent = 'Sent!';
      setTimeout(function () { resendBtn.textContent = 'Resend email'; resendBtn.disabled = false; }, 3000);
    } else {
      errorEl.textContent = result.error;
      errorEl.style.display = 'block';
      resendBtn.textContent = 'Resend email';
      resendBtn.disabled = false;
    }
  });

  function setupToggle(btn, input, cls) {
    btn?.addEventListener('click', function () {
      var open = input.type === 'password';
      input.type = open ? 'text' : 'password';
      document.querySelector('.' + cls + '-open').style.display = open ? 'none' : '';
      document.querySelector('.' + cls + '-closed').style.display = open ? '' : 'none';
    });
  }

  setupToggle(toggleBtn, pwInput, 'eye');
  setupToggle(toggleConfirmBtn, confirmInput, 'eye-c');

  googleBtn?.addEventListener('click', async function () {
    googleBtn.disabled = true;
    googleBtn.textContent = 'Redirecting\u2026';
    var result = await signInWithGoogle();
    if (!result.ok) {
      errorEl.textContent = result.error;
      errorEl.style.display = 'block';
      googleBtn.disabled = false;
      googleBtn.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg> Google';
    }
  });

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    errorEl.textContent = '';
    errorEl.style.display = 'none';

    var name = form.name.value.trim();
    var email = form.email.value.trim();
    var password = form.password.value;
    var confirm = form['confirm-password'].value;

    if (!name || !email || !password || !confirm) {
      errorEl.textContent = 'Please fill in all fields.';
      errorEl.style.display = 'block';
      return;
    }

    if (password.length < 6) {
      errorEl.textContent = 'Password must be at least 6 characters.';
      errorEl.style.display = 'block';
      return;
    }

    if (password !== confirm) {
      errorEl.textContent = 'Passwords do not match.';
      errorEl.style.display = 'block';
      return;
    }

    var result = await register(name, email, password);
    if (result.ok) {
      document.getElementById('signup-form').style.display = 'none';
      document.getElementById('btn-submit').style.display = 'none';
      document.querySelector('.divider').style.display = 'none';
      document.querySelector('.social-btns').style.display = 'none';
      document.getElementById('auth-footer').style.display = 'none';
      document.getElementById('success-msg').style.display = 'flex';
      if (result.needsConfirmation) {
        showResend(email);
        document.getElementById('auth-title').textContent = 'Account created successfully';
        document.getElementById('auth-subtitle').textContent = 'Please check your email and verify your account.';
        document.getElementById('success-text').textContent = 'We sent a confirmation link to ' + email + '. Your account stays inactive until you click it.';
      } else {
        document.getElementById('auth-title').textContent = 'Account created successfully';
        document.getElementById('auth-subtitle').textContent = 'You\'re all set and signed in.';
        document.getElementById('success-text').textContent = 'Account created! You\'re signed in.';
      }
      if (window.showToast) {
        window.showToast({ type: 'info', message: 'Check your email inbox for the confirmation link to activate your account.', duration: 6000 });
      }
    } else {
      errorEl.textContent = result.error;
      errorEl.style.display = 'block';
      if (/already registered|already been registered|already a user/i.test(result.error)) {
        showResend(email);
      }
    }
  });
</script>

<style>
  .auth-page { min-height: calc(100vh - 68px); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .auth-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .auth-orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.08; }
  .auth-orb.orb-1 { width: 400px; height: 400px; background: var(--color-primary); top: -120px; right: -80px; }
  .auth-orb.orb-2 { width: 300px; height: 300px; background: #a855f7; bottom: -100px; left: -60px; }
  .auth-container { max-width: 440px; width: 100%; padding: 24px; position: relative; z-index: 1; }
  .auth-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 40px 32px 32px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
  .auth-header { text-align: center; margin-bottom: 32px; }
  .auth-icon { width: 48px; height: 48px; border-radius: 14px; background: var(--color-primary); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px; }
  .auth-title { font-family: var(--font-heading); font-weight: 600; font-size: 24px; color: var(--color-text); margin: 0 0 8px; letter-spacing: -0.02em; }
  .auth-subtitle { font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted); margin: 0; }
  .auth-form { display: flex; flex-direction: column; gap: 20px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label { font-family: var(--font-body); font-weight: 500; font-size: 14px; color: var(--color-text); }
  .field-input { font-family: var(--font-body); font-size: 15px; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 10px 14px; outline: none; transition: border-color 0.15s, box-shadow 0.15s; }
  .field-input::placeholder { color: #94a3b8; }
  .field-input:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
  .error-msg { display: none; font-family: var(--font-body); font-size: 14px; color: var(--color-danger); background: rgba(220,38,38,0.06); padding: 10px 14px; border-radius: var(--radius-md); margin: 0; }
  .success-msg { display: none; align-items: center; gap: 10px; font-family: var(--font-body); font-size: 15px; color: var(--color-success); background: rgba(22,163,74,0.06); padding: 16px 18px; border-radius: var(--radius-md); margin: 0; line-height: 1.5; }
  .success-msg svg { flex-shrink: 0; }
  .resend-row { display: flex; align-items: center; gap: 8px; font-family: var(--font-body); font-size: 14px; color: var(--color-text-muted); margin-top: 12px; }
  .resend-note { line-height: 1.4; }
  .resend-btn { font-family: var(--font-body); font-size: 14px; font-weight: 500; color: var(--color-primary); background: none; border: none; padding: 4px 6px; cursor: pointer; white-space: nowrap; }
  .resend-btn:hover { text-decoration: underline; }
  .resend-btn:disabled { opacity: 0.6; cursor: default; }
  .btn-submit { font-family: var(--font-body); font-weight: 600; font-size: 15px; color: white; background: linear-gradient(135deg, var(--color-primary), #1d4ed8); padding: 12px 24px; border: none; border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease; box-shadow: 0 4px 12px rgba(37,99,235,0.25); margin-top: 4px; }
  .btn-submit:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,0.35); }
  .btn-submit:active { transform: translateY(0); }
  .btn-submit:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .auth-footer { text-align: center; font-family: var(--font-body); font-size: 14px; color: var(--color-text-muted); margin: 24px 0 0; }
  .auth-link { color: var(--color-primary); text-decoration: none; font-weight: 500; }
  .auth-link:hover { text-decoration: underline; }
  .input-wrap { position: relative; }
  .input-wrap .field-input { padding-right: 42px; width: 100%; box-sizing: border-box; }
  .toggle-pw { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; padding: 6px; cursor: pointer; color: #94a3b8; display: flex; align-items: center; justify-content: center; border-radius: 6px; transition: color 0.15s, background 0.15s; }
  .toggle-pw:hover { color: #64748b; background: rgba(0,0,0,0.04); }
  .toggle-pw:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .divider { display: flex; align-items: center; gap: 12px; margin: 24px 0; }
  .divider-line { flex: 1; height: 1px; background: var(--color-border); }
  .divider-text { font-family: var(--font-body); font-size: 13px; color: #94a3b8; white-space: nowrap; }
  .social-btns { display: flex; gap: 10px; }
  .btn-social { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--font-body); font-size: 14px; font-weight: 500; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 10px 16px; cursor: pointer; transition: all 0.15s; }
  .btn-social:not(:disabled):hover { background: var(--color-bg-subtle); border-color: var(--color-border-strong); }
  .btn-social:disabled { cursor: not-allowed; opacity: 0.5; }
  @media (max-width: 480px) { .auth-card { padding: 32px 24px 28px; } .auth-title { font-size: 22px; } }
</style>
